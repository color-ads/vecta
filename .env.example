# Contentful — Space ID, Delivery (read-only) API token, environment.
# Get these from https://app.contentful.com → Settings → API keys.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
CONTENTFUL_SPACE_ID=your_space_id_here
CONTENTFUL_ACCESS_TOKEN=your_delivery_api_token_here
CONTENTFUL_ENVIRONMENT=master

# Optional — Preview API token (for unpublished content in dev). Leave blank
# in production. If set, `getContentfulClient({ preview: true })` uses it.
CONTENTFUL_PREVIEW_TOKEN=
