---
// Hero — HOME top section (1280x832 in Figma, frame 2030:31).
// Background is the `heroBackground` asset from Contentful (`webSite`
// singleton, field `heroBackground`). Detectamos el contentType del asset
// y renderizamos <video> (video/*) o <img> (image/*) en consecuencia.
// El gradiente + overlay scanline encima sigue intacto para mantener el
// mismo aire moody con cualquiera de los dos medios.
import { getWebsite } from '../lib/contentful';
import { assetUrl, richTextToPlain } from '../lib/richtext';

const ws = await getWebsite();
const heroAsset = ws?.fields?.heroBackground as any;
const heroSrc = assetUrl(heroAsset);
const heroContentType: string = heroAsset?.fields?.file?.contentType ?? '';
// `video/mp4`, `video/webm`, etc. → video. Cualquier `image/*` → imagen.
// Si Contentful no devolvió contentType (vacío), caemos a video por
// retro-compatibilidad con el comportamiento previo del Hero.
const isVideo = heroContentType.startsWith('video/') || (!heroContentType && !!heroSrc);
const isImage = heroContentType.startsWith('image/');
const tagline = richTextToPlain(ws?.fields?.textoPrincipal);
---
<section id="hero" class="relative w-full min-h-screen overflow-hidden bg-[#0d0e0c] flex items-center justify-center">
  {isVideo && (
    <video
      id="hero-video"
      src={heroSrc}
      poster="/hero.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      disablepictureinpicture
      disableremoteplayback
      x-webkit-airplay="deny"
      class="hero-video absolute inset-0 w-full h-full max-w-full object-cover object-center pointer-events-none"
      aria-hidden="true"
      tabindex="-1"
    ></video>
  )}
  {isImage && (
    <img
      id="hero-image"
      src={heroSrc}
      alt=""
      decoding="async"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full max-w-full object-cover object-center pointer-events-none"
      aria-hidden="true"
    />
  )}
  {isVideo && (
    <script is:inline>
      (() => {
        const v = document.getElementById('hero-video');
        if (!v) return;
        v.muted = true;
        v.defaultMuted = true;
        v.setAttribute('muted', '');
        v.setAttribute('playsinline', '');
        const tryPlay = () => {
          const p = v.play();
          if (p && typeof p.catch === 'function') p.catch(() => {});
        };
        tryPlay();
        const events = ['loadedmetadata', 'canplay', 'visibilitychange', 'pageshow'];
        events.forEach((e) => document.addEventListener(e, tryPlay, { passive: true }));
        ['touchstart', 'click', 'scroll', 'keydown'].forEach((e) =>
          document.addEventListener(e, tryPlay, { once: true, passive: true })
        );
      })();
    </script>
  )}
  <!-- Gradient + scanline overlay sits on top of the video for the original
       moody look (kept subtle so the video stays readable). -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/60 pointer-events-none"></div>
  <div class="absolute inset-0 mix-blend-overlay opacity-30 pointer-events-none bg-[linear-gradient(180deg,rgba(255,255,255,0.05),transparent_70%)]"></div>

  <!-- Inner canvas: fluido por debajo de 1280px, tope en 1280px.
       Decoradores ocultos en mobile+tablet (≤768) — el layout PC queda libre. -->
  <div class="relative w-full max-w-[1280px] h-[832px] mx-auto">
    <!-- Decoradores: separadores verticales + accents horizontales + divider inferior.
         Todos ocultos en mobile+tablet (≤768) porque no caben sin canvas Figma completo. -->
    <div class="absolute left-[7.97%] top-[19.59%] w-px h-[50.12%] bg-white/40 max-md:hidden"></div>
    <div class="absolute left-[93.44%] top-[25.24%] w-px h-[58.65%] bg-white/40 max-md:hidden"></div>
    <div class="absolute left-[7.97%] top-[54.81%] w-[5.94%] h-px bg-white/70 max-md:hidden"></div>
    <div class="absolute left-[7.97%] top-[58.05%] w-[12.73%] h-px bg-white/70 max-md:hidden"></div>
    <div class="absolute left-[10.78%] top-[96.15%] w-[78.36%] h-px bg-white/40 max-md:hidden"></div>

    <!-- VECTA 98 logo (Figma 2030:149, natural aspect 580:133 ≈ 4.37:1).
         aspect-ratio fija la proporción del SVG; solo controlamos width.
         PC: ancho fijo en % del canvas + posición Figma.
         Mobile/tablet: centrado vertical y horizontalmente con ancho fluido. -->
    <div class="absolute left-1/2 -translate-x-1/2 top-[43.39%] w-[45.39%] aspect-[580/133]
                md:max-lg:top-[46%] md:max-lg:w-[50%]
                max-md:top-[34%] max-md:w-[min(72%,520px)]">
      <img src="/sections/hero/vecta-logo.svg" alt="VECTA 98" class="w-full h-full object-contain" decoding="async" fetchpriority="high" />
    </div>

    <!-- Tagline (Figma 2030:68). PC: ancla bottom-left (Figma x=74, y=605).
         Mobile/tablet: bajo el logo, centrado, padding lateral fluido. -->
    <p class="absolute left-[5.78%] top-[72.72%] w-[28.13%] text-vecta-lime-text font-medium text-[clamp(18px,2.5vw,32px)] leading-[0.959] whitespace-pre-line font-display
              max-md:left-[5%] max-md:right-[5%] max-md:top-[58%] max-md:w-auto max-md:text-center max-md:text-[clamp(16px,4vw,26px)] max-md:leading-[1.3]">{tagline}</p>
  </div>
</section>
