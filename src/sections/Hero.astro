---
// Hero - HOME page top section (1280x832 in Figma)
// Reference: HOME frame 2030:31, Rectangle 6 (2030:115) holds the B&W building photo as image fill.
// The Figma MCP design-context exposes Rectangle 6 as an empty div; the photo is only visible in
// rendered screenshots. Export it manually from Figma if you want pixel-perfect parity, then
// replace `/sections/hero/hero-bg.jpg` (or .png) below.
// Header lives globally in index.astro (fixed/sticky) — not rendered here.
---
<section id="hero" class="relative w-full min-h-screen overflow-hidden bg-[#0d0e0c] flex items-center justify-center">
  <!-- Hero background video: autoplay muted loop, full-bleed. The deep neutral
       gradient and scanline overlay below it provide a fallback if the video
       fails to load and add the same vignette/grain feel as before. -->
  <video
    id="hero-video"
    src="/herobg.mp4"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    disablepictureinpicture
    disableremoteplayback
    x-webkit-airplay="deny"
    class="hero-video absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
    aria-hidden="true"
    tabindex="-1"
  ></video>
  <style>
    /* Hide Safari's fallback play button overlay (shown e.g. in Low Power Mode)
       and any default media controls so the video stays a pure background. */
    .hero-video::-webkit-media-controls,
    .hero-video::-webkit-media-controls-panel,
    .hero-video::-webkit-media-controls-start-playback-button,
    .hero-video::-webkit-media-controls-overlay-play-button,
    .hero-video::-webkit-media-controls-play-button {
      display: none !important;
      -webkit-appearance: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
  </style>
  <script is:inline>
    (() => {
      const v = document.getElementById('hero-video');
      if (!v) return;
      v.muted = true;
      v.defaultMuted = true;
      v.setAttribute('muted', '');
      v.setAttribute('playsinline', '');
      const tryPlay = () => {
        const p = v.play();
        if (p && typeof p.catch === 'function') p.catch(() => {});
      };
      tryPlay();
      const events = ['loadedmetadata', 'canplay', 'visibilitychange', 'pageshow'];
      events.forEach((e) => document.addEventListener(e, tryPlay, { passive: true }));
      ['touchstart', 'click', 'scroll', 'keydown'].forEach((e) =>
        document.addEventListener(e, tryPlay, { once: true, passive: true })
      );
    })();
  </script>
  <!-- Gradient + scanline overlay sits on top of the video for the original
       moody look (kept subtle so the video stays readable). -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/60 pointer-events-none"></div>
  <div class="absolute inset-0 mix-blend-overlay opacity-30 pointer-events-none bg-[linear-gradient(180deg,rgba(255,255,255,0.05),transparent_70%)]"></div>

  <!-- Inner 1280px canvas keeps Figma absolute positions intact -->
  <div class="relative w-[1280px] h-[832px] mx-auto">
    <!-- Vertical separators (Vector 25 left, Vector 26 right) — hidden on mobile. -->
    <div class="absolute left-[102px] top-[163px] w-px h-[417px] bg-white/40 mobile:hidden"></div>
    <div class="absolute left-[1196px] top-[210px] w-px h-[488px] bg-white/40 mobile:hidden"></div>

    <!-- Small horizontal accents near the logo (Vector 27 + Vector 28) — hidden on mobile. -->
    <div class="absolute left-[102px] top-[456px] w-[76px] h-px bg-white/70 mobile:hidden"></div>
    <div class="absolute left-[102px] top-[483px] w-[163px] h-px bg-white/70 mobile:hidden"></div>

    <!-- VECTA 98 logo (image 11 [Vectorized] 2030:149)  x=350, y=361, 580.84 x 133 -->
    <div class="absolute left-[350px] top-[361px] w-[581px] h-[133px]">
      <img src="/sections/hero/vecta-logo.svg" alt="VECTA 98" class="w-full h-full object-contain" />
    </div>

    <!-- Tagline (text 2030:68): desktop x=74, y=605, w=360. Mobile re-anchors
         it below the logo (top:520) and centers it across the 1280 canvas. -->
    <p class="absolute left-[74px] top-[605px] w-[360px] text-vecta-lime-text font-medium text-[32px] leading-[0.959] whitespace-pre-line font-display
              mobile:left-0 mobile:right-0 mobile:top-[520px] mobile:w-full mobile:text-center mobile:text-[56px] mobile:leading-[1.05]">
Un buen activo
no necesita convencer,
se demuestra.
    </p>

    <!-- Bottom horizontal divider (Vector 20) x=138, y=800, w=1002.5 — hidden on mobile. -->
    <div class="absolute left-[138px] top-[800px] w-[1003px] h-px bg-white/40 mobile:hidden"></div>
  </div>
</section>
