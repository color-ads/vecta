---
// About Us 2 - Black with title + 6 amenidades grid
const items = [
  { title: "Ubicación estratégica", description: "Cercanía a zonas corporativas, vías principales y servicios clave." },
  { title: "Alta demanda potencial", description: "Zona con flujo constante de personas y actividad económica." },
  { title: "Eficiencia en el diseño", description: "Espacios optimizados para maximizar uso y ocupación." },
  { title: "Amenidades funcionales", description: "No decorativas, sino pensadas para complementar la operación." },
  { title: "Bajo ruido comercial", description: "Una marca que prioriza la información sobre la persuasión." }
];
---
<section class="relative w-full min-w-[1280px] h-[832px] bg-vecta-bg overflow-hidden">
  <!-- Dark panel grows with viewport (~75% reduction in side strips, matches AboutUs).
       Decorative circle lives inside the panel so it clips at the panel's edges
       (preserves the original Figma cropping behavior). -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 h-full bg-[#0a0a0a] overflow-hidden"
       style="width: calc(75vw + 317.5px); min-width: 1270px;">
    <!-- Decorative circle (clips at dark panel left/top edges) -->
    <div class="absolute -left-[207px] -top-[157px] w-[620px] h-[620px] rounded-full border border-vecta-lime-text/40"></div>
  </div>

  <!-- Inner 1280px canvas keeps Figma absolute positions intact -->
  <div class="relative w-[1280px] h-full mx-auto">
    <!-- Title -->
    <h2 class="absolute left-[68px] top-[103px] w-[639px] text-vecta-lime-text font-semibold text-[60px] leading-[0.959]"
        style="font-family: 'Albert Sans', sans-serif;">
      Aquí no vendemos sueños inmobiliarios.
    </h2>

    <!-- Cross grid lines -->
    <div class="absolute left-[412px] top-[1px] w-px h-[815px] bg-white/30"></div>
    <div class="absolute left-[851px] top-[1px] w-px h-[815px] bg-white/30"></div>
    <div class="absolute left-[413px] top-[327px] w-[856px] h-px bg-white/30"></div>
    <div class="absolute left-[413px] top-[548px] w-[856px] h-px bg-white/30"></div>

    <!-- Dots at intersections -->
    <span class="absolute left-[406px] top-[321px] w-[12px] h-[12px] rounded-full bg-vecta-lime-text"></span>
    <span class="absolute left-[406px] top-[542px] w-[12px] h-[12px] rounded-full bg-vecta-lime-text"></span>
    <span class="absolute left-[845px] top-[321px] w-[12px] h-[12px] rounded-full bg-vecta-lime-text"></span>
    <span class="absolute left-[845px] top-[542px] w-[12px] h-[12px] rounded-full bg-vecta-lime-text"></span>

    <!-- Card cells -->
    <!-- Top right: Ubicación estratégica -->
    <div class="absolute left-[908px] top-[91px] w-[280px]" style="font-family: 'Albert Sans', sans-serif;">
      <h3 class="text-vecta-lime-text font-semibold text-[28px] leading-[0.959]">{items[0].title}</h3>
      <p class="mt-[28px] text-white text-[18px] leading-[1.35] font-semibold">{items[0].description}</p>
    </div>

    <!-- Mid center: Alta demanda potencial -->
    <div class="absolute left-[502px] top-[354px] w-[260px]" style="font-family: 'Albert Sans', sans-serif;">
      <h3 class="text-vecta-lime-text font-semibold text-[28px] leading-[0.959]">{items[1].title}</h3>
      <p class="mt-[28px] text-white text-[18px] leading-[1.35] font-semibold">{items[1].description}</p>
    </div>

    <!-- Mid right: Eficiencia en el diseño -->
    <div class="absolute left-[908px] top-[354px] w-[260px]" style="font-family: 'Albert Sans', sans-serif;">
      <h3 class="text-vecta-lime-text font-semibold text-[28px] leading-[0.959]">{items[2].title}</h3>
      <p class="mt-[28px] text-white text-[18px] leading-[1.35] font-semibold">{items[2].description}</p>
    </div>

    <!-- Bottom left: Amenidades funcionales -->
    <div class="absolute left-[68px] top-[598px] w-[300px]" style="font-family: 'Albert Sans', sans-serif;">
      <h3 class="text-vecta-lime-text font-semibold text-[28px] leading-[0.959]">{items[3].title}</h3>
      <p class="mt-[28px] text-white text-[18px] leading-[1.35] font-semibold">{items[3].description}</p>
    </div>

    <!-- Bottom mid: Bajo ruido comercial -->
    <div class="absolute left-[502px] top-[598px] w-[260px]" style="font-family: 'Albert Sans', sans-serif;">
      <h3 class="text-vecta-lime-text font-semibold text-[28px] leading-[0.959]">{items[4].title}</h3>
      <p class="mt-[28px] text-white text-[18px] leading-[1.35] font-semibold">{items[4].description}</p>
    </div>

    <!-- Logo bottom right -->
    <div class="absolute right-[80px] bottom-[90px] flex items-end gap-[8px]">
      <div class="w-[80px] h-[80px] bg-white rounded-[6px] flex items-center justify-center">
        <span class="text-[#0a0a0a] text-[60px] leading-none font-bold" style="font-family: 'Albert Sans', sans-serif;">a</span>
      </div>
      <span class="text-white text-[42px] font-bold leading-none" style="font-family: 'Albert Sans', sans-serif;">actualcorp</span>
    </div>
  </div>
</section>
