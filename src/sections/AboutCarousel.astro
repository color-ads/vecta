---
// About vertical carousel — 3 stacked slides (manifesto, 4 numbered cards,
// amenidades grid). Up/down arrows in the top-left swap the active slide.
//
// All copy and imagery comes from Contentful:
//   Slide 1 (manifesto)  — `webSite.bloque3seccion1texto` + `bloque3seccion1imagen`
//   Slide 2 (cards)      — `cards` content type, ordered by `fields.numero`
//   Slide 3 (amenidades) — `webSite.bloque3seccion3textos`
import { getContentfulClient, getWebsite } from '../lib/contentful';
import {
  assetUrl,
  extractHeadingPairs,
  firstHeading,
  richTextToPlain,
  richTextHtmlWithoutFirstHeading,
  splitParagraphAtFirstBold,
} from '../lib/richtext';

interface CardFields {
  numero: number;
  titulo: string;
  descripcion?: any;
}

const client = getContentfulClient();
const cardsRes = await client.getEntries({
  content_type: 'cards',
  order: ['fields.numero'],
});

const cards = (cardsRes.items as Array<{ fields: any}>).map((it) => ({
  number: `${it.fields.numero}.`,
  title: String(it.fields.titulo).trim(),
  description: richTextToPlain(it.fields.descripcion),
}));

const ws = await getWebsite();

// Slide 1 — manifesto.
// Contentful stores the body as a single paragraph with bold inline marks
// at "VECTA 98" and "sino para funcionar.". To match the original layout
// (two paragraphs separated by space), we split the paragraph at the first
// bold node before rendering. Bold marks are preserved either way.
const slide1Title = firstHeading(ws?.fields?.bloque3seccion1texto, 'heading-2');
const slide1Doc = splitParagraphAtFirstBold(ws?.fields?.bloque3seccion1texto);
// Pegamos "de forma aleatoria" con espacios no-rompibles (U+00A0) para que
// las tres palabras se rendericen siempre juntas en la misma línea aunque
// el resto del párrafo se wrappee. Sin esto, "de" se quedaba arriba y
// "forma aleatoria" caía al renglón siguiente.
const slide1BodyHtml = richTextHtmlWithoutFirstHeading(slide1Doc, 'heading-2')
  .replace(/de forma aleatoria/g, 'de forma aleatoria');
const slide1ImgSrc = assetUrl(ws?.fields?.bloque3seccion1imagen);

// Slide 3 — amenidades.
// Source is one heading-2 + 5 (heading-3 + paragraph) pairs. The 5 items
// feed the same 5 absolutely-positioned slots the layout already has.
const slide3Title = firstHeading(ws?.fields?.bloque3seccion3textos, 'heading-2');
// Insert a mobile-only <br> between "vendemos" and "sueños" so the title
// breaks across two lines on phones — matches the original copy. Falls
// back to a plain title if the keyword isn't present.
const slide3TitleHtml = slide3Title.includes('vendemos ')
  ? slide3Title.replace('vendemos ', 'vendemos<br class="hidden max-sm:inline" /> ')
  : slide3Title;
const items = extractHeadingPairs(ws?.fields?.bloque3seccion3textos, 'heading-3');
---
<section id="about-carousel" data-active-slide="0" class="relative w-full min-h-screen bg-vecta-bg overflow-hidden max-sm:min-h-[135vh]">
  <!-- Slide indicator dots — clickable, centered along the left strip. Only
       navigation control for this carousel on desktop. Hidden on mobile, where
       slides auto-advance every 5s instead. -->
  <div class="absolute left-[4.69%] top-1/2 -translate-y-1/2 flex flex-col items-center gap-[14px] z-50
              max-sm:left-1/2 max-sm:-translate-x-1/2 max-sm:translate-y-0 max-sm:top-[3vh] max-sm:flex-row">
    <!-- Flecha arriba (slide anterior). En mobile la fila es horizontal, así que
         rotamos -90° para que apunte a la izquierda. Color vía JS (accent). -->
    <button data-about-arrow="prev" aria-label="Slide anterior" type="button"
            class="text-vecta-dark cursor-pointer transition-all hover:scale-125 max-sm:-rotate-90">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="w-[14px] h-[14px]">
        <path d="M6 15l6-6 6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    {[0, 1, 2].map((i) => (
      <button data-about-dot={i} aria-label={`Ir al slide ${i + 1}`} type="button"
              class={`w-[14px] h-[14px] rounded-full border-2 border-vecta-dark cursor-pointer transition-all hover:scale-125 ${i === 0 ? 'bg-vecta-dark' : 'bg-transparent'}`}></button>
    ))}

    <!-- Flecha abajo (slide siguiente). -->
    <button data-about-arrow="next" aria-label="Slide siguiente" type="button"
            class="text-vecta-dark cursor-pointer transition-all hover:scale-125 max-sm:-rotate-90">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="w-[14px] h-[14px]">
        <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <!-- ============================================================
       SLIDE 1 — Manifesto on lime card (formerly AboutUs.astro)
       El wrapper queda `absolute inset-0` por requerimiento del carrusel
       (los 3 slides se apilan y crossfadean). Su CONTENIDO está en flex
       flow — cero hijos en absolute. -->
  <div data-about-slide="manifesto"
       class="absolute inset-0 transition-opacity duration-500 opacity-100 flex max-sm:flex-col">

    <!-- Lime panel con texto en flujo natural -->
    <div class="flex-1 bg-vecta-lime flex flex-col justify-center gap-[3vh] px-[8%] rounded-l-[10px]
                max-sm:rounded-none max-sm:flex-none max-sm:h-[75vh] max-sm:gap-[2vh] max-sm:py-[6vh] max-sm:text-center">
      <!-- Ambos "títulos" (h2 + primer párrafo bold) usan el mismo clamp con vw
           para que se vean del mismo tamaño y escalen con el viewport. -->
      <h2 class="text-vecta-dark font-semibold leading-[1.05] font-display text-[clamp(20px,5vw,60px)]">{slide1Title}</h2>

      <div class="w-[60%] h-px bg-vecta-dark max-sm:hidden"></div>

      <div class="text-vecta-dark font-thin text-[clamp(15px,1.9vw,24px)] leading-[0.95853] space-y-[1em] font-display
                  max-md:text-[clamp(20px,3vw,38px)]
                  max-sm:text-[4vw] max-sm:leading-[1.5]
                  [&>p:first-child]:text-[clamp(20px,5vw,60px)] [&>p:first-child]:font-semibold [&>p:first-child]:leading-[1.05]" set:html={slide1BodyHtml}></div>
    </div>

    <!-- Photo panel -->
    <div class="w-[clamp(200px,43vw,551px)] overflow-hidden rounded-r-[10px]
                max-sm:w-full max-sm:rounded-none max-sm:h-[60vh]">
      <img
        src={slide1ImgSrc}
        alt="Persona observando proyecto VECTA 98"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>

  <!-- ============================================================
       SLIDE 2 — 4 numbered cards on lime (formerly AboutCards.astro)
       ============================================================ -->
  <div data-about-slide="cards"
       class="absolute inset-0 transition-opacity duration-500 flex items-center justify-center opacity-0">
    <!-- Lime card con overflow-hidden + figuras geométricas anidadas.
         Mismas fórmulas que slide 1 (preserva la simetría auto-centrada).
         Las figuras hijas se dimensionan en % del lime card para escalar
         proporcionalmente en cualquier viewport. -->
    <div class="absolute left-1/2 -translate-x-1/2 bg-vecta-lime overflow-hidden top-[calc((100vw-1270px)/8)] bottom-[calc((100vw-1270px)/8)] w-[calc(75vw+317.5px)]
                sm:max-md:top-0 sm:max-md:bottom-0 sm:max-md:w-full">
      <!-- Figuras geométricas (Figma 2021:189 "Group 11"):
           - Rombo exterior (724.78/1270 = 57.07% del lime card)
           - Círculo + cuadrado interior (506.53/1270 = 39.88% del lime card)
           Las tres concéntricas, centro en (50%, 107%) del lime card,
           recortadas por el overflow-hidden. -->
      <div class="absolute pointer-events-none aspect-square w-[57%] left-1/2 top-[107%] sm:max-md:top-[73%] max-sm:top-[73%] -translate-x-1/2 -translate-y-1/2 border border-vecta-dark rotate-[-45deg]"></div>
      <div class="absolute pointer-events-none rounded-full aspect-square w-[40%] left-1/2 top-[107%] sm:max-md:top-[73%] max-sm:top-[73%] -translate-x-1/2 -translate-y-1/2 border border-vecta-dark"></div>
      <div class="absolute pointer-events-none aspect-square w-[40%] left-1/2 top-[107%] sm:max-md:top-[73%] max-sm:top-[73%] -translate-x-1/2 -translate-y-1/2 border border-vecta-dark"></div>
    </div>

    <div class="relative w-full max-w-[1280px] h-[832px] mx-auto
                sm:max-md:absolute sm:max-md:top-0 sm:max-md:left-0 sm:max-md:right-0 sm:max-md:h-full sm:max-md:flex sm:max-md:items-center sm:max-md:justify-center sm:max-md:max-w-none
                max-sm:absolute max-sm:top-0 max-sm:left-0 max-sm:right-0 max-sm:h-full max-sm:flex max-sm:items-center max-sm:justify-center max-sm:max-w-none">
      <!-- Cards container: 4 cols horizontal (desktop Y pc-small — usan el mismo
           layout Figma con clamp() que escala el contenido automáticamente),
           1 col stacked (tablet y mobile). Posiciones internas en % del card
           para que escalen proporcionalmente cuando el card se vuelve más
           angosto a 1024px CSS viewport. -->
      <div class="absolute left-[6.56%] top-[28.49%] flex gap-[10px] w-[87.03%]
                  sm:max-md:relative sm:max-md:top-auto sm:max-md:left-auto sm:max-md:grid sm:max-md:grid-cols-1 sm:max-md:gap-[16px] sm:max-md:w-[75%] sm:max-md:mx-auto
                  max-sm:relative max-sm:top-auto max-sm:left-auto max-sm:grid max-sm:grid-cols-1 max-sm:gap-[16px] max-sm:w-[92%] max-sm:mx-auto">
        {cards.map((c) => (
          <article class="relative w-[24.33%] aspect-[271/436] rounded-[10px] bg-[#0a0a0a] text-white
                          sm:max-md:w-full sm:max-md:aspect-auto sm:max-md:h-[22vh]
                          max-sm:w-full max-sm:aspect-auto max-sm:h-[22vh]">
            <span class="absolute left-[8.86%] top-[2.52%] text-[clamp(40px,7vw,105px)] leading-none font-bold text-white font-display
                         sm:max-md:left-[6%] sm:max-md:top-[3%] sm:max-md:text-[6.5vw]
                         max-sm:left-[6%] max-sm:top-[3%] max-sm:text-[9vw]">{c.number}</span>
            <p class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[80.44%] text-center text-[clamp(10px,1vw,18px)] leading-[1.3] font-thin font-display
                      sm:max-md:w-[88%] sm:max-md:text-[2.4vw]
                      max-sm:w-[88%] max-sm:text-[3.2vw]">{c.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>

  <!-- ============================================================
       SLIDE 3 — Amenidades grid on black (formerly AboutAmenidades.astro)
       Mobile: 100% flex flow (sin absolute). El wrapper queda absolute
       solo por requerimiento del carrusel.
       PC: layout absolute con la grid Figma (sin cambios). -->
  <div data-about-slide="amenidades"
       class="absolute inset-0 transition-opacity duration-500 opacity-0 flex items-center justify-center
              max-sm:flex-col max-sm:bg-[#0a0a0a]">

    <!-- PC: black card + círculo decorativo. Hidden en mobile (el bg negro
         lo pinta el slide wrapper directamente con max-sm:bg-[#0a0a0a]). -->
    <div class="absolute left-1/2 -translate-x-1/2 bg-[#0a0a0a] overflow-hidden top-[calc((100vw-1270px)/8)] bottom-[calc((100vw-1270px)/8)] w-[calc(75vw+317.5px)] max-sm:hidden">
      <div class="absolute -left-[16.17%] -top-[18.87%] w-[48.44%] aspect-square rounded-full border border-vecta-lime-text/40"></div>
    </div>

    <!-- Mobile-only: contenido en flex flow puro, sin absolute. -->
    <div class="hidden max-sm:flex max-sm:flex-col max-sm:items-center max-sm:justify-center max-sm:gap-[9.45%] max-sm:flex-1 max-sm:w-full max-sm:px-[7%] max-sm:py-[6%] max-sm:text-center">
      <h2 class="text-vecta-lime-text font-semibold font-display text-[6.5vw] leading-[1.05] w-full" set:html={slide3TitleHtml}></h2>
      {items.map((item) => (
        <div class="w-full">
          <h3 class="text-vecta-lime-text font-semibold font-display text-[3.3vw] leading-[0.959]">{item.title}</h3>
          <p class="mt-[1vh] text-white font-thin font-display text-[2.8vw] leading-[1.35]">{item.description}</p>
        </div>
      ))}
    </div>

    <div class="relative w-full max-w-[1280px] h-full mx-auto max-sm:hidden">
      <h2 class="absolute left-[5.31%] top-[12.38%] 2xl:top-[20%] w-[49.92%] text-vecta-lime-text font-semibold text-[clamp(22px,3.5vw,44px)] leading-[0.959] font-display" set:html={slide3TitleHtml}></h2>

      <!-- Wrapper for everything below the title — mobile shifts this whole
           block down 160px (≈20% of slide height) so the title up top has air. -->
      <div class="contents max-sm:block">
      <!-- Cross-grid lines (1px solid #FFF) — hidden on mobile -->
      <div class="absolute left-[32.19%] top-[0.12%] w-px h-[97.96%] bg-white max-sm:hidden"></div>
      <div class="absolute left-[66.48%] top-[0.12%] w-px h-[97.96%] bg-white max-sm:hidden"></div>
      <div class="absolute left-[32.27%] top-[39.30%] w-[66.88%] h-px bg-white max-sm:hidden"></div>
      <div class="absolute left-[32.27%] top-[65.87%] w-[66.88%] h-px bg-white max-sm:hidden"></div>

      <!-- Dots at line intersections (white) — hidden on mobile -->
      <span class="absolute left-[31.72%] top-[38.58%] w-[12px] h-[12px] rounded-full bg-white max-sm:hidden"></span>
      <span class="absolute left-[31.72%] top-[65.14%] w-[12px] h-[12px] rounded-full bg-white max-sm:hidden"></span>
      <span class="absolute left-[66.02%] top-[38.58%] w-[12px] h-[12px] rounded-full bg-white max-sm:hidden"></span>
      <span class="absolute left-[66.02%] top-[65.14%] w-[12px] h-[12px] rounded-full bg-white max-sm:hidden"></span>

      <div class="absolute left-[70.94%] top-[10.94%] 2xl:top-[18%] w-[21.88%] font-display
                  max-sm:left-1/2 max-sm:-translate-x-1/2 max-sm:top-[11vh] max-sm:w-[90%] max-sm:max-w-[54.69%] max-sm:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[clamp(13px,1.7vw,22px)] leading-[0.959] max-sm:text-[3.3vw]">{items[0].title}</h3>
        <p class="mt-[18px] text-white font-thin text-[clamp(11px,1.1vw,15px)] leading-[1.35] max-sm:text-[2.8vw] max-sm:mt-[1vh]">{items[0].description}</p>
      </div>
      <div class="absolute left-[39.22%] top-[42.55%] w-[20.31%] font-display
                  max-sm:left-1/2 max-sm:-translate-x-1/2 max-sm:top-[25vh] max-sm:w-[90%] max-sm:max-w-[54.69%] max-sm:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[clamp(13px,1.7vw,22px)] leading-[0.959] max-sm:text-[3.3vw]">{items[1].title}</h3>
        <p class="mt-[18px] text-white font-thin text-[clamp(11px,1.1vw,15px)] leading-[1.35] max-sm:text-[2.8vw] max-sm:mt-[1vh]">{items[1].description}</p>
      </div>
      <div class="absolute left-[70.94%] top-[42.55%] w-[20.31%] font-display
                  max-sm:left-1/2 max-sm:-translate-x-1/2 max-sm:top-[38vh] max-sm:w-[90%] max-sm:max-w-[54.69%] max-sm:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[clamp(13px,1.7vw,22px)] leading-[0.959] max-sm:text-[3.3vw]">{items[2].title}</h3>
        <p class="mt-[18px] text-white font-thin text-[clamp(11px,1.1vw,15px)] leading-[1.35] max-sm:text-[2.8vw] max-sm:mt-[1vh]">{items[2].description}</p>
      </div>
      <div class="absolute left-[5.31%] top-[71.88%] w-[23.44%] font-display
                  max-sm:left-1/2 max-sm:-translate-x-1/2 max-sm:top-[51vh] max-sm:w-[90%] max-sm:max-w-[54.69%] max-sm:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[clamp(13px,1.7vw,22px)] leading-[0.959] max-sm:text-[3.3vw]">{items[3].title}</h3>
        <p class="mt-[18px] text-white font-thin text-[clamp(11px,1.1vw,15px)] leading-[1.35] max-sm:text-[2.8vw] max-sm:mt-[1vh]">{items[3].description}</p>
      </div>
      <div class="absolute left-[39.22%] top-[71.88%] w-[20.31%] font-display
                  max-sm:left-1/2 max-sm:-translate-x-1/2 max-sm:top-[64vh] max-sm:w-[90%] max-sm:max-w-[54.69%] max-sm:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[clamp(13px,1.7vw,22px)] leading-[0.959] max-sm:text-[3.3vw]">{items[4].title}</h3>
        <p class="mt-[18px] text-white font-thin text-[clamp(11px,1.1vw,15px)] leading-[1.35] max-sm:text-[2.8vw] max-sm:mt-[1vh]">{items[4].description}</p>
      </div>

      <!-- actualcorp logo — esquina inferior-derecha del canvas. Solo PC. -->
      <img
        src="/Logo_Blanco.png"
        alt="actualcorp"
        class="absolute right-[6.25%] bottom-[10.82%] w-[12.03%] h-[18.51%] object-contain max-sm:hidden"
      />

      </div>
    </div>
  </div>
</section>

<script>
  function initAboutCarousel() {
    const slides = document.querySelectorAll<HTMLElement>('[data-about-slide]');
    const dots = document.querySelectorAll<HTMLButtonElement>('[data-about-dot]');
    const arrows = document.querySelectorAll<HTMLButtonElement>('[data-about-arrow]');
    const total = slides.length;
    if (!total) return;
    let active = 0;

    // Slide 3 (amenidades) sits on a black card — dots flip to vecta-lime so
    // they remain visible against the dark background.
    const ACCENT_DEFAULT = '#22291D'; // vecta-dark — for slides 1 & 2 (lime cards)
    const ACCENT_DARK_SLIDE = '#EAFC9D'; // vecta-lime — for slide 3 (black card)

    const sectionEl = document.getElementById('about-carousel');

    function show(i: number) {
      active = (i + total) % total;
      const accent = active === 2 ? ACCENT_DARK_SLIDE : ACCENT_DEFAULT;

      slides.forEach((s, idx) => {
        s.style.opacity = idx === active ? '1' : '0';
        s.style.pointerEvents = idx === active ? 'auto' : 'none';
      });
      dots.forEach((d, idx) => {
        d.style.borderColor = accent;
        d.style.backgroundColor = idx === active ? accent : 'transparent';
      });
      // Las flechas usan stroke="currentColor", así que basta con setear color.
      arrows.forEach((a) => { a.style.color = accent; });
      // Mirror active slide on the section so the global nav theme handler
      // can react (slide 3 → lime nav over the dark amenidades card).
      if (sectionEl) sectionEl.dataset.activeSlide = String(active);
      document.dispatchEvent(new CustomEvent('about-slide-change'));
    }

    dots.forEach((d, idx) => {
      d.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        show(idx);
        // Manual selection on desktop also pauses auto-rotate (if running).
        pauseThenResume();
      });
    });

    // Flechas arriba/abajo → slide anterior/siguiente (con wrap-around).
    arrows.forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const dir = a.getAttribute('data-about-arrow') === 'next' ? 1 : -1;
        show(active + dir);
        pauseThenResume();
      });
    });

    // ----- Mobile auto-rotation -----
    // On true phones (data-device="phone", ≤768) the dots are hidden;
    // instead we cycle through slides every AUTO_MS. Runs continuously —
    // does NOT pause on touchstart/pointerdown of the section, because
    // those fire for plain scroll gestures (the section spans most of the
    // viewport) and would suppress the rotation indefinitely. Aligned with
    // the `max-sm:` Tailwind variant so JS and CSS agree on what's mobile.
    const AUTO_MS = 5000;
    const RESUME_MS = 10000;
    const isMobile = document.documentElement.getAttribute('data-device') === 'phone';
    let autoTimer: number | null = null;
    let resumeTimer: number | null = null;

    function startAuto() {
      if (!isMobile) return;
      stopAuto();
      autoTimer = window.setInterval(() => show(active + 1), AUTO_MS);
    }
    function stopAuto() {
      if (autoTimer !== null) { clearInterval(autoTimer); autoTimer = null; }
      if (resumeTimer !== null) { clearTimeout(resumeTimer); resumeTimer = null; }
    }
    function pauseThenResume() {
      if (!isMobile) return;
      stopAuto();
      resumeTimer = window.setTimeout(startAuto, RESUME_MS);
    }

    // Apply initial styling consistently (slide 0, default accent).
    show(0);
    startAuto();
  }

  // Run after DOM ready (Astro deferred scripts run post-parse, but this
  // guards against any edge case where elements aren't yet queryable).
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutCarousel);
  } else {
    initAboutCarousel();
  }
</script>
