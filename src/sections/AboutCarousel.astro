---
// About vertical carousel — 3 stacked slides (manifesto, 4 numbered cards,
// amenidades grid). Up/down arrows in the top-left swap the active slide.
//
// All copy and imagery comes from Contentful:
//   Slide 1 (manifesto)  — `webSite.bloque3seccion1texto` + `bloque3seccion1imagen`
//   Slide 2 (cards)      — `cards` content type, ordered by `fields.numero`
//   Slide 3 (amenidades) — `webSite.bloque3seccion3textos`
import { getContentfulClient, getWebsite } from '../lib/contentful';
import {
  assetUrl,
  extractHeadingPairs,
  firstHeading,
  richTextToPlain,
  richTextHtmlWithoutFirstHeading,
  splitParagraphAtFirstBold,
} from '../lib/richtext';

interface CardFields {
  numero: number;
  titulo: string;
  descripcion?: any;
}

const client = getContentfulClient();
const cardsRes = await client.getEntries({
  content_type: 'cards',
  order: ['fields.numero'],
});

const cards = (cardsRes.items as Array<{ fields: CardFields }>).map((it) => ({
  number: `${it.fields.numero}.`,
  title: String(it.fields.titulo).trim(),
  description: richTextToPlain(it.fields.descripcion),
}));

const ws = await getWebsite();

// Slide 1 — manifesto.
// Contentful stores the body as a single paragraph with bold inline marks
// at "VECTA 98" and "sino para funcionar.". To match the original layout
// (two paragraphs separated by space), we split the paragraph at the first
// bold node before rendering. Bold marks are preserved either way.
const slide1Title = firstHeading(ws?.fields?.bloque3seccion1texto, 'heading-2');
const slide1Doc = splitParagraphAtFirstBold(ws?.fields?.bloque3seccion1texto);
// Pegamos "de forma aleatoria" con espacios no-rompibles (U+00A0) para que
// las tres palabras se rendericen siempre juntas en la misma línea aunque
// el resto del párrafo se wrappee. Sin esto, "de" se quedaba arriba y
// "forma aleatoria" caía al renglón siguiente.
const slide1BodyHtml = richTextHtmlWithoutFirstHeading(slide1Doc, 'heading-2')
  .replace(/de forma aleatoria/g, 'de forma aleatoria');
const slide1ImgSrc = assetUrl(ws?.fields?.bloque3seccion1imagen);

// Slide 3 — amenidades.
// Source is one heading-2 + 5 (heading-3 + paragraph) pairs. The 5 items
// feed the same 5 absolutely-positioned slots the layout already has.
const slide3Title = firstHeading(ws?.fields?.bloque3seccion3textos, 'heading-2');
// Insert a mobile-only <br> between "vendemos" and "sueños" so the title
// breaks across two lines on phones — matches the original copy. Falls
// back to a plain title if the keyword isn't present.
const slide3TitleHtml = slide3Title.includes('vendemos ')
  ? slide3Title.replace('vendemos ', 'vendemos<br class="hidden mobile:inline" /> ')
  : slide3Title;
const items = extractHeadingPairs(ws?.fields?.bloque3seccion3textos, 'heading-3');
---
<section id="about-carousel" data-active-slide="0" class="relative w-full min-w-[1280px] min-h-screen bg-vecta-bg overflow-hidden">
  <!-- Slide indicator dots — clickable, centered along the left strip. Only
       navigation control for this carousel on desktop. Hidden on mobile, where
       slides auto-advance every 5s instead. -->
  <div class="absolute left-[60px] top-1/2 -translate-y-1/2 flex flex-col gap-[14px] z-50 mobile:hidden">
    {[0, 1, 2].map((i) => (
      <button data-about-dot={i} aria-label={`Ir al slide ${i + 1}`} type="button"
              class={`w-[14px] h-[14px] rounded-full border-2 border-vecta-dark cursor-pointer transition-all hover:scale-125 ${i === 0 ? 'bg-vecta-dark' : 'bg-transparent'}`}></button>
    ))}
  </div>

  <!-- ============================================================
       SLIDE 1 — Manifesto on lime card (formerly AboutUs.astro)
       ============================================================ -->
  <div data-about-slide="manifesto"
       class="absolute inset-0 transition-opacity duration-500 flex items-center justify-center opacity-100">
    <!-- Lime rounded card grows with viewport. White side strips reduced ~75%
         relative to a 1280-capped layout. -->
    <div class="absolute rounded-[10px] bg-vecta-lime top-[calc((100vw-1270px)/8)] bottom-[calc((100vw-1270px)/8)] right-[calc((100vw-1270px)/8)] w-[calc(75vw+317.5px)] min-w-[1270px]"></div>

    <!-- Right photo card — anchored to the lime card's right edge -->
    <div class="absolute w-[551px] rounded-r-[10px] overflow-hidden top-[calc((100vw-1270px)/8)] bottom-[calc((100vw-1270px)/8)] right-[calc((100vw-1270px)/8)]">
      <img
        src={slide1ImgSrc}
        alt="Persona observando proyecto VECTA 98"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Inner 1280px canvas keeps Figma absolute positions intact for text -->
    <div class="relative w-[1280px] h-[812px] mx-auto">
      <h2 class="absolute left-[74px] top-[42px] w-[639px] text-vecta-dark font-semibold text-[84px] leading-[0.95853] font-display
                 narrow:text-[120px]
                 pc-small:!text-[60px]">{slide1Title}</h2>
      <div class="absolute left-[80px] top-[126px] w-[495px] h-px bg-vecta-dark"></div>
      <div class="absolute left-[74px] top-[189px] w-[475px] text-vecta-dark font-normal text-[24px] leading-[0.95853] space-y-[1em] font-display
                  narrow:text-[38px] narrow:w-[560px]
                  [&>p:first-child]:text-[60px] [&>p:first-child]:font-semibold
                  narrow:[&>p:first-child]:text-[90px]" set:html={slide1BodyHtml}></div>
    </div>
  </div>

  <!-- ============================================================
       SLIDE 2 — 4 numbered cards on lime (formerly AboutCards.astro)
       ============================================================ -->
  <div data-about-slide="cards"
       class="absolute inset-0 transition-opacity duration-500 flex items-center justify-center opacity-0">
    <!-- Lime card with overflow-hidden + the geometric figures nested inside.
         Anything bleeding past the lime card's rounded edges gets clipped, so
         the strokes never leak onto the bg-vecta-bg side strips. -->
    <div class="absolute left-1/2 -translate-x-1/2 bg-vecta-lime overflow-hidden top-[calc((100vw-1270px)/8)] bottom-[calc((100vw-1270px)/8)] w-[calc(75vw+317.5px)] min-w-[1270px]">
      <!-- Geometric figure background (Figma 2021:189 "Group 11"):
           - Rectangle 2 (outer)  — 724.78×724.78 rotated -45° → 1025 diamond
           - Rectangle 3 (inner)  — 506.53×506.53 axis-aligned
           - Ellipse 1            — 506.53×506.53 circle inscribed in the square
           All three concentric, centered horizontally on the lime card and
           shifted +37% down from its mid (50% + 37% = 87% on the y-axis).
           Clipped by the lime card's overflow-hidden. -->
      <div class="absolute pointer-events-none w-[724.78px] h-[724.78px] left-[calc(50%-362.39px)] top-[calc(107%-362.39px)] border border-vecta-dark rotate-[-45deg]"></div>
      <div class="absolute pointer-events-none rounded-full w-[506.53px] h-[506.53px] left-[calc(50%-253.265px)] top-[calc(107%-253.265px)] border border-vecta-dark"></div>
      <div class="absolute pointer-events-none w-[506.53px] h-[506.53px] left-[calc(50%-253.265px)] top-[calc(107%-253.265px)] border border-vecta-dark"></div>
    </div>

    <div class="relative w-[1280px] h-[832px] mx-auto mobile:h-auto mobile:min-h-screen">
      <div class="absolute left-[84px] top-[237px] flex gap-[10px] mobile:grid mobile:grid-cols-[600px_600px] mobile:gap-[20px] mobile:left-1/2 mobile:top-1/2 mobile:-translate-x-1/2 mobile:-translate-y-1/2 mobile:w-[1220px]">
        {cards.map((c) => (
          <article class="relative w-[271px] h-[436px] rounded-[10px] bg-[#0a0a0a] text-white mobile:w-[600px] mobile:h-[760px]">
            <span class="absolute left-[24px] top-[11px] text-[105px] leading-none font-bold text-white font-display mobile:left-[36px] mobile:top-[18px] mobile:text-[180px]">{c.number}</span>
            <div class="absolute right-[20px] top-[22px] w-[55px] h-[55px] rounded-full bg-white flex items-center justify-center mobile:right-[36px] mobile:top-[36px] mobile:w-[100px] mobile:h-[100px]">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 28" fill="none" class="w-[28px] h-[28px] mobile:w-[50px] mobile:h-[50px]">
                <path d="M10.4954 17.4921V20.9905C10.4954 22.9226 8.92908 24.4889 6.99696 24.4889C5.06483 24.4889 3.49854 22.9226 3.49854 20.9905C3.49854 19.0584 5.06483 17.4921 6.99696 17.4921H10.4954ZM10.4954 17.4921H17.4922M10.4954 17.4921V10.4953M17.4922 17.4921V20.9905C17.4922 22.9226 19.0585 24.4889 20.9906 24.4889C22.9228 24.4889 24.4891 22.9226 24.4891 20.9905C24.4891 19.0584 22.9228 17.4921 20.9906 17.4921H17.4922ZM17.4922 17.4921V10.4953M17.4922 10.4953H10.4954M17.4922 10.4953V6.99683C17.4922 5.06471 19.0585 3.49841 20.9906 3.49841C22.9228 3.49841 24.4891 5.06471 24.4891 6.99683C24.4891 8.92896 22.9228 10.4953 20.9906 10.4953H17.4922ZM10.4954 10.4953V6.99683C10.4954 5.06471 8.92908 3.49841 6.99696 3.49841C5.06483 3.49841 3.49854 5.06471 3.49854 6.99683C3.49854 8.92896 5.06483 10.4953 6.99696 10.4953H10.4954Z" stroke="#151515" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <!-- Title is bottom-anchored with a small gap above the line so 1-line
                 (Claridad, Ciudad activa) and 2-line (Arquitectura funcional,
                 Coherencia a largo plazo) titles all sit ~13px above the line
                 (≈ 3% of the 436px card height). -->
            <h3 class="absolute left-[24px] bottom-[127px] w-[217px] text-[36px] font-semibold leading-[0.95] font-display mobile:left-[36px] mobile:bottom-[240px] mobile:w-[460px] mobile:text-[56px]">{c.title}</h3>
            <span class="absolute left-[24px] top-[322px] w-[126px] h-px bg-white mobile:left-[36px] mobile:top-[530px] mobile:w-[220px]"></span>
            <p class="absolute left-[24px] top-[343px] w-[218px] text-[18px] leading-[1.3] font-bold font-display mobile:left-[36px] mobile:top-[565px] mobile:w-[480px] mobile:text-[28px]">{c.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>

  <!-- ============================================================
       SLIDE 3 — Amenidades grid on black (formerly AboutAmenidades.astro)
       ============================================================ -->
  <div data-about-slide="amenidades"
       class="absolute inset-0 transition-opacity duration-500 flex items-center justify-center mobile:items-start mobile:pt-[208px] opacity-0">
    <div class="absolute left-1/2 -translate-x-1/2 bg-[#0a0a0a] overflow-hidden top-[calc((100vw-1270px)/8)] bottom-[calc((100vw-1270px)/8)] w-[calc(75vw+317.5px)] min-w-[1270px]">
      <div class="absolute -left-[207px] -top-[157px] w-[620px] h-[620px] rounded-full border border-vecta-lime-text/40"></div>
    </div>

    <div class="relative w-[1280px] h-[832px] mx-auto">
      <h2 class="absolute left-[68px] top-[103px] w-[639px] text-vecta-lime-text font-semibold text-[60px] leading-[0.959] font-display
                 mobile:left-0 mobile:right-0 mobile:top-[200px] mobile:w-full mobile:text-center mobile:px-[40px] mobile:text-[100px] mobile:leading-[1.05]" set:html={slide3TitleHtml}></h2>

      <!-- Wrapper for everything below the title — mobile shifts this whole
           block down 160px (≈20% of slide height) so the title up top has air. -->
      <div class="contents mobile:block mobile:translate-y-[160px]">
      <!-- Cross-grid lines (1px solid #FFF) — hidden on mobile -->
      <div class="absolute left-[412px] top-[1px] w-px h-[815px] bg-white mobile:hidden"></div>
      <div class="absolute left-[851px] top-[1px] w-px h-[815px] bg-white mobile:hidden"></div>
      <div class="absolute left-[413px] top-[327px] w-[856px] h-px bg-white mobile:hidden"></div>
      <div class="absolute left-[413px] top-[548px] w-[856px] h-px bg-white mobile:hidden"></div>

      <!-- Dots at line intersections (white) — hidden on mobile -->
      <span class="absolute left-[406px] top-[321px] w-[12px] h-[12px] rounded-full bg-white mobile:hidden"></span>
      <span class="absolute left-[406px] top-[542px] w-[12px] h-[12px] rounded-full bg-white mobile:hidden"></span>
      <span class="absolute left-[845px] top-[321px] w-[12px] h-[12px] rounded-full bg-white mobile:hidden"></span>
      <span class="absolute left-[845px] top-[542px] w-[12px] h-[12px] rounded-full bg-white mobile:hidden"></span>

      <div class="absolute left-[908px] top-[91px] w-[280px] font-display
                  mobile:left-1/2 mobile:-translate-x-1/2 mobile:top-[320px] mobile:w-[700px] mobile:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[28px] leading-[0.959] mobile:text-[72px]">{items[0].title}</h3>
        <p class="mt-[28px] text-white text-[18px] leading-[1.35] font-semibold mobile:text-[40px] mobile:mt-[36px]">{items[0].description}</p>
      </div>
      <div class="absolute left-[502px] top-[354px] w-[260px] font-display
                  mobile:left-1/2 mobile:-translate-x-1/2 mobile:top-[640px] mobile:w-[700px] mobile:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[28px] leading-[0.959] mobile:text-[72px]">{items[1].title}</h3>
        <p class="mt-[28px] text-white text-[18px] leading-[1.35] font-semibold mobile:text-[40px] mobile:mt-[36px]">{items[1].description}</p>
      </div>
      <div class="absolute left-[908px] top-[354px] w-[260px] font-display
                  mobile:left-1/2 mobile:-translate-x-1/2 mobile:top-[960px] mobile:w-[700px] mobile:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[28px] leading-[0.959] mobile:text-[72px]">{items[2].title}</h3>
        <p class="mt-[28px] text-white text-[18px] leading-[1.35] font-semibold mobile:text-[40px] mobile:mt-[36px]">{items[2].description}</p>
      </div>
      <div class="absolute left-[68px] top-[598px] w-[300px] font-display
                  mobile:left-1/2 mobile:-translate-x-1/2 mobile:top-[1280px] mobile:w-[700px] mobile:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[28px] leading-[0.959] mobile:text-[72px]">{items[3].title}</h3>
        <p class="mt-[28px] text-white text-[18px] leading-[1.35] font-semibold mobile:text-[40px] mobile:mt-[36px]">{items[3].description}</p>
      </div>
      <div class="absolute left-[502px] top-[598px] w-[260px] font-display
                  mobile:left-1/2 mobile:-translate-x-1/2 mobile:top-[1600px] mobile:w-[700px] mobile:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[28px] leading-[0.959] mobile:text-[72px]">{items[4].title}</h3>
        <p class="mt-[28px] text-white text-[18px] leading-[1.35] font-semibold mobile:text-[40px] mobile:mt-[36px]">{items[4].description}</p>
      </div>

      <div class="absolute right-[80px] bottom-[90px] flex flex-col items-center gap-[8px]
                  mobile:hidden">
        <!-- actualcorp logo: outer "a" mark + inner counter/eye nested inside.
             Inner 29×27 SVG offset from geometric center by +14% right / +11%
             down of the outer 90×90 (≈ +12.6 px right, +9.9 px down):
               x = (90 - 29) / 2 + 0.14·90 = 30.5 + 12.6 = 43.1
               y = (90 - 27) / 2 + 0.11·90 = 31.5 + 9.9  = 41.4 -->
        <svg xmlns="http://www.w3.org/2000/svg" width="90" height="90" viewBox="0 0 90 90" fill="none">
          <path d="M65.338 0.207339C76.8727 -1.82185 77.5324 11.5197 79.3628 19.4294C77.7054 16.6523 75.4046 13.0969 72.6029 11.3261C62.2186 4.76404 42.4457 9.62051 35.4325 19.3492C31.6563 24.5876 31.6736 31.7141 32.7026 37.62L42.9649 35.8498C41.8329 29.9249 42.6738 24.4495 48.3566 21.2755C54.1861 18.0189 64.7149 16.338 68.7607 23.1667C70.1371 25.492 70.1392 28.5987 69.4204 31.1272C68.8808 31.631 68.2435 32.1308 67.5533 32.4601C57.0611 37.4694 41.391 38.735 35.9429 50.548C33.9834 54.7967 34.2772 60.8272 35.9464 65.0815C41.0286 78.0343 54.6137 78.9007 66.1728 74.2183C71.764 71.8957 75.9055 68.6264 78.5179 62.9531C80.7963 67.3155 84.3554 69.9255 89.3236 68.03C87.2773 77.006 82.3967 76.635 74.7449 78.271L60.7831 81.2603L35.4681 86.529C31.2655 87.3824 27.0731 88.278 22.8473 89.0271C18.3471 89.8248 14.3436 87.7078 12.958 83.2522C11.8215 79.5964 11.1107 75.8043 10.2942 72.0632C8.81716 65.338 7.38109 58.6037 5.98613 51.8609L2.16227 34.0275C0.914527 28.225 -1.91203 20.6621 1.98736 15.6785C4.35905 12.6476 8.80698 12.1286 12.3684 11.2881C17.7267 10.0231 23.1393 8.99751 28.5086 7.83231L53.1313 2.64588C56.7699 1.89962 61.791 0.687904 65.338 0.207339Z" fill="white"/>
          <svg x="43.1" y="41.4" width="29" height="27" viewBox="0 0 29 27" fill="none">
            <path d="M26.9093 0L27.286 0.145698C27.5711 0.897258 27.7136 1.49659 27.8215 2.28794C28.526 7.40214 29.483 12.3929 26.7159 17.1028C22.3973 24.4564 11.3981 28.9237 3.67298 24.3607C2.60198 23.6032 1.72033 22.6074 1.09727 21.4514C0.0384793 19.4587 -0.348387 16.7212 0.358151 14.5245C2.17438 8.87649 10.83 6.67711 15.7452 4.63812C19.4795 3.08889 23.3318 1.90124 26.9093 0Z" fill="white"/>
          </svg>
        </svg>
        <span class="text-white text-[42px] font-bold leading-none font-display mobile:text-[64px]">actualcorp</span>
      </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initAboutCarousel() {
    const slides = document.querySelectorAll<HTMLElement>('[data-about-slide]');
    const dots = document.querySelectorAll<HTMLButtonElement>('[data-about-dot]');
    const total = slides.length;
    if (!total) return;
    let active = 0;

    // Slide 3 (amenidades) sits on a black card — dots flip to vecta-lime so
    // they remain visible against the dark background.
    const ACCENT_DEFAULT = '#22291D'; // vecta-dark — for slides 1 & 2 (lime cards)
    const ACCENT_DARK_SLIDE = '#EAFC9D'; // vecta-lime — for slide 3 (black card)

    const sectionEl = document.getElementById('about-carousel');

    function show(i: number) {
      active = (i + total) % total;
      const accent = active === 2 ? ACCENT_DARK_SLIDE : ACCENT_DEFAULT;

      slides.forEach((s, idx) => {
        s.style.opacity = idx === active ? '1' : '0';
        s.style.pointerEvents = idx === active ? 'auto' : 'none';
      });
      dots.forEach((d, idx) => {
        d.style.borderColor = accent;
        d.style.backgroundColor = idx === active ? accent : 'transparent';
      });
      // Mirror active slide on the section so the global nav theme handler
      // can react (slide 3 → lime nav over the dark amenidades card).
      if (sectionEl) sectionEl.dataset.activeSlide = String(active);
      document.dispatchEvent(new CustomEvent('about-slide-change'));
    }

    dots.forEach((d, idx) => {
      d.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        show(idx);
        // Manual selection on desktop also pauses auto-rotate (if running).
        pauseThenResume();
      });
    });

    // ----- Mobile auto-rotation -----
    // On true phones (data-device="phone", ≤768) the dots are hidden;
    // instead we cycle through slides every AUTO_MS. Runs continuously —
    // does NOT pause on touchstart/pointerdown of the section, because
    // those fire for plain scroll gestures (the section spans most of the
    // viewport) and would suppress the rotation indefinitely. Aligned with
    // the `mobile:` Tailwind variant so JS and CSS agree on what's mobile.
    const AUTO_MS = 5000;
    const RESUME_MS = 10000;
    const isMobile = document.documentElement.getAttribute('data-device') === 'phone';
    let autoTimer: number | null = null;
    let resumeTimer: number | null = null;

    function startAuto() {
      if (!isMobile) return;
      stopAuto();
      autoTimer = window.setInterval(() => show(active + 1), AUTO_MS);
    }
    function stopAuto() {
      if (autoTimer !== null) { clearInterval(autoTimer); autoTimer = null; }
      if (resumeTimer !== null) { clearTimeout(resumeTimer); resumeTimer = null; }
    }
    function pauseThenResume() {
      if (!isMobile) return;
      stopAuto();
      resumeTimer = window.setTimeout(startAuto, RESUME_MS);
    }

    // Apply initial styling consistently (slide 0, default accent).
    show(0);
    startAuto();
  }

  // Run after DOM ready (Astro deferred scripts run post-parse, but this
  // guards against any edge case where elements aren't yet queryable).
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutCarousel);
  } else {
    initAboutCarousel();
  }
</script>
