---
// About vertical carousel — 3 stacked slides (manifesto, 4 numbered cards,
// amenidades grid). Up/down arrows in the top-left swap the active slide.
//
// All copy and imagery comes from Contentful:
//   Slide 1 (manifesto)  — `webSite.bloque3seccion1texto` + `bloque3seccion1imagen`
//   Slide 2 (cards)      — `cards` content type, ordered by `fields.numero`
//   Slide 3 (amenidades) — `webSite.bloque3seccion3textos`
import { getContentfulClient, getWebsite } from '../lib/contentful';
import {
  assetUrl,
  extractHeadingPairs,
  firstHeading,
  richTextToPlain,
  richTextHtmlWithoutFirstHeading,
  splitParagraphAtFirstBold,
} from '../lib/richtext';

interface CardFields {
  numero: number;
  titulo: string;
  descripcion?: any;
}

const client = getContentfulClient();
const cardsRes = await client.getEntries({
  content_type: 'cards',
  order: ['fields.numero'],
});

const cards = (cardsRes.items as Array<{ fields: CardFields }>).map((it) => ({
  number: `${it.fields.numero}.`,
  title: String(it.fields.titulo).trim(),
  description: richTextToPlain(it.fields.descripcion),
}));

const ws = await getWebsite();

// Slide 1 — manifesto.
// Contentful stores the body as a single paragraph with bold inline marks
// at "VECTA 98" and "sino para funcionar.". To match the original layout
// (two paragraphs separated by space), we split the paragraph at the first
// bold node before rendering. Bold marks are preserved either way.
const slide1Title = firstHeading(ws?.fields?.bloque3seccion1texto, 'heading-2');
const slide1Doc = splitParagraphAtFirstBold(ws?.fields?.bloque3seccion1texto);
// Pegamos "de forma aleatoria" con espacios no-rompibles (U+00A0) para que
// las tres palabras se rendericen siempre juntas en la misma línea aunque
// el resto del párrafo se wrappee. Sin esto, "de" se quedaba arriba y
// "forma aleatoria" caía al renglón siguiente.
const slide1BodyHtml = richTextHtmlWithoutFirstHeading(slide1Doc, 'heading-2')
  .replace(/de forma aleatoria/g, 'de forma aleatoria');
const slide1ImgSrc = assetUrl(ws?.fields?.bloque3seccion1imagen);

// Slide 3 — amenidades.
// Source is one heading-2 + 5 (heading-3 + paragraph) pairs. The 5 items
// feed the same 5 absolutely-positioned slots the layout already has.
const slide3Title = firstHeading(ws?.fields?.bloque3seccion3textos, 'heading-2');
// Insert a mobile-only <br> between "vendemos" and "sueños" so the title
// breaks across two lines on phones — matches the original copy. Falls
// back to a plain title if the keyword isn't present.
const slide3TitleHtml = slide3Title.includes('vendemos ')
  ? slide3Title.replace('vendemos ', 'vendemos<br class="hidden mobile:inline" /> ')
  : slide3Title;
const items = extractHeadingPairs(ws?.fields?.bloque3seccion3textos, 'heading-3');
---
<section id="about-carousel" data-active-slide="0" class="relative w-full min-h-screen bg-vecta-bg overflow-hidden mobile:min-h-[125vh]">
  <!-- Slide indicator dots — clickable, centered along the left strip. Only
       navigation control for this carousel on desktop. Hidden on mobile, where
       slides auto-advance every 5s instead. -->
  <div class="absolute left-[60px] top-1/2 -translate-y-1/2 flex flex-col gap-[14px] z-50 mobile:hidden">
    {[0, 1, 2].map((i) => (
      <button data-about-dot={i} aria-label={`Ir al slide ${i + 1}`} type="button"
              class={`w-[14px] h-[14px] rounded-full border-2 border-vecta-dark cursor-pointer transition-all hover:scale-125 ${i === 0 ? 'bg-vecta-dark' : 'bg-transparent'}`}></button>
    ))}
  </div>

  <!-- ============================================================
       SLIDE 1 — Manifesto on lime card (formerly AboutUs.astro)
       ============================================================ -->
  <div data-about-slide="manifesto"
       class="absolute inset-0 transition-opacity duration-500 flex items-center justify-center opacity-100">
    <!-- Lime rounded card. Las fórmulas originales (width = 75vw+317.5px,
         right/top/bottom = (100vw-1270)/8) están derivadas matemáticamente
         para autocentrar el card horizontalmente en cualquier viewport
         (margen simétrico, crece con la pantalla). En móvil los offsets
         se vuelven negativos y el card overflowea la sección — el
         `overflow-hidden` del section lo recorta, dando un efecto
         edge-to-edge sin bordes asimétricos.
         REGLA: NO añadir min-w ni max() sobre estas fórmulas; rompen la simetría. -->
    <div class="absolute rounded-[10px] bg-vecta-lime top-[calc((100vw-1270px)/8)] bottom-[calc((100vw-1270px)/8)] right-[calc((100vw-1270px)/8)] w-[calc(75vw+317.5px)]
                mobile:top-0 mobile:bottom-[40%] mobile:left-0 mobile:right-0 mobile:w-auto mobile:rounded-none"></div>

    <!-- Right photo card — anchored to the lime card's right edge.
         Mismo offset right/top/bottom que el lime card (comparten esquina
         derecha). El ancho del photo card se reduce en pantallas pequeñas
         con clamp() para no dominar la sección. -->
    <div class="absolute w-[clamp(200px,43vw,551px)] rounded-r-[10px] overflow-hidden top-[calc((100vw-1270px)/8)] bottom-[calc((100vw-1270px)/8)] right-[calc((100vw-1270px)/8)]
                mobile:top-[47%] mobile:-bottom-[13%] mobile:left-0 mobile:right-0 mobile:w-full mobile:rounded-none">
      <img
        src={slide1ImgSrc}
        alt="Persona observando proyecto VECTA 98"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Mobile-only: texto posicionado en el centro del área lima (0–75vh).
         Usa absolute + top en vh para no depender del canvas centrado por flex. -->
    <div class="hidden mobile:block absolute top-0 left-0 right-0 h-[75vh] z-10">
      <h2 class="absolute left-0 right-0 top-[15vh] px-[8%] text-vecta-dark font-semibold font-display text-[8.5vw] leading-[1.1] text-center">{slide1Title}</h2>
      <div class="absolute left-[8%] right-[8%] top-[23vh] text-vecta-dark font-normal font-display text-[4vw] leading-[1.5] text-center
                  [&>p:first-child]:text-[6vw] [&>p:first-child]:font-semibold [&>p:first-child]:leading-[1.2]" set:html={slide1BodyHtml}></div>
    </div>

    <!-- Inner canvas: posiciones en % del canvas (1280×812 Figma) -->
    <div class="relative w-full max-w-[1280px] h-[812px] mx-auto">
      <h2 class="absolute left-[5.78%] top-[5.17%] w-[49.92%] text-vecta-dark font-semibold text-[clamp(40px,6.7vw,84px)] leading-[0.95853] font-display
                 narrow:text-[clamp(52px,9.5vw,120px)]
                 pc-small:!text-[clamp(28px,4.7vw,60px)]
                 mobile:hidden">{slide1Title}</h2>
      <div class="absolute left-[6.25%] top-[15.52%] w-[38.67%] h-px bg-vecta-dark mobile:hidden"></div>
      <div class="absolute left-[5.78%] top-[23.28%] w-[37.11%] text-vecta-dark font-normal text-[clamp(15px,1.9vw,24px)] leading-[0.95853] space-y-[1em] font-display
                  narrow:text-[clamp(20px,3vw,38px)] narrow:w-[43.75%]
                  [&>p:first-child]:text-[clamp(28px,4.7vw,60px)] [&>p:first-child]:font-semibold
                  narrow:[&>p:first-child]:text-[clamp(40px,7vw,90px)]
                  mobile:hidden" set:html={slide1BodyHtml}></div>
    </div>
  </div>

  <!-- ============================================================
       SLIDE 2 — 4 numbered cards on lime (formerly AboutCards.astro)
       ============================================================ -->
  <div data-about-slide="cards"
       class="absolute inset-0 transition-opacity duration-500 flex items-center justify-center opacity-0">
    <!-- Lime card con overflow-hidden + figuras geométricas anidadas.
         Mismas fórmulas que slide 1 (preserva la simetría auto-centrada).
         Las figuras hijas se dimensionan en % del lime card para escalar
         proporcionalmente en cualquier viewport. -->
    <div class="absolute left-1/2 -translate-x-1/2 bg-vecta-lime overflow-hidden top-[calc((100vw-1270px)/8)] bottom-[calc((100vw-1270px)/8)] w-[calc(75vw+317.5px)]">
      <!-- Figuras geométricas (Figma 2021:189 "Group 11"):
           - Rombo exterior (724.78/1270 = 57.07% del lime card)
           - Círculo + cuadrado interior (506.53/1270 = 39.88% del lime card)
           Las tres concéntricas, centro en (50%, 107%) del lime card,
           recortadas por el overflow-hidden. -->
      <div class="absolute pointer-events-none aspect-square w-[57%] left-1/2 top-[107%] mobile:top-[73%] -translate-x-1/2 -translate-y-1/2 border border-vecta-dark rotate-[-45deg]"></div>
      <div class="absolute pointer-events-none rounded-full aspect-square w-[40%] left-1/2 top-[107%] mobile:top-[73%] -translate-x-1/2 -translate-y-1/2 border border-vecta-dark"></div>
      <div class="absolute pointer-events-none aspect-square w-[40%] left-1/2 top-[107%] mobile:top-[73%] -translate-x-1/2 -translate-y-1/2 border border-vecta-dark"></div>
    </div>

    <div class="relative w-full max-w-[1280px] h-[832px] mx-auto mobile:absolute mobile:top-0 mobile:left-0 mobile:right-0 mobile:h-full mobile:flex mobile:items-center mobile:justify-center mobile:max-w-none">
      <div class="absolute left-[6.56%] top-[28.49%] flex gap-[10px] mobile:relative mobile:top-auto mobile:left-auto mobile:grid mobile:grid-cols-1 mobile:gap-[16px] mobile:w-[92%] mobile:mx-auto">
        {cards.map((c) => (
          <article class="relative w-[271px] h-[436px] rounded-[10px] bg-[#0a0a0a] text-white mobile:w-full mobile:h-[22vh]">
            <span class="absolute left-[24px] top-[11px] text-[clamp(48px,8.5vw,105px)] leading-none font-bold text-white font-display mobile:left-[6%] mobile:top-[3%] mobile:text-[9vw]">{c.number}</span>
            <div class="absolute right-[20px] top-[22px] w-[55px] h-[55px] rounded-full bg-white flex items-center justify-center mobile:right-[6%] mobile:top-[3%] mobile:w-[3.5vh] mobile:h-[3.5vh]">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 28" fill="none" class="w-[28px] h-[28px] mobile:w-[1.8vh] mobile:h-[1.8vh]">
                <path d="M10.4954 17.4921V20.9905C10.4954 22.9226 8.92908 24.4889 6.99696 24.4889C5.06483 24.4889 3.49854 22.9226 3.49854 20.9905C3.49854 19.0584 5.06483 17.4921 6.99696 17.4921H10.4954ZM10.4954 17.4921H17.4922M10.4954 17.4921V10.4953M17.4922 17.4921V20.9905C17.4922 22.9226 19.0585 24.4889 20.9906 24.4889C22.9228 24.4889 24.4891 22.9226 24.4891 20.9905C24.4891 19.0584 22.9228 17.4921 20.9906 17.4921H17.4922ZM17.4922 17.4921V10.4953M17.4922 10.4953H10.4954M17.4922 10.4953V6.99683C17.4922 5.06471 19.0585 3.49841 20.9906 3.49841C22.9228 3.49841 24.4891 5.06471 24.4891 6.99683C24.4891 8.92896 22.9228 10.4953 20.9906 10.4953H17.4922ZM10.4954 10.4953V6.99683C10.4954 5.06471 8.92908 3.49841 6.99696 3.49841C5.06483 3.49841 3.49854 5.06471 3.49854 6.99683C3.49854 8.92896 5.06483 10.4953 6.99696 10.4953H10.4954Z" stroke="#151515" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <!-- Title is bottom-anchored with a small gap above the line so 1-line
                 (Claridad, Ciudad activa) and 2-line (Arquitectura funcional,
                 Coherencia a largo plazo) titles all sit ~13px above the line
                 (≈ 3% of the 436px card height). -->
            <h3 class="absolute left-[24px] bottom-[127px] w-[217px] text-[clamp(20px,2.8vw,36px)] font-semibold leading-[0.95] font-display mobile:left-[6%] mobile:bottom-[32%] mobile:w-[88%] mobile:text-[3.8vw]">{c.title}</h3>
            <span class="absolute left-[24px] top-[322px] w-[126px] h-px bg-white mobile:left-[6%] mobile:top-[73%] mobile:w-[25%]"></span>
            <p class="absolute left-[24px] top-[343px] w-[218px] text-[clamp(13px,1.4vw,18px)] leading-[1.3] font-bold font-display mobile:left-[6%] mobile:top-[79%] mobile:w-[88%] mobile:text-[3.2vw]">{c.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>

  <!-- ============================================================
       SLIDE 3 — Amenidades grid on black (formerly AboutAmenidades.astro)
       ============================================================ -->
  <div data-about-slide="amenidades"
       class="absolute inset-0 transition-opacity duration-500 flex items-center justify-center opacity-0">
    <div class="absolute left-1/2 -translate-x-1/2 bg-[#0a0a0a] overflow-hidden top-[calc((100vw-1270px)/8)] bottom-[calc((100vw-1270px)/8)] w-[calc(75vw+317.5px)]">
      <!-- Círculo decorativo (arco en esquina superior-izquierda del card).
           Posición y tamaño en px del Figma original; el card es lo
           suficientemente ancho en cualquier breakpoint para mantener
           el arco visible en la esquina, y el overflow-hidden del card
           recorta el resto. -->
      <div class="absolute -left-[207px] -top-[157px] w-[620px] h-[620px] rounded-full border border-vecta-lime-text/40"></div>
    </div>

    <!-- Mobile-only: título + 5 ítems centrados vertical y horizontalmente.
         justify-center + gap-[15%] (~15% del alto del contenedor). -->
    <div class="hidden mobile:flex mobile:flex-col mobile:items-center mobile:justify-center mobile:gap-[13.5%] absolute inset-0 z-10 px-[7%] py-[6%] text-center">
      <h2 class="text-vecta-lime-text font-semibold font-display text-[6.5vw] leading-[1.05] w-full" set:html={slide3TitleHtml}></h2>
      {items.map((item) => (
        <div class="w-full">
          <h3 class="text-vecta-lime-text font-semibold font-display text-[3.3vw] leading-[0.959]">{item.title}</h3>
          <p class="mt-[1vh] text-white font-semibold font-display text-[2.8vw] leading-[1.35]">{item.description}</p>
        </div>
      ))}
    </div>

    <div class="relative w-full max-w-[1280px] h-[832px] mx-auto mobile:hidden">
      <h2 class="absolute left-[5.31%] top-[12.38%] w-[49.92%] text-vecta-lime-text font-semibold text-[clamp(28px,4.7vw,60px)] leading-[0.959] font-display" set:html={slide3TitleHtml}></h2>

      <!-- Wrapper for everything below the title — mobile shifts this whole
           block down 160px (≈20% of slide height) so the title up top has air. -->
      <div class="contents mobile:block">
      <!-- Cross-grid lines (1px solid #FFF) — hidden on mobile -->
      <div class="absolute left-[32.19%] top-[0.12%] w-px h-[97.96%] bg-white mobile:hidden"></div>
      <div class="absolute left-[66.48%] top-[0.12%] w-px h-[97.96%] bg-white mobile:hidden"></div>
      <div class="absolute left-[32.27%] top-[39.30%] w-[66.88%] h-px bg-white mobile:hidden"></div>
      <div class="absolute left-[32.27%] top-[65.87%] w-[66.88%] h-px bg-white mobile:hidden"></div>

      <!-- Dots at line intersections (white) — hidden on mobile -->
      <span class="absolute left-[31.72%] top-[38.58%] w-[12px] h-[12px] rounded-full bg-white mobile:hidden"></span>
      <span class="absolute left-[31.72%] top-[65.14%] w-[12px] h-[12px] rounded-full bg-white mobile:hidden"></span>
      <span class="absolute left-[66.02%] top-[38.58%] w-[12px] h-[12px] rounded-full bg-white mobile:hidden"></span>
      <span class="absolute left-[66.02%] top-[65.14%] w-[12px] h-[12px] rounded-full bg-white mobile:hidden"></span>

      <div class="absolute left-[70.94%] top-[10.94%] w-[21.88%] font-display
                  mobile:left-1/2 mobile:-translate-x-1/2 mobile:top-[11vh] mobile:w-[90%] mobile:max-w-[700px] mobile:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[clamp(16px,2.2vw,28px)] leading-[0.959] mobile:text-[3.3vw]">{items[0].title}</h3>
        <p class="mt-[28px] text-white text-[clamp(13px,1.4vw,18px)] leading-[1.35] font-semibold mobile:text-[2.8vw] mobile:mt-[1vh]">{items[0].description}</p>
      </div>
      <div class="absolute left-[39.22%] top-[42.55%] w-[20.31%] font-display
                  mobile:left-1/2 mobile:-translate-x-1/2 mobile:top-[25vh] mobile:w-[90%] mobile:max-w-[700px] mobile:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[clamp(16px,2.2vw,28px)] leading-[0.959] mobile:text-[3.3vw]">{items[1].title}</h3>
        <p class="mt-[28px] text-white text-[clamp(13px,1.4vw,18px)] leading-[1.35] font-semibold mobile:text-[2.8vw] mobile:mt-[1vh]">{items[1].description}</p>
      </div>
      <div class="absolute left-[70.94%] top-[42.55%] w-[20.31%] font-display
                  mobile:left-1/2 mobile:-translate-x-1/2 mobile:top-[38vh] mobile:w-[90%] mobile:max-w-[700px] mobile:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[clamp(16px,2.2vw,28px)] leading-[0.959] mobile:text-[3.3vw]">{items[2].title}</h3>
        <p class="mt-[28px] text-white text-[clamp(13px,1.4vw,18px)] leading-[1.35] font-semibold mobile:text-[2.8vw] mobile:mt-[1vh]">{items[2].description}</p>
      </div>
      <div class="absolute left-[5.31%] top-[71.88%] w-[23.44%] font-display
                  mobile:left-1/2 mobile:-translate-x-1/2 mobile:top-[51vh] mobile:w-[90%] mobile:max-w-[700px] mobile:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[clamp(16px,2.2vw,28px)] leading-[0.959] mobile:text-[3.3vw]">{items[3].title}</h3>
        <p class="mt-[28px] text-white text-[clamp(13px,1.4vw,18px)] leading-[1.35] font-semibold mobile:text-[2.8vw] mobile:mt-[1vh]">{items[3].description}</p>
      </div>
      <div class="absolute left-[39.22%] top-[71.88%] w-[20.31%] font-display
                  mobile:left-1/2 mobile:-translate-x-1/2 mobile:top-[64vh] mobile:w-[90%] mobile:max-w-[700px] mobile:text-center">
        <h3 class="text-vecta-lime-text font-semibold text-[clamp(16px,2.2vw,28px)] leading-[0.959] mobile:text-[3.3vw]">{items[4].title}</h3>
        <p class="mt-[28px] text-white text-[clamp(13px,1.4vw,18px)] leading-[1.35] font-semibold mobile:text-[2.8vw] mobile:mt-[1vh]">{items[4].description}</p>
      </div>

      <img
        src="/Logo%20Actual%20Corp.png"
        alt="actualcorp"
        class="absolute right-[6.25%] bottom-[10.82%] w-[154px] h-[154px] mobile:hidden"
      />
      </div>
    </div>
  </div>
</section>

<script>
  function initAboutCarousel() {
    const slides = document.querySelectorAll<HTMLElement>('[data-about-slide]');
    const dots = document.querySelectorAll<HTMLButtonElement>('[data-about-dot]');
    const total = slides.length;
    if (!total) return;
    let active = 0;

    // Slide 3 (amenidades) sits on a black card — dots flip to vecta-lime so
    // they remain visible against the dark background.
    const ACCENT_DEFAULT = '#22291D'; // vecta-dark — for slides 1 & 2 (lime cards)
    const ACCENT_DARK_SLIDE = '#EAFC9D'; // vecta-lime — for slide 3 (black card)

    const sectionEl = document.getElementById('about-carousel');

    function show(i: number) {
      active = (i + total) % total;
      const accent = active === 2 ? ACCENT_DARK_SLIDE : ACCENT_DEFAULT;

      slides.forEach((s, idx) => {
        s.style.opacity = idx === active ? '1' : '0';
        s.style.pointerEvents = idx === active ? 'auto' : 'none';
      });
      dots.forEach((d, idx) => {
        d.style.borderColor = accent;
        d.style.backgroundColor = idx === active ? accent : 'transparent';
      });
      // Mirror active slide on the section so the global nav theme handler
      // can react (slide 3 → lime nav over the dark amenidades card).
      if (sectionEl) sectionEl.dataset.activeSlide = String(active);
      document.dispatchEvent(new CustomEvent('about-slide-change'));
    }

    dots.forEach((d, idx) => {
      d.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        show(idx);
        // Manual selection on desktop also pauses auto-rotate (if running).
        pauseThenResume();
      });
    });

    // ----- Mobile auto-rotation -----
    // On true phones (data-device="phone", ≤768) the dots are hidden;
    // instead we cycle through slides every AUTO_MS. Runs continuously —
    // does NOT pause on touchstart/pointerdown of the section, because
    // those fire for plain scroll gestures (the section spans most of the
    // viewport) and would suppress the rotation indefinitely. Aligned with
    // the `mobile:` Tailwind variant so JS and CSS agree on what's mobile.
    const AUTO_MS = 5000;
    const RESUME_MS = 10000;
    const isMobile = document.documentElement.getAttribute('data-device') === 'phone';
    let autoTimer: number | null = null;
    let resumeTimer: number | null = null;

    function startAuto() {
      if (!isMobile) return;
      stopAuto();
      autoTimer = window.setInterval(() => show(active + 1), AUTO_MS);
    }
    function stopAuto() {
      if (autoTimer !== null) { clearInterval(autoTimer); autoTimer = null; }
      if (resumeTimer !== null) { clearTimeout(resumeTimer); resumeTimer = null; }
    }
    function pauseThenResume() {
      if (!isMobile) return;
      stopAuto();
      resumeTimer = window.setTimeout(startAuto, RESUME_MS);
    }

    // Apply initial styling consistently (slide 0, default accent).
    show(0);
    startAuto();
  }

  // Run after DOM ready (Astro deferred scripts run post-parse, but this
  // guards against any edge case where elements aren't yet queryable).
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutCarousel);
  } else {
    initAboutCarousel();
  }
</script>
