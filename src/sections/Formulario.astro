---
// Formulario - contact form on lime background.
// Mobile (touch / ≤1280) collapses the desktop split into a vertical stack:
// title → form → comment label/box → consent → submit. All text scales up.
---
<section class="relative w-full min-w-[1280px] min-h-screen overflow-hidden bg-vecta-lime flex items-center justify-center
                narrow:block narrow:h-auto narrow:min-h-[2050px]">
  <!-- Inner 1280px canvas keeps Figma absolute positions intact.
       Extra height accommodates the subtitle + the new Apellido field. -->
  <div class="relative w-[1280px] h-[940px] mx-auto narrow:h-[2050px]">
    <!-- Title -->
    <h2 class="absolute left-[168px] top-[148px] text-vecta-dark font-semibold text-[44px] leading-[0.959] font-display
               narrow:left-0 narrow:right-0 narrow:top-[80px] narrow:w-full narrow:text-center narrow:text-[80px]">
      Quiero saber más
    </h2>

    <p class="absolute left-[168px] top-[195px] text-vecta-dark text-[20px] leading-[1.2] font-display
              narrow:left-0 narrow:right-0 narrow:top-[170px] narrow:w-full narrow:text-center narrow:text-[32px]">
      Déjanos tus datos y nuestros asesores se<br />pondrán en contacto contigo.
    </p>

    <p class="absolute left-[706px] top-[260px] text-vecta-dark text-[24px] font-display
              narrow:left-1/2 narrow:top-[1380px] narrow:-translate-x-1/2 narrow:text-[44px] narrow:whitespace-nowrap">
      Deja tu comentario aquí:
    </p>

    <!-- Comment box (associated to the form via the form="contactForm" attribute
         so it submits even though it lives outside the <form> for layout) -->
    <textarea
      form="contactForm"
      name="comentario"
      maxlength="1000"
      class="absolute left-[706px] top-[310px] w-[392px] h-[335px] rounded-[10px] border-2 border-vecta-dark bg-transparent p-[14px] text-vecta-dark text-[18px] resize-none focus:outline-none focus:ring-2 focus:ring-vecta-dark/40 font-display
             narrow:left-1/2 narrow:top-[1450px] narrow:-translate-x-1/2 narrow:w-[1000px] narrow:h-[280px] narrow:text-[28px]"></textarea>

    <form
      id="contactForm"
      novalidate
      class="absolute left-[175px] top-[280px] w-[451px] font-display
             narrow:left-1/2 narrow:top-[290px] narrow:-translate-x-1/2 narrow:w-[1000px]">
      <label class="block text-vecta-dark text-[20px] font-semibold mb-[6px] narrow:text-[36px] narrow:mb-[12px]" for="form-nombre">Nombre:</label>
      <input
        id="form-nombre"
        name="nombre"
        type="text"
        required
        minlength="2"
        maxlength="80"
        autocomplete="given-name"
        class="w-full h-[47px] rounded-[10px] border-2 border-vecta-dark bg-transparent px-[14px] text-vecta-dark mb-[15px] focus:outline-none focus:ring-2 focus:ring-vecta-dark/40 form-input-validate
               narrow:h-[80px] narrow:text-[32px] narrow:mb-[24px]" />

      <label class="block text-vecta-dark text-[20px] font-semibold mb-[6px] narrow:text-[36px] narrow:mb-[12px]" for="form-apellido">Apellido:</label>
      <input
        id="form-apellido"
        name="apellido"
        type="text"
        required
        minlength="2"
        maxlength="80"
        autocomplete="family-name"
        class="w-full h-[47px] rounded-[10px] border-2 border-vecta-dark bg-transparent px-[14px] text-vecta-dark mb-[15px] focus:outline-none focus:ring-2 focus:ring-vecta-dark/40 form-input-validate
               narrow:h-[80px] narrow:text-[32px] narrow:mb-[24px]" />

      <label class="block text-vecta-dark text-[20px] font-semibold mb-[6px] narrow:text-[36px] narrow:mb-[12px]" for="form-celular">Celular:</label>
      <input
        id="form-celular"
        name="celular"
        type="tel"
        required
        pattern="[0-9+\s\-]{7,20}"
        inputmode="numeric"
        autocomplete="tel"
        class="w-full h-[47px] rounded-[10px] border-2 border-vecta-dark bg-transparent px-[14px] text-vecta-dark mb-[15px] focus:outline-none focus:ring-2 focus:ring-vecta-dark/40 form-input-validate
               narrow:h-[80px] narrow:text-[32px] narrow:mb-[24px]" />

      <label class="block text-vecta-dark text-[20px] font-semibold mb-[6px] narrow:text-[36px] narrow:mb-[12px]" for="form-correo">Correo:</label>
      <input
        id="form-correo"
        name="correo"
        type="email"
        required
        maxlength="120"
        autocomplete="email"
        class="w-full h-[47px] rounded-[10px] border-2 border-vecta-dark bg-transparent px-[14px] text-vecta-dark mb-[15px] focus:outline-none focus:ring-2 focus:ring-vecta-dark/40 form-input-validate
               narrow:h-[80px] narrow:text-[32px] narrow:mb-[24px]" />

      <p class="text-vecta-dark text-[20px] font-semibold mb-[8px] narrow:text-[36px] narrow:mb-[12px]">Este proyecto se acomoda a ti para:</p>
      <div class="flex items-center gap-[12px] mb-[14px] narrow:gap-[18px] narrow:mb-[22px]">
        <label class="flex items-center gap-[12px] cursor-pointer narrow:gap-[18px]">
          <span class="text-vecta-dark text-[20px] narrow:text-[32px]">Inversión:</span>
          <input
            type="radio"
            name="proposito"
            value="inversion"
            required
            class="appearance-none inline-block w-[22px] h-[23px] rounded-[5px] border-2 border-vecta-dark cursor-pointer checked:bg-vecta-dark transition-colors
                   narrow:w-[36px] narrow:h-[36px]" />
        </label>
        <label class="flex items-center gap-[12px] cursor-pointer ml-[44px] narrow:gap-[18px]">
          <span class="text-vecta-dark text-[20px] narrow:text-[32px]">Vivienda:</span>
          <input
            type="radio"
            name="proposito"
            value="vivienda"
            class="appearance-none inline-block w-[22px] h-[23px] rounded-[5px] border-2 border-vecta-dark cursor-pointer checked:bg-vecta-dark transition-colors
                   narrow:w-[36px] narrow:h-[36px]" />
        </label>
      </div>

      <p class="text-vecta-dark text-[20px] font-semibold mb-[8px] narrow:text-[36px] narrow:mb-[12px]">Quieres ser contactado telefónicamente:</p>
      <div class="flex items-center gap-[12px] mb-[14px] narrow:gap-[18px] narrow:mb-[22px]">
        <label class="flex items-center gap-[12px] cursor-pointer narrow:gap-[18px]">
          <span class="text-vecta-dark text-[20px] narrow:text-[32px]">Sí:</span>
          <input
            type="radio"
            name="contactoTelefonico"
            value="si"
            required
            class="appearance-none inline-block w-[22px] h-[23px] rounded-[5px] border-2 border-vecta-dark cursor-pointer checked:bg-vecta-dark transition-colors
                   narrow:w-[36px] narrow:h-[36px]" />
        </label>
        <label class="flex items-center gap-[12px] cursor-pointer ml-[44px] narrow:gap-[18px]">
          <span class="text-vecta-dark text-[20px] narrow:text-[32px]">No:</span>
          <input
            type="radio"
            name="contactoTelefonico"
            value="no"
            class="appearance-none inline-block w-[22px] h-[23px] rounded-[5px] border-2 border-vecta-dark cursor-pointer checked:bg-vecta-dark transition-colors
                   narrow:w-[36px] narrow:h-[36px]" />
        </label>
      </div>

      <label class="block text-vecta-dark text-[20px] font-semibold mb-[6px] narrow:text-[36px] narrow:mb-[12px]" for="form-origen">¿Por dónde te enteraste del proyecto?</label>
      <select
        id="form-origen"
        name="origenContacto"
        required
        class="w-full h-[47px] rounded-[10px] border-2 border-vecta-dark bg-transparent px-[14px] text-vecta-dark text-[16px] mb-[15px] focus:outline-none focus:ring-2 focus:ring-vecta-dark/40 form-input-validate font-display appearance-none cursor-pointer
               narrow:h-[80px] narrow:text-[28px] narrow:mb-[24px]"
        style="background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%2322291d%22 stroke-width=%222.5%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22><path d=%22M6 9l6 6 6-6%22/></svg>'); background-repeat: no-repeat; background-position: right 14px center; background-size: 18px 18px; padding-right: 40px;">
        <option value="" disabled selected hidden>Selecciona una opción</option>
        <option value="redes-sociales">Redes Sociales</option>
        <option value="referido">Referido</option>
        <option value="portales-vivienda">Portales de vivienda</option>
        <option value="correos-mensajes">Correos o mensajes de texto</option>
        <option value="donde-esta-bueno-invertir">Donde está bueno invertir</option>
      </select>

      <!-- Inline status / error region (visually anchored under the radios) -->
      <p data-form-status class="mt-[14px] text-[16px] leading-[1.2] hidden" aria-live="polite"></p>
    </form>

    <!-- Consent + checkbox (associated to the form via form="contactForm") -->
    <label class="absolute left-[706px] top-[660px] w-[395px] flex gap-[12px] cursor-pointer
                  narrow:left-1/2 narrow:top-[1760px] narrow:-translate-x-1/2 narrow:w-[1000px] narrow:gap-[18px]">
      <input
        type="checkbox"
        form="contactForm"
        name="consent"
        required
        class="mt-[3px] appearance-none inline-block w-[18px] h-[18px] rounded-[3px] border-2 border-vecta-dark shrink-0 cursor-pointer checked:bg-vecta-dark transition-colors
               narrow:mt-[4px] narrow:w-[28px] narrow:h-[28px]" />
      <p class="text-vecta-dark text-[14px] leading-[1.3] font-display narrow:text-[24px]">
        Autorizo a recibir información del proyecto a mi correo electrónico y autorizo el uso de mis datos según la política de tratamiento de datos personales.
      </p>
    </label>

    <!-- Submit button -->
    <button
      type="submit"
      form="contactForm"
      class="absolute left-[875px] top-[760px] w-[214px] h-[47px] rounded-[10px] bg-vecta-dark text-white text-[28px] font-semibold flex items-center justify-center hover:bg-vecta-dark/90 transition-colors disabled:opacity-50 font-display
             narrow:left-1/2 narrow:top-[1940px] narrow:-translate-x-1/2 narrow:w-[360px] narrow:h-[80px] narrow:text-[40px]">
      ENVIAR
    </button>
  </div>

  <script>
    // HubSpot Forms API — portal + form configured from the embed snippet
    // (portalId 19575552, formId 8db66949-101b-4205-8602-84d360d28bab,
    // region na1). We send a JSON submission to the v3 integration endpoint
    // and keep the custom Figma-derived UI instead of HubSpot's iframe.
    const HUBSPOT_PORTAL_ID = '19575552';
    const HUBSPOT_FORM_ID   = '8db66949-101b-4205-8602-84d360d28bab';
    const HUBSPOT_ENDPOINT  =
      `https://api.hsforms.com/submissions/v3/integration/submit/${HUBSPOT_PORTAL_ID}/${HUBSPOT_FORM_ID}`;

    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    const status = document.querySelector<HTMLParagraphElement>('[data-form-status]');

    function setStatus(message: string, kind: 'error' | 'success' | '' = '') {
      if (!status) return;
      status.textContent = message;
      status.classList.remove('hidden', 'text-red-700', 'text-green-700');
      if (!message) {
        status.classList.add('hidden');
        return;
      }
      status.classList.add(kind === 'error' ? 'text-red-700' : 'text-green-700');
    }

    function firstErrorMessage(formEl: HTMLFormElement): string | null {
      // Native HTML5 validity — return the first invalid field's message.
      for (const el of Array.from(formEl.elements) as HTMLInputElement[]) {
        if (!el.willValidate) continue;
        if (!el.checkValidity()) {
          el.focus();
          return el.validationMessage || 'Hay un campo inválido.';
        }
      }
      return null;
    }

    // Map the local field names → HubSpot contact property internal names.
    // Standard properties (firstname/lastname/phone/email/message) ship with
    // every HubSpot account. The custom ones (proposito / contacto_telefonico
    // / origen_contacto) must exist on the form in HubSpot with these exact
    // internal names, otherwise HubSpot rejects them as "Unknown field".
    function buildHubspotFields(data: Record<string, FormDataEntryValue>) {
      const map: Record<string, string> = {
        nombre: 'firstname',
        apellido: 'lastname',
        celular: 'phone',
        correo: 'email',
        comentario: 'message',
        proposito: 'proposito',
        contactoTelefonico: 'contacto_telefonico',
        origenContacto: 'origen_contacto',
      };
      return Object.entries(map)
        .map(([local, hsName]) => ({
          objectTypeId: '0-1',
          name: hsName,
          value: String(data[local] ?? '').trim(),
        }))
        .filter((f) => f.value.length > 0);
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form) return;

      const error = firstErrorMessage(form);
      if (error) {
        setStatus(error, 'error');
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries());
      setStatus('Enviando…', '');

      const consentText =
        'Autorizo a recibir información del proyecto a mi correo electrónico y autorizo el uso de mis datos según la política de tratamiento de datos personales.';

      const payload = {
        submittedAt: Date.now(),
        fields: buildHubspotFields(data),
        context: {
          pageUri: window.location.href,
          pageName: document.title,
        },
        legalConsentOptions: {
          consent: {
            consentToProcess: true,
            text: consentText,
            communications: [
              {
                value: true,
                subscriptionTypeId: 999,
                text: consentText,
              },
            ],
          },
        },
      };

      try {
        const res = await fetch(HUBSPOT_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          let detail = '';
          try {
            const body = await res.json();
            detail = body?.message || JSON.stringify(body);
          } catch {}
          console.error('HubSpot rechazó el envío:', res.status, detail);
          setStatus(
            'No pudimos enviar el formulario. Intenta de nuevo.',
            'error',
          );
          return;
        }

        setStatus('¡Gracias! Recibimos tu información.', 'success');
        form.reset();
        // Redirigir a la página de gracias para la confirmación final.
        window.location.href = '/gracias';
      } catch (err) {
        console.error('Error de red al enviar a HubSpot:', err);
        setStatus('No pudimos enviar el formulario. Intenta de nuevo.', 'error');
      }
    });

    // Clear the status as the user starts editing again.
    form?.addEventListener('input', () => setStatus(''));
  </script>
</section>
