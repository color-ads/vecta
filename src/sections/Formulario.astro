---
// Formulario - contact form on lime background.
// Mobile (touch / ≤1280) collapses the desktop split into a vertical stack:
// title → form → comment label/box → consent → submit. All text scales up.
---
<section id="formulario" class="relative w-full min-h-screen overflow-hidden bg-vecta-lime flex items-center justify-center
                max-md:block max-md:h-auto max-md:min-h-[2050px] sm:max-md:min-h-[1400px] max-sm:min-h-[1320px]">
  <!-- Inner canvas: tope 1280px en desktop, fluido por debajo. En max-md:
       (≤768) cambia a layout vertical apilado. Tablet (601-768 device=tablet)
       usa valores compactos en lugar de los enormes de narrow. -->
  <div class="relative w-full max-w-[1280px] h-[940px] mx-auto max-md:h-[2050px] sm:max-md:h-[1400px] max-sm:h-[1320px]">
    <!-- Title — canvas 1280×940 -->
    <h2 class="absolute left-[13.13%] top-[15.74%] text-vecta-dark font-semibold text-[clamp(24px,3.5vw,44px)] leading-[0.959] font-display
               max-md:left-0 max-md:right-0 max-md:top-[3.90%] max-md:w-full max-md:text-center max-md:text-[clamp(36px,6.5vw,80px)]
               sm:max-md:text-[36px] sm:max-md:top-[4.29%]
               max-sm:text-[28px]">
      Quiero saber más
    </h2>

    <p class="absolute left-[13.13%] top-[20.74%] text-vecta-dark text-[clamp(14px,1.6vw,20px)] leading-[1.2] font-display
              max-md:left-0 max-md:right-0 max-md:top-[8.29%] max-md:w-full max-md:text-center max-md:text-[clamp(18px,2.5vw,32px)]
              sm:max-md:text-[18px] sm:max-md:top-[9.29%]
              max-sm:text-[14px]">
      Déjanos tus datos y nuestros asesores se<br />pondrán en contacto contigo.
    </p>

    <p class="absolute left-[55.16%] top-[27.66%] text-vecta-dark text-[clamp(15px,1.9vw,24px)] font-display
              max-md:left-1/2 max-md:top-[67.32%] max-md:-translate-x-1/2 max-md:text-[clamp(24px,3.5vw,44px)] max-md:whitespace-nowrap
              sm:max-md:top-[64.29%] sm:max-md:text-[22px]
              max-sm:left-[24px] max-sm:top-[65.91%] max-sm:text-[14px] max-sm:whitespace-normal max-sm:font-semibold max-sm:translate-x-0">
      Deja tu comentario aquí:
    </p>

    <!-- Comment box (associated to the form via the form="contactForm" attribute
         so it submits even though it lives outside the <form> for layout) -->
    <textarea
      form="contactForm"
      name="comentario"
      maxlength="1000"
      class="absolute left-[55.16%] top-[32.98%] w-[30.63%] h-[35.64%] rounded-[10px] border-2 border-vecta-dark bg-transparent p-[14px] text-vecta-dark text-[clamp(13px,1.4vw,18px)] resize-none focus:outline-none focus:ring-2 focus:ring-vecta-dark/40 font-display
             max-md:left-1/2 max-md:top-[70.73%] max-md:-translate-x-1/2 max-md:w-[78.13%] max-md:h-[13.66%] max-md:text-[clamp(16px,2.2vw,28px)]
             sm:max-md:top-[67.86%] sm:max-md:w-[50%] sm:max-md:h-[12.86%] sm:max-md:text-[16px]
             max-sm:left-[24px] max-sm:top-[68.94%] max-sm:w-[calc(100vw-48px)] max-sm:h-[13.64%] max-sm:text-[2.8vw] max-sm:translate-x-0"></textarea>

    <form
      id="contactForm"
      novalidate
      class="absolute left-[13.67%] top-[29.79%] w-[35.23%] font-display
             max-md:left-1/2 max-md:top-[14.15%] max-md:-translate-x-1/2 max-md:w-[78.13%]
             sm:max-md:top-[15%] sm:max-md:w-[50%]
             max-sm:w-[calc(100vw-48px)]">
      <label class="block text-vecta-dark text-[clamp(14px,1.6vw,20px)] font-semibold mb-[6px] max-md:text-[clamp(20px,2.8vw,36px)] max-md:mb-[12px] sm:max-md:text-[18px] sm:max-md:mb-[8px] max-sm:text-[14px] max-sm:mb-[5px]" for="form-nombre">Nombre:</label>
      <input
        id="form-nombre"
        name="nombre"
        type="text"
        required
        minlength="2"
        maxlength="80"
        autocomplete="given-name"
        class="w-full h-[47px] rounded-[10px] border-2 border-vecta-dark bg-transparent px-[14px] text-vecta-dark mb-[15px] focus:outline-none focus:ring-2 focus:ring-vecta-dark/40 form-input-validate
               max-md:h-[80px] max-md:text-[clamp(18px,2.5vw,32px)] max-md:mb-[24px] sm:max-md:h-[52px] sm:max-md:text-[16px] sm:max-md:mb-[16px]
               max-sm:h-[46px] max-sm:text-[15px] max-sm:mb-[12px]" />

      <label class="block text-vecta-dark text-[clamp(14px,1.6vw,20px)] font-semibold mb-[6px] max-md:text-[clamp(20px,2.8vw,36px)] max-md:mb-[12px] sm:max-md:text-[18px] sm:max-md:mb-[8px] max-sm:text-[14px] max-sm:mb-[5px]" for="form-apellido">Apellido:</label>
      <input
        id="form-apellido"
        name="apellido"
        type="text"
        required
        minlength="2"
        maxlength="80"
        autocomplete="family-name"
        class="w-full h-[47px] rounded-[10px] border-2 border-vecta-dark bg-transparent px-[14px] text-vecta-dark mb-[15px] focus:outline-none focus:ring-2 focus:ring-vecta-dark/40 form-input-validate
               max-md:h-[80px] max-md:text-[clamp(18px,2.5vw,32px)] max-md:mb-[24px] sm:max-md:h-[52px] sm:max-md:text-[16px] sm:max-md:mb-[16px]
               max-sm:h-[46px] max-sm:text-[15px] max-sm:mb-[12px]" />

      <label class="block text-vecta-dark text-[clamp(14px,1.6vw,20px)] font-semibold mb-[6px] max-md:text-[clamp(20px,2.8vw,36px)] max-md:mb-[12px] sm:max-md:text-[18px] sm:max-md:mb-[8px] max-sm:text-[14px] max-sm:mb-[5px]" for="form-celular">Celular:</label>
      <input
        id="form-celular"
        name="celular"
        type="tel"
        required
        pattern="[0-9+\s\-]{7,20}"
        inputmode="numeric"
        autocomplete="tel"
        class="w-full h-[47px] rounded-[10px] border-2 border-vecta-dark bg-transparent px-[14px] text-vecta-dark mb-[15px] focus:outline-none focus:ring-2 focus:ring-vecta-dark/40 form-input-validate
               max-md:h-[80px] max-md:text-[clamp(18px,2.5vw,32px)] max-md:mb-[24px] sm:max-md:h-[52px] sm:max-md:text-[16px] sm:max-md:mb-[16px]
               max-sm:h-[46px] max-sm:text-[15px] max-sm:mb-[12px]" />

      <label class="block text-vecta-dark text-[clamp(14px,1.6vw,20px)] font-semibold mb-[6px] max-md:text-[clamp(20px,2.8vw,36px)] max-md:mb-[12px] sm:max-md:text-[18px] sm:max-md:mb-[8px] max-sm:text-[14px] max-sm:mb-[5px]" for="form-correo">Correo:</label>
      <input
        id="form-correo"
        name="correo"
        type="email"
        required
        maxlength="120"
        autocomplete="email"
        class="w-full h-[47px] rounded-[10px] border-2 border-vecta-dark bg-transparent px-[14px] text-vecta-dark mb-[15px] focus:outline-none focus:ring-2 focus:ring-vecta-dark/40 form-input-validate
               max-md:h-[80px] max-md:text-[clamp(18px,2.5vw,32px)] max-md:mb-[24px] sm:max-md:h-[52px] sm:max-md:text-[16px] sm:max-md:mb-[16px]
               max-sm:h-[46px] max-sm:text-[15px] max-sm:mb-[12px]" />

      <p class="text-vecta-dark text-[clamp(14px,1.6vw,20px)] font-semibold mb-[8px] max-md:text-[clamp(20px,2.8vw,36px)] max-md:mb-[12px] sm:max-md:text-[18px] sm:max-md:mb-[8px] max-sm:text-[14px] max-sm:mb-[6px]">Este proyecto se acomoda a ti para:</p>
      <div class="flex items-center gap-[12px] mb-[14px] max-md:gap-[18px] max-md:mb-[22px] sm:max-md:gap-[14px] sm:max-md:mb-[16px] max-sm:gap-[10px] max-sm:mb-[12px]">
        <label class="flex items-center gap-[12px] cursor-pointer max-md:gap-[18px] sm:max-md:gap-[14px] max-sm:gap-[8px]">
          <span class="text-vecta-dark text-[clamp(14px,1.6vw,20px)] max-md:text-[clamp(18px,2.5vw,32px)] sm:max-md:text-[16px] max-sm:text-[14px]">Inversión:</span>
          <input
            type="radio"
            name="proposito"
            value="inversion"
            required
            class="appearance-none inline-block w-[22px] h-[23px] rounded-[5px] border-2 border-vecta-dark cursor-pointer checked:bg-vecta-dark transition-colors
                   max-md:w-[44px] max-md:h-[44px] sm:max-md:w-[26px] sm:max-md:h-[26px] max-sm:w-[20px] max-sm:h-[20px]" />
        </label>
        <label class="flex items-center gap-[12px] cursor-pointer ml-[44px] max-md:gap-[18px] sm:max-md:gap-[14px] max-sm:gap-[8px] max-sm:ml-[16px]">
          <span class="text-vecta-dark text-[clamp(14px,1.6vw,20px)] max-md:text-[clamp(18px,2.5vw,32px)] sm:max-md:text-[16px] max-sm:text-[14px]">Vivienda:</span>
          <input
            type="radio"
            name="proposito"
            value="vivienda"
            class="appearance-none inline-block w-[22px] h-[23px] rounded-[5px] border-2 border-vecta-dark cursor-pointer checked:bg-vecta-dark transition-colors
                   max-md:w-[44px] max-md:h-[44px] sm:max-md:w-[26px] sm:max-md:h-[26px] max-sm:w-[20px] max-sm:h-[20px]" />
        </label>
      </div>

      <p class="text-vecta-dark text-[clamp(14px,1.6vw,20px)] font-semibold mb-[8px] max-md:text-[clamp(20px,2.8vw,36px)] max-md:mb-[12px] sm:max-md:text-[18px] sm:max-md:mb-[8px] max-sm:text-[14px] max-sm:mb-[6px]">Quieres ser contactado telefónicamente:</p>
      <div class="flex items-center gap-[12px] mb-[14px] max-md:gap-[18px] max-md:mb-[22px] sm:max-md:gap-[14px] sm:max-md:mb-[16px] max-sm:gap-[10px] max-sm:mb-[12px]">
        <label class="flex items-center gap-[12px] cursor-pointer max-md:gap-[18px] sm:max-md:gap-[14px] max-sm:gap-[8px]">
          <span class="text-vecta-dark text-[clamp(14px,1.6vw,20px)] max-md:text-[clamp(18px,2.5vw,32px)] sm:max-md:text-[16px] max-sm:text-[14px]">Sí:</span>
          <input
            type="radio"
            name="contactoTelefonico"
            value="si"
            required
            class="appearance-none inline-block w-[22px] h-[23px] rounded-[5px] border-2 border-vecta-dark cursor-pointer checked:bg-vecta-dark transition-colors
                   max-md:w-[44px] max-md:h-[44px] sm:max-md:w-[26px] sm:max-md:h-[26px] max-sm:w-[20px] max-sm:h-[20px]" />
        </label>
        <label class="flex items-center gap-[12px] cursor-pointer ml-[44px] max-md:gap-[18px] sm:max-md:gap-[14px] max-sm:gap-[8px] max-sm:ml-[16px]">
          <span class="text-vecta-dark text-[clamp(14px,1.6vw,20px)] max-md:text-[clamp(18px,2.5vw,32px)] sm:max-md:text-[16px] max-sm:text-[14px]">No:</span>
          <input
            type="radio"
            name="contactoTelefonico"
            value="no"
            class="appearance-none inline-block w-[22px] h-[23px] rounded-[5px] border-2 border-vecta-dark cursor-pointer checked:bg-vecta-dark transition-colors
                   max-md:w-[44px] max-md:h-[44px] sm:max-md:w-[26px] sm:max-md:h-[26px] max-sm:w-[20px] max-sm:h-[20px]" />
        </label>
      </div>

      <label class="block text-vecta-dark text-[clamp(14px,1.6vw,20px)] font-semibold mb-[6px] max-md:text-[clamp(20px,2.8vw,36px)] max-md:mb-[12px] sm:max-md:text-[18px] sm:max-md:mb-[8px] max-sm:text-[14px] max-sm:mb-[5px]" for="form-origen">¿Por dónde te enteraste del proyecto?</label>
      <select
        id="form-origen"
        name="origenContacto"
        required
        class="w-full h-[47px] rounded-[10px] border-2 border-vecta-dark bg-transparent px-[14px] text-vecta-dark text-[14px] mb-[15px] focus:outline-none focus:ring-2 focus:ring-vecta-dark/40 form-input-validate font-display appearance-none cursor-pointer
               max-md:h-[80px] max-md:text-[clamp(16px,1.9vw,22px)] max-md:mb-[24px]
               sm:max-md:h-[52px] sm:max-md:text-[16px] sm:max-md:mb-[16px]
               max-sm:h-[46px] max-sm:text-[15px] max-sm:mb-[12px]"
        style="background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%2322291d%22 stroke-width=%222.5%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22><path d=%22M6 9l6 6 6-6%22/></svg>'); background-repeat: no-repeat; background-position: right 14px center; background-size: 18px 18px; padding-right: 40px;">
        <option class="text-[14px] min-[2000px]:text-[12px] min-[2400px]:text-[11px] min-[3000px]:text-[9px] min-[3500px]:text-[8px]" value="" disabled selected hidden>Selecciona una opción</option>
        <option class="text-[14px] min-[2000px]:text-[12px] min-[2400px]:text-[11px] min-[3000px]:text-[9px] min-[3500px]:text-[8px]" value="redes-sociales">Redes Sociales</option>
        <option class="text-[14px] min-[2000px]:text-[12px] min-[2400px]:text-[11px] min-[3000px]:text-[9px] min-[3500px]:text-[8px]" value="referido">Referido</option>
        <option class="text-[14px] min-[2000px]:text-[12px] min-[2400px]:text-[11px] min-[3000px]:text-[9px] min-[3500px]:text-[8px]" value="portales-vivienda">Portales de vivienda</option>
        <option class="text-[14px] min-[2000px]:text-[12px] min-[2400px]:text-[11px] min-[3000px]:text-[9px] min-[3500px]:text-[8px]" value="correos-mensajes">Correos o mensajes de texto</option>
        <option class="text-[14px] min-[2000px]:text-[12px] min-[2400px]:text-[11px] min-[3000px]:text-[9px] min-[3500px]:text-[8px]" value="donde-esta-bueno-invertir">Donde está bueno invertir</option>
      </select>

      <!-- Inline status / error region (visually anchored under the radios) -->
      <p data-form-status class="mt-[14px] text-[16px] leading-[1.2] hidden" aria-live="polite"></p>
    </form>

    <!-- Consent + checkbox (associated to the form via form="contactForm") -->
    <label class="absolute left-[55.16%] top-[70.21%] w-[30.86%] flex gap-[12px] cursor-pointer
                  max-md:left-1/2 max-md:top-[85.85%] max-md:-translate-x-1/2 max-md:w-[78.13%] max-md:gap-[18px]
                  sm:max-md:top-[84.29%] sm:max-md:w-[50%] sm:max-md:gap-[14px]
                  max-sm:top-[84.85%] max-sm:w-[calc(100vw-48px)] max-sm:gap-[10px]">
      <input
        type="checkbox"
        form="contactForm"
        name="consent"
        required
        class="mt-[3px] appearance-none inline-block w-[18px] h-[18px] rounded-[3px] border-2 border-vecta-dark shrink-0 cursor-pointer checked:bg-vecta-dark transition-colors
               max-md:mt-[4px] max-md:w-[44px] max-md:h-[44px]
               sm:max-md:mt-[3px] sm:max-md:w-[22px] sm:max-md:h-[22px]
               max-sm:w-[18px] max-sm:h-[18px] max-sm:mt-[2px]" />
      <p class="text-vecta-dark text-[14px] leading-[1.3] font-display max-md:text-[clamp(15px,1.9vw,24px)] sm:max-md:text-[14px] max-sm:text-[13px]">
        Autorizo a recibir información del proyecto a mi correo electrónico y autorizo el uso de mis datos según la política de tratamiento de datos personales.
      </p>
    </label>

    <!-- Submit button.
         PC: anclado abajo-derecha (Figma).
         Mobile+tablet (≤768): centrado, ancho cómodo capado a 360px, alto táctil 56px. -->
    <button
      type="submit"
      form="contactForm"
      class="absolute left-[68.36%] top-[80.85%] w-[16.72%] h-[47px] rounded-[10px] bg-vecta-dark text-white text-[clamp(16px,2.2vw,28px)] font-semibold flex items-center justify-center hover:bg-vecta-dark/90 transition-colors disabled:opacity-50 font-display
             max-md:left-1/2 max-md:-translate-x-1/2 max-md:top-[93%] max-md:w-[min(70%,360px)] max-md:h-[56px] max-md:text-[clamp(16px,4vw,22px)]">
      ENVIAR
    </button>
  </div>

  <script>
    // HubSpot Forms API — portal + form configured from the embed snippet
    // (portalId 19575552, formId 8db66949-101b-4205-8602-84d360d28bab,
    // region na1). We send a JSON submission to the v3 integration endpoint
    // and keep the custom Figma-derived UI instead of HubSpot's iframe.
    const HUBSPOT_PORTAL_ID = '19575552';
    const HUBSPOT_FORM_ID   = '8db66949-101b-4205-8602-84d360d28bab';
    const HUBSPOT_ENDPOINT  =
      `https://api.hsforms.com/submissions/v3/integration/submit/${HUBSPOT_PORTAL_ID}/${HUBSPOT_FORM_ID}`;

    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    const status = document.querySelector<HTMLParagraphElement>('[data-form-status]');

    function setStatus(message: string, kind: 'error' | 'success' | '' = '') {
      if (!status) return;
      status.textContent = message;
      status.classList.remove('hidden', 'text-red-700', 'text-green-700');
      if (!message) {
        status.classList.add('hidden');
        return;
      }
      status.classList.add(kind === 'error' ? 'text-red-700' : 'text-green-700');
    }

    function firstErrorMessage(formEl: HTMLFormElement): string | null {
      // Native HTML5 validity — return the first invalid field's message.
      for (const el of Array.from(formEl.elements) as HTMLInputElement[]) {
        if (!el.willValidate) continue;
        if (!el.checkValidity()) {
          el.focus();
          return el.validationMessage || 'Hay un campo inválido.';
        }
      }
      return null;
    }

    // Map the local field names → HubSpot contact property internal names.
    // Standard properties (firstname/lastname/phone/email/message) ship with
    // every HubSpot account. The custom ones (proposito / contacto_telefonico
    // / origen_contacto) must exist on the form in HubSpot with these exact
    // internal names, otherwise HubSpot rejects them as "Unknown field".
    function buildHubspotFields(data: Record<string, FormDataEntryValue>) {
      const map: Record<string, string> = {
        nombre: 'firstname',
        apellido: 'lastname',
        celular: 'phone',
        correo: 'email',
        comentario: 'message',
        proposito: 'proposito',
        contactoTelefonico: 'contacto_telefonico',
        origenContacto: 'origen_contacto',
      };
      return Object.entries(map)
        .map(([local, hsName]) => ({
          objectTypeId: '0-1',
          name: hsName,
          value: String(data[local] ?? '').trim(),
        }))
        .filter((f) => f.value.length > 0);
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form) return;

      const error = firstErrorMessage(form);
      if (error) {
        setStatus(error, 'error');
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries());
      setStatus('Enviando…', '');

      const consentText =
        'Autorizo a recibir información del proyecto a mi correo electrónico y autorizo el uso de mis datos según la política de tratamiento de datos personales.';

      const payload = {
        submittedAt: Date.now(),
        fields: buildHubspotFields(data),
        context: {
          pageUri: window.location.href,
          pageName: document.title,
        },
        legalConsentOptions: {
          consent: {
            consentToProcess: true,
            text: consentText,
            communications: [
              {
                value: true,
                subscriptionTypeId: 999,
                text: consentText,
              },
            ],
          },
        },
      };

      try {
        const res = await fetch(HUBSPOT_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          let detail = '';
          try {
            const body = await res.json();
            detail = body?.message || JSON.stringify(body);
          } catch {}
          console.error('HubSpot rechazó el envío:', res.status, detail);
          setStatus(
            'No pudimos enviar el formulario. Intenta de nuevo.',
            'error',
          );
          return;
        }

        setStatus('¡Gracias! Recibimos tu información.', 'success');
        form.reset();
        // Redirigir a la página de gracias para la confirmación final.
        window.location.href = '/gracias';
      } catch (err) {
        console.error('Error de red al enviar a HubSpot:', err);
        setStatus('No pudimos enviar el formulario. Intenta de nuevo.', 'error');
      }
    });

    // Clear the status as the user starts editing again.
    form?.addEventListener('input', () => setStatus(''));
  </script>
</section>
