---
// Preguntas — FAQ accordion (Figma 2076:366) with two-phase animation:
//   Open : 1) items below shift down (300ms) → 2) answer + line fade in (200ms)
//   Close: 1) answer + line fade out (200ms) → 2) items shift back up (300ms)
// Only one item open at a time.
//
// Contenido: viene del content type `preguntas` de Contentful. Cada entry
// tiene los campos `pregunta` y `respuesta` (string plano o rich text).
// El layout reserva 5 slots verticales fijos, así que limitamos la query a
// 5; si Contentful devuelve menos, se renderiza la cantidad disponible.
import { getContentfulClient } from '../lib/contentful';
import { richTextToPlain } from '../lib/richtext';

const client = getContentfulClient();
const preguntasRes = await client.getEntries({
  content_type: 'preguntas',
  order: ['sys.createdAt'],
  limit: 5,
});

function coercePlain(value: any): string {
  if (typeof value === 'string') return value.trim();
  if (value && typeof value === 'object') return richTextToPlain(value).trim();
  return '';
}

const cmsItems = preguntasRes.items
  .map((it: any) => ({
    q: coercePlain(it.fields?.pregunta),
    a: coercePlain(it.fields?.respuesta),
  }))
  .filter((it) => it.q.length > 0);

// Fallback estático sólo si Contentful no devolvió ninguna pregunta —
// evita renderizar la sección vacía.
const fallback = [
  { q: "¿Cuál es el precio del proyecto?", a: "Cercanía a zonas corporativas, vías principales y servicios clave." },
  { q: "¿Qué áreas tienen?",               a: "Cinco tipologías disponibles, desde 18 m² hasta 40 m² según la configuración." },
  { q: "¿Dónde está ubicado?",             a: "Carrera 15 con calle 98, Bogotá — una zona con flujo constante y conectividad real." },
  { q: "¿Qué incluye el proyecto?",        a: "Apartamentos terminados con amenidades funcionales: gimnasio, coworking, lounge, restaurante y lobby." },
  { q: "¿Cómo es el proceso de compra?",   a: "Reserva con un asesor, cuota inicial del 10% y financiación con tu banco aliado." },
];

const items = cmsItems.length > 0 ? cmsItems : fallback;
// Espaciado fijo de 73px entre rows (mismo que la versión hardcoded original);
// el script reemplaza estos valores en mobile.
const CLOSED_TOPS = items.map((_, i) => 313 + i * 73);

// Para la ÚLTIMA pregunta en mobile: parte la pregunta en 2 trozos para
// renderizar la segunda mitad en un <span class="mobile:block"> — `block`
// fuerza un salto de línea real (a diferencia de <br> con display tricks
// que browsers manejan de forma inconsistente). En desktop el span sigue
// inline → el texto queda en 1 sola línea. Intenta partir antes de
// "servicios"; si no aparece, hace fallback a partir a mitad de palabras.
function splitForMobile(q: string): { first: string; second: string } {
  // Parte en el midpoint de palabras para un split balanceado.
  // Para "¿El proyecto contará con operador de servicio?" (7 palabras, mid=4):
  //   first  = "¿El proyecto contará con"
  //   second = "operador de servicio?"
  const words = q.trim().split(/\s+/);
  if (words.length < 3) return { first: q, second: '' };
  const mid = Math.ceil(words.length / 2);
  return {
    first: words.slice(0, mid).join(' '),
    second: words.slice(mid).join(' ')
  };
}
const lastIdx = items.length - 1;
const lastQuestionParts = splitForMobile(items[lastIdx].q);
---
<section class="relative w-full min-h-screen overflow-hidden bg-vecta-night tablet:min-h-[95vh] mobile:block mobile:overflow-visible mobile:h-auto mobile:min-h-[100vh] mobile:pb-20">
  <div class="relative w-full max-w-[1280px] h-[832px] mx-auto mobile:h-auto mobile:pb-24">
    <!-- Title — canvas 1280×832, posiciones en %.
         Mobile: baja a 18% para no quedar pegado arriba (FAQ items
         arrancan ~30% en mobile vía JS). -->
    <h2 class="absolute text-vecta-lime font-semibold text-[clamp(28px,4.7vw,60px)] 
    leading-[0.959] font-display left-[5.31%] top-[12.38%] w-[49.92%]
               mobile:top-[50%] mobile:text-[clamp(22px,5.5vw,30px)] 
               mobile:left-0 mobile:right-0 mobile:w-full mobile:text-center">
      Algunas preguntas<br/>frecuentes
    </h2>

    <!-- Decorative large lime ring (hidden on mobile). Conserva calc() porque
         ancla el centro respecto al 50% del canvas + offset Figma. -->
    <div class="absolute rounded-full border border-vecta-lime/40 pointer-events-none w-[620.185px] h-[620.185px]
                left-[calc(50%+151.09px-310.0925px)] top-[calc(50%+455.09px-310.0925px)] mobile:hidden"></div>

    <!-- Cross-grid (1px solid #FFF) — hidden on mobile -->
    <div class="absolute w-px bg-white pointer-events-none left-[59.30%] top-[-3.13%] h-[97.96%] mobile:hidden"></div>
    <div class="absolute h-px bg-white pointer-events-none left-[-13.98%] top-[33.53%] w-[119.38%] mobile:hidden"></div>
    <div class="absolute h-px bg-white pointer-events-none left-[59.30%] top-[60.10%] w-[43.98%] mobile:hidden"></div>

    <!-- Dots — hidden on mobile (tamaño se conserva en px: UI control) -->
    <span class="absolute rounded-full bg-white pointer-events-none left-[58.75%] top-[32.81%] w-[13px] h-[12px] mobile:hidden"></span>
    <span class="absolute rounded-full bg-white pointer-events-none left-[58.75%] top-[59.38%] w-[13px] h-[12px] mobile:hidden"></span>

    <!-- Building fascade — repositions on mobile to occupy the bottom half.
         Section is 100vh tall on mobile (10vh taller than before) so the
         fachada gets the extra room to show the full building.
         Tablet: bajamos el top para cerrar el hueco que queda abajo cuando
         la sección min-h-screen es más alta que el canvas 832 (≈1024px en
         tablet portrait → 112px vacíos al fondo). -->
    <div class="absolute pointer-events-none left-[47.19%] top-[-19.64%] w-[64.77%] h-[124.64%]
                tablet:top-[-2%]
                mobile:left-0 mobile:right-0 mobile:top-[38vh] mobile:w-full mobile:h-[62vh]">
      <picture>
        <source srcset="/sections/preguntas/fachada.webp" type="image/webp" />
        <img src="/sections/preguntas/fachada.jpg" alt="Fachada VECTA 98"
             class="w-full h-full object-cover max-w-full" loading="lazy" decoding="async" />
      </picture>
    </div>

    <!-- Carets — clickable, rotate when open. transition: top 300ms for the
         layout shift; transform 300ms for the chevron rotation. -->
    {items.map((item, idx) => (
      <button class="absolute w-[36px] h-[36px] rounded-full border-2 border-vecta-lime text-vecta-lime flex items-center justify-center cursor-pointer hover:bg-vecta-lime/10 z-10 left-[2.5%] [transition:top_0.3s_ease,background-color_0.2s_ease]"
              data-faq-caret={idx}
              style={`top: ${CLOSED_TOPS[idx] + 2}px;`}
              aria-label={`Toggle: ${item.q}`}
              aria-expanded="false"
              type="button">
        <svg viewBox="0 0 24 24" class="w-[14px] h-[14px] [transition:transform_0.3s_ease]" fill="none" stroke="currentColor" stroke-width="2.5"
             data-faq-icon={idx}>
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
    ))}

    <!-- Question texts. Inline style only carries the JS-managed `top` value.
         Static dimensions/typography live as Tailwind classes so the mobile
         variant can override them. -->
    {items.map((item, idx) => {
      const isLast = idx === lastIdx;
      // Width/wrap diferente para la última pregunta:
      //  - Última: w-auto (ancho según contenido) → garantiza que cada mitad
      //    quepa en una línea SIN depender del CSS viewport (importante a
      //    320px donde calc(100vw-228px)=92px sería demasiado angosto y
      //    haría wrap natural a 4+ líneas).
      //  - Resto: ancho fijo basado en viewport + nowrap (1 línea forzada).
      const widthAndWrap = isLast
        ? 'mobile:!w-auto'
        : 'mobile:!w-[calc(100vw-228px)] mobile:!whitespace-nowrap';
      const classes = `absolute text-vecta-lime font-semibold leading-[1.09] font-display left-[6.33%] w-[46.88%] text-[clamp(18px,2.5vw,32px)] tracking-[-0.352px] [transition:top_0.3s_ease]
                mobile:!left-[16.33%] mobile:!text-[clamp(14px,4vw,17px)] ${widthAndWrap}`;
      // Última pregunta: la segunda mitad va en un <span class="mobile:!block">
      // que en mobile se vuelve display:block → salto de línea garantizado.
      // En desktop el span sigue inline → toda la pregunta en una línea.
      return isLast && lastQuestionParts.second ? (
        <p class={classes} data-faq-question={idx} style={`top: ${CLOSED_TOPS[idx]}px;`}>
          {lastQuestionParts.first}{' '}<span class="mobile:!block">{lastQuestionParts.second}</span>
        </p>
      ) : (
        <p class={classes} data-faq-question={idx} style={`top: ${CLOSED_TOPS[idx]}px;`}>{item.q}</p>
      );
    })}

    <!-- Answer panels — opacity 0 by default, transitions on opacity (fade) and
         on top (follow layout shift). pointer-events: none always (decorative).
         Offset 80px from the question top: deja margen para preguntas que
         wrappean a 2 líneas (línea 2 termina en ~70px) sin pisar la respuesta. -->
    {items.map((item, idx) => (
      <p class="absolute text-white font-semibold leading-[1.09] pointer-events-none font-display left-[6.33%] w-[47.03%] text-[clamp(14px,1.6vw,20px)] tracking-[-0.22px] opacity-0 [transition:opacity_0.2s_ease,top_0.3s_ease]
                mobile:!left-[4%] mobile:!right-[4%] mobile:!w-auto mobile:!text-[clamp(12px,3.5vw,15px)] mobile:!leading-[1.3]"
         data-faq-answer={idx}
         style={`top: ${CLOSED_TOPS[idx] + 80}px;`}>
        {item.a}
      </p>
    ))}

    <!-- Per-item separator lines -->
    {items.map((item, idx) => (
      <div class="absolute h-px bg-white pointer-events-none left-[-3.83%] w-[38.67%] opacity-0 [transition:opacity_0.2s_ease,top_0.3s_ease]
                  mobile:left-[16px] mobile:w-[calc(100vw-32px)]"
           data-faq-line={idx}
           style={`top: ${CLOSED_TOPS[idx] + 126}px;`}></div>
    ))}
  </div>
</section>

<script>
  // Total real de preguntas renderizadas (≤5). Se lee del DOM para no
  // depender de un literal hardcoded — Contentful manda la cantidad.
  const total = document.querySelectorAll('[data-faq-caret]').length;
  // Mobile (true phone, screen ≤768) uses larger spacing because the
  // question/answer fonts are bumped up — keeps an open answer from
  // overlapping the next row. Aligned with the `mobile:` Tailwind variant
  // (html[data-device="phone"]) so JS positions match CSS layout.
  const isMobile = document.documentElement.getAttribute('data-device') === 'phone';
  const ROW_SPACING = isMobile ? 62 : 73;
  const CLOSED_TOPS = Array.from({ length: total }, (_, i) => (isMobile ? 210 : 313) + i * ROW_SPACING);
  // CARET_OFFSET ya no se usa como fallback fijo — caretOffsetFor(i)
  // calcula dinámicamente el offset por item leyendo el font-size real,
  // así el botón siempre queda centrado verticalmente con la primera
  // línea de la pregunta en cualquier viewport (mobile/tablet/pc-small/desktop).
  const CARET_BTN_HEIGHT = 36;
  const ANSWER_GAP            = isMobile ? 8 : 8;
  const LINE_GAP_BELOW_ANSWER = isMobile ? 8 : 16;
  const BUFFER_BELOW_LINE     = isMobile ? 12 : 22;
  const LINE_OFFSET           = isMobile ? 110 : 126;
  const FADE_MS = 200;
  const SHIFT_MS = 300;

  let openIdx = -1;
  let inTransition = false;

  const sleep = (ms: number) => new Promise<void>(r => setTimeout(r, ms));

  // Mide la altura real renderizada del párrafo de respuesta i en el DOM.
  // Las respuestas viven con opacity:0 pero SÍ están laid out, así que
  // offsetHeight refleja su altura natural — incluyendo wrapping para
  // textos largos como los que vienen de Contentful.
  function answerHeight(i: number): number {
    const a = document.querySelector<HTMLElement>(`[data-faq-answer="${i}"]`);
    return a ? a.offsetHeight : 0;
  }

  // Igual que answerHeight, pero para la pregunta — permite calcular el
  // offset real entre el top de la pregunta y el top de la respuesta sin
  // depender de un valor constante que asume cuántas líneas tiene cada una.
  function questionHeight(i: number): number {
    const q = document.querySelector<HTMLElement>(`[data-faq-question="${i}"]`);
    return q ? q.offsetHeight : 0;
  }

  function answerOffset(i: number): number {
    return questionHeight(i) + ANSWER_GAP;
  }

  // Centra verticalmente el botón circular con la PRIMERA LÍNEA del texto
  // de la pregunta. Lee el font-size renderizado + leading-[1.09] del CSS,
  // así funciona automáticamente en cualquier viewport (mobile/tablet/
  // pc-small/desktop) sin depender de constantes hardcoded por breakpoint.
  function caretOffsetFor(i: number): number {
    const q = document.querySelector<HTMLElement>(`[data-faq-question="${i}"]`);
    if (!q) return 0;
    const fontSize = parseFloat(window.getComputedStyle(q).fontSize);
    const lineHeight = fontSize * 1.09;  // matches Tailwind leading-[1.09]
    return (lineHeight / 2) - (CARET_BTN_HEIGHT / 2);
  }

  // Cuánto deben bajar los items i > openIdx para no pisar la respuesta:
  //   shift = answerOffset + altura_real_respuesta + gap_línea + buffer − ROW_SPACING
  // (El ROW_SPACING ya separa los items por defecto; sólo agregamos lo extra.)
  function dynamicShift(forIdx: number): number {
    return answerOffset(forIdx) + answerHeight(forIdx) + LINE_GAP_BELOW_ANSWER + BUFFER_BELOW_LINE - ROW_SPACING;
  }

  function applyPositions() {
    for (let i = 0; i < total; i++) {
      const shift = (openIdx >= 0 && openIdx < i) ? dynamicShift(openIdx) : 0;
      const top = CLOSED_TOPS[i] + shift;
      const caret = document.querySelector<HTMLElement>(`[data-faq-caret="${i}"]`);
      const question = document.querySelector<HTMLElement>(`[data-faq-question="${i}"]`);
      const answer = document.querySelector<HTMLElement>(`[data-faq-answer="${i}"]`);
      const line = document.querySelector<HTMLElement>(`[data-faq-line="${i}"]`);
      if (caret) caret.style.top = `${top + caretOffsetFor(i)}px`;
      if (question) question.style.top = `${top}px`;
      if (answer) answer.style.top = `${top + answerOffset(i)}px`;
      if (line) {
        // Para el item abierto la línea baja para sentarse debajo del texto
        // real; para los cerrados queda en su slot original (opacity:0, no
        // se ve, pero su `top` no es relevante visualmente).
        const lineTop = (i === openIdx)
          ? top + answerOffset(i) + answerHeight(i) + LINE_GAP_BELOW_ANSWER
          : top + LINE_OFFSET;
        line.style.top = `${lineTop}px`;
      }
    }
  }

  function setItemFade(idx: number, visible: boolean) {
    const answer = document.querySelector<HTMLElement>(`[data-faq-answer="${idx}"]`);
    const line = document.querySelector<HTMLElement>(`[data-faq-line="${idx}"]`);
    const icon = document.querySelector<HTMLElement>(`[data-faq-icon="${idx}"]`);
    const caret = document.querySelector<HTMLElement>(`[data-faq-caret="${idx}"]`);
    if (answer) answer.style.opacity = visible ? '1' : '0';
    if (line) line.style.opacity = visible ? '1' : '0';
    if (icon) icon.style.transform = visible ? 'rotate(180deg)' : 'rotate(0deg)';
    if (caret) caret.setAttribute('aria-expanded', String(visible));
  }

  async function setOpen(newIdx: number) {
    if (inTransition) return;
    inTransition = true;

    const oldIdx = openIdx;
    const target = newIdx === oldIdx ? -1 : newIdx;

    // PHASE 1 — close: fade out the currently open item first
    if (oldIdx >= 0) {
      setItemFade(oldIdx, false);
      await sleep(FADE_MS);
    }

    // PHASE 2 — shift: update layout positions (animates over SHIFT_MS)
    openIdx = target;
    applyPositions();

    // PHASE 3 — open: wait for layout to settle, then fade in the new item
    if (target >= 0) {
      await sleep(SHIFT_MS);
      setItemFade(target, true);
    } else {
      // Closing only — wait for the shift-up to finish before unlocking
      await sleep(SHIFT_MS);
    }

    inTransition = false;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-faq-caret]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.dataset.faqCaret || '0', 10);
      setOpen(idx);
    });
  });

  // Initial pass — overrides the SSR'd inline tops so the mobile layout uses
  // the bigger row spacing computed above.
  applyPositions();
</script>
