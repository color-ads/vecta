---
// Preguntas — FAQ accordion (Figma 2076:366) with two-phase animation:
//   Open : 1) items below shift down (300ms) → 2) answer + line fade in (200ms)
//   Close: 1) answer + line fade out (200ms) → 2) items shift back up (300ms)
// Only one item open at a time.
const items = [
  { q: "¿Cuál es el precio del proyecto?", a: "Cercanía a zonas corporativas, vías principales y servicios clave." },
  { q: "¿Qué áreas tienen?",               a: "Cinco tipologías disponibles, desde 18 m² hasta 40 m² según la configuración." },
  { q: "¿Dónde está ubicado?",             a: "Carrera 15 con calle 98, Bogotá — una zona con flujo constante y conectividad real." },
  { q: "¿Qué incluye el proyecto?",        a: "Apartamentos terminados con amenidades funcionales: gimnasio, coworking, lounge, restaurante y lobby." },
  { q: "¿Cómo es el proceso de compra?",   a: "Reserva con un asesor, cuota inicial del 10% y financiación con tu banco aliado." },
];
const CLOSED_TOPS = [313, 386, 459, 532, 605];
---
<section class="relative w-full min-w-[1280px] min-h-screen overflow-hidden bg-vecta-night mobile:block mobile:h-[90vh] mobile:min-h-[90vh]">
  <div class="relative w-[1280px] h-[832px] mx-auto mobile:h-[90vh]">
    <!-- Title -->
    <h2 class="absolute text-vecta-lime font-semibold text-[60px] leading-[0.959] font-display left-[68px] top-[103px] w-[639px]
               mobile:text-[80px] mobile:left-0 mobile:right-0 mobile:w-full mobile:text-center">
      Algunas preguntas<br/>frecuentes
    </h2>

    <!-- Decorative large lime ring (hidden on mobile) -->
    <div class="absolute rounded-full border border-vecta-lime/40 pointer-events-none w-[620.185px] h-[620.185px]
                left-[calc(50%+151.09px-310.0925px)] top-[calc(50%+455.09px-310.0925px)] mobile:hidden"></div>

    <!-- Cross-grid (1px solid #FFF) — hidden on mobile -->
    <div class="absolute w-px bg-white pointer-events-none left-[759px] top-[-26px] h-[815px] mobile:hidden"></div>
    <div class="absolute h-px bg-white pointer-events-none left-[-179px] top-[279px] w-[1528px] mobile:hidden"></div>
    <div class="absolute h-px bg-white pointer-events-none left-[759px] top-[500px] w-[563px] mobile:hidden"></div>

    <!-- Dots — hidden on mobile -->
    <span class="absolute rounded-full bg-white pointer-events-none left-[752px] top-[273px] w-[13px] h-[12px] mobile:hidden"></span>
    <span class="absolute rounded-full bg-white pointer-events-none left-[752px] top-[494px] w-[13px] h-[12px] mobile:hidden"></span>

    <!-- Building fascade — repositions on mobile to occupy the bottom half. -->
    <div class="absolute pointer-events-none left-[604px] top-[-125px] w-[829px] h-[1037px]
                mobile:left-0 mobile:top-[40vh] mobile:w-[1280px] mobile:h-[50vh]">
      <img src="/sections/preguntas/fachada.png" alt="Fachada VECTA 98"
           class="w-full h-full object-cover" />
    </div>

    <!-- Carets — clickable, rotate when open. transition: top 300ms for the
         layout shift; transform 300ms for the chevron rotation. -->
    {items.map((item, idx) => (
      <button class="absolute w-[36px] h-[36px] rounded-full border-2 border-vecta-lime text-vecta-lime flex items-center justify-center cursor-pointer hover:bg-vecta-lime/10 z-10 left-[32px] [transition:top_0.3s_ease,background-color_0.2s_ease]"
              data-faq-caret={idx}
              style={`top: ${CLOSED_TOPS[idx] + 2}px;`}
              aria-label={`Toggle: ${item.q}`}
              aria-expanded="false"
              type="button">
        <svg viewBox="0 0 24 24" class="w-[14px] h-[14px] [transition:transform_0.3s_ease]" fill="none" stroke="currentColor" stroke-width="2.5"
             data-faq-icon={idx}>
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
    ))}

    <!-- Question texts. Inline style only carries the JS-managed `top` value.
         Static dimensions/typography live as Tailwind classes so the mobile
         variant can override them. -->
    {items.map((item, idx) => (
      <p class="absolute text-vecta-lime font-semibold leading-[1.09] font-display left-[81px] w-[600px] text-[32px] tracking-[-0.352px] [transition:top_0.3s_ease]
                mobile:!text-[56px] mobile:!w-[1100px]"
         data-faq-question={idx}
         style={`top: ${CLOSED_TOPS[idx]}px;`}>
        {item.q}
      </p>
    ))}

    <!-- Answer panels — opacity 0 by default, transitions on opacity (fade) and
         on top (follow layout shift). pointer-events: none always (decorative). -->
    {items.map((item, idx) => (
      <p class="absolute text-white font-semibold leading-[1.09] pointer-events-none font-display left-[81px] w-[602px] text-[20px] tracking-[-0.22px] opacity-0 [transition:opacity_0.2s_ease,top_0.3s_ease]
                mobile:!text-[40px] mobile:!w-[1100px]"
         data-faq-answer={idx}
         style={`top: ${CLOSED_TOPS[idx] + 51}px;`}>
        {item.a}
      </p>
    ))}

    <!-- Per-item separator lines -->
    {items.map((item, idx) => (
      <div class="absolute h-px bg-white pointer-events-none left-[-49px] w-[495px] opacity-0 [transition:opacity_0.2s_ease,top_0.3s_ease]"
           data-faq-line={idx}
           style={`top: ${CLOSED_TOPS[idx] + 96}px;`}></div>
    ))}
  </div>
</section>

<script>
  const total = 5;
  // Mobile (touch / ≤1280) uses larger spacing because the question/answer
  // fonts are bumped up — keeps an open answer from overlapping the next row.
  const isMobile = matchMedia('(pointer: coarse), (hover: none), (max-width: 1280px)').matches;
  const CLOSED_TOPS = isMobile
    ? [313, 423, 533, 643, 753]
    : [313, 386, 459, 532, 605];
  const OPEN_SHIFT     = isMobile ? 180 : 46;
  const CARET_OFFSET   = isMobile ? 8   : 2;
  const ANSWER_OFFSET  = isMobile ? 130 : 51;
  const LINE_OFFSET    = isMobile ? 260 : 96;
  const FADE_MS = 200;
  const SHIFT_MS = 300;

  let openIdx = -1;
  let inTransition = false;

  const sleep = (ms: number) => new Promise<void>(r => setTimeout(r, ms));

  function applyPositions() {
    for (let i = 0; i < total; i++) {
      const top = CLOSED_TOPS[i] + (openIdx >= 0 && openIdx < i ? OPEN_SHIFT : 0);
      const caret = document.querySelector<HTMLElement>(`[data-faq-caret="${i}"]`);
      const question = document.querySelector<HTMLElement>(`[data-faq-question="${i}"]`);
      const answer = document.querySelector<HTMLElement>(`[data-faq-answer="${i}"]`);
      const line = document.querySelector<HTMLElement>(`[data-faq-line="${i}"]`);
      if (caret) caret.style.top = `${top + CARET_OFFSET}px`;
      if (question) question.style.top = `${top}px`;
      if (answer) answer.style.top = `${top + ANSWER_OFFSET}px`;
      if (line) line.style.top = `${top + LINE_OFFSET}px`;
    }
  }

  function setItemFade(idx: number, visible: boolean) {
    const answer = document.querySelector<HTMLElement>(`[data-faq-answer="${idx}"]`);
    const line = document.querySelector<HTMLElement>(`[data-faq-line="${idx}"]`);
    const icon = document.querySelector<HTMLElement>(`[data-faq-icon="${idx}"]`);
    const caret = document.querySelector<HTMLElement>(`[data-faq-caret="${idx}"]`);
    if (answer) answer.style.opacity = visible ? '1' : '0';
    if (line) line.style.opacity = visible ? '1' : '0';
    if (icon) icon.style.transform = visible ? 'rotate(180deg)' : 'rotate(0deg)';
    if (caret) caret.setAttribute('aria-expanded', String(visible));
  }

  async function setOpen(newIdx: number) {
    if (inTransition) return;
    inTransition = true;

    const oldIdx = openIdx;
    const target = newIdx === oldIdx ? -1 : newIdx;

    // PHASE 1 — close: fade out the currently open item first
    if (oldIdx >= 0) {
      setItemFade(oldIdx, false);
      await sleep(FADE_MS);
    }

    // PHASE 2 — shift: update layout positions (animates over SHIFT_MS)
    openIdx = target;
    applyPositions();

    // PHASE 3 — open: wait for layout to settle, then fade in the new item
    if (target >= 0) {
      await sleep(SHIFT_MS);
      setItemFade(target, true);
    } else {
      // Closing only — wait for the shift-up to finish before unlocking
      await sleep(SHIFT_MS);
    }

    inTransition = false;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-faq-caret]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.dataset.faqCaret || '0', 10);
      setOpen(idx);
    });
  });

  // Initial pass — overrides the SSR'd inline tops so the mobile layout uses
  // the bigger row spacing computed above.
  applyPositions();
</script>
