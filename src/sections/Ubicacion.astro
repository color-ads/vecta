---
// Ubicación — lime card on left half, map iframe on right half (Figma).
// Copy comes from Contentful `webSite.bloque5texto` as a sequence of
// paragraphs we map by index to the existing visual slots:
//   [0] heading       (72px h2)
//   [1] subtitle      (38px)
//   [2] (intentionally empty separator paragraph)
//   [3] description 1 (38px)
//   [4] description 2 (38px)
//
// `webSite.bloque5googleMapsDireccion` is intended for the Maps query
// string; if empty in Contentful we fall back to the original hardcoded
// address so the iframe still loads.
//
// Breakpoints (driven by `max-sm:` Tailwind variant = data-device="phone"):
//   phone (≤600)    — vertical: lime 50vh top, map 90vh bottom.
//   tablet (601-768) — uses base PC layout (split-screen) automatically
//                      since `max-sm:` doesn't fire here. Hamburger nav.
//   pc-small (1024) — base PC layout. PC nav.
//   desktop (≥1025) — base PC layout. PC nav.
import { getWebsite } from '../lib/contentful';
import { richTextParagraphs, richTextToPlain } from '../lib/richtext';

const ws = await getWebsite();
const paragraphs = richTextParagraphs(ws?.fields?.bloque5texto);
const heading = (paragraphs[0] ?? '').trim();
const subtitle = (paragraphs[1] ?? '').trim();
const description1 = (paragraphs[3] ?? '').trim();
const description2Raw = (paragraphs[4] ?? '').trim();
// Contentful stores the visual line break between sentences as U+2028
// (LINE SEPARATOR). Render it as <br/> to match the original layout.
// The `futura. ` regular-space fallback covers entries that were authored
// with a plain space instead.
const description2 = description2Raw
  .split("\u2028").join("<br/>")
  .replace('futura. ', 'futura.<br/>');

// `bloque5googleMapsDireccion` puede venir como:
//   - Rich text con coordenadas dentro (p.ej. "4.6832, -74.0486")
//   - String plano (mismo contenido)
//   - Dirección textual ("Carrera 15 # 98, Bogotá")
// Resolver a string sin importar el tipo de campo, y si parece coordenadas
// (LAT,LNG con espacio opcional) las normalizamos a "LAT,LNG" sin espacio
// para que Google Maps embed las interprete como punto, no como búsqueda.
const directionRaw = ws?.fields?.bloque5googleMapsDireccion;
const directionPlain = (typeof directionRaw === 'string'
  ? directionRaw
  : richTextToPlain(directionRaw)
).trim();

const COORD_RE = /^\s*(-?\d{1,3}(?:\.\d+)?)\s*,\s*(-?\d{1,3}(?:\.\d+)?)\s*$/;
const coordMatch = directionPlain.match(COORD_RE);
const mapQuery = coordMatch
  ? `${coordMatch[1]},${coordMatch[2]}`            // "lat,lng" normalizado
  : directionPlain || 'Carrera 15 # 98, Bogotá, Colombia';
const ADDRESS = encodeURIComponent(mapQuery);
const initialMapSrc = `https://www.google.com/maps?q=${ADDRESS}&z=16&hl=es&output=embed`;
---
<section id="ubicacion" class="relative w-full min-h-screen overflow-hidden bg-vecta-night flex
                max-md:flex-col max-md:min-h-[140vh] max-md:h-[140vh]">

  <!-- LIME PANEL — texto (izquierda PC / arriba mobile-tablet) -->
  <div class="relative bg-vecta-lime w-[calc(50vw-1px)] min-h-screen flex flex-col justify-center gap-[3vh] px-[8%] text-center lg:text-left
              max-md:w-full max-md:min-h-0 max-md:h-[50vh] max-md:gap-[2vh]
              min-[2400px]:w-[30vw]">

    <h2 class="text-vecta-dark font-semibold 
              leading-[0.959] 
              text-[6vw]
              md:text-[4vw]
              lg:text-[4.5vw]">{heading}</h2>

    <p class="text-vecta-dark leading-[0.959] 
              text-[4.5vw]
              md:text-[2.1vw]
              lg:text-[2.2vw]">{subtitle}</p>

    <div class="text-vecta-dark leading-[0.959] 
                text-[4vw] space-y-[1.2em]
                md:text-[2.1vw]
                lg:text-[2.2vw]">
      <p>{description1}</p>
      <p set:html={description2}></p>
    </div>

  </div>

  <!-- MAP PANEL — derecha PC / abajo mobile-tablet -->
  <div class="relative overflow-hidden w-[calc(50vw+1px)] min-h-screen
              max-md:w-full max-md:min-h-0 max-md:h-[90vh]
              min-[2400px]:w-[70vw]">
    <iframe
      src={initialMapSrc}
      data-address={ADDRESS}
      title="Mapa de ubicación Carrera 15 con calle 98"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="block w-full h-full border-0 origin-center will-change-[transform,opacity]"
    ></iframe>

    <!-- Pin overlay sobre marker rojo de Google Maps. Es absolute por
         requerimiento estructural: debe superponerse sobre el iframe
         cross-origin (no se puede capturar el click del marker directamente). -->
    <button
      id="ubicacion-map-pin"
      type="button"
      aria-label="Acercar mapa"
      data-zoomed="false"
      class="pointer-events-auto absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[50px] h-[50px] cursor-pointer bg-transparent border-0 outline-none"
    ></button>
  </div>

</section>

<script>
  const pin = document.getElementById('ubicacion-map-pin');
  const iframe = document.querySelector<HTMLIFrameElement>(
    'iframe[title="Mapa de ubicación Carrera 15 con calle 98"]'
  );
  // Read the encoded address the iframe was rendered with (set from
  // Contentful at build time) so zoom navigation hits the same place.
  const ADDRESS = iframe?.dataset.address ?? 'Carrera+15+%23+98,+Bogot%C3%A1,+Colombia';
  // Each Google Maps zoom step doubles the scale. Phone viewports show the
  // map at the bottom 90vh, so we boot in at street level (z=19, ~4× closer
  // than the desktop default z=16). Al hacer click sobre el marker rojo
  // bajamos a z=21 (máximo, nivel edificio) tanto en desktop como mobile
  // para que quede bien cerca.
  const isPhone = document.documentElement.getAttribute('data-device') === 'phone';
  const ZOOM_OUT = isPhone ? 19 : 16;
  const ZOOM_IN = 21;

  if (isPhone && iframe) {
    iframe.src = `https://www.google.com/maps?q=${ADDRESS}&z=${ZOOM_OUT}&hl=es&output=embed`;
  }

  // Animación más larga = transición más suave hacia el zoom cercano.
  const ZOOM_DURATION = 1000;

  pin?.addEventListener('click', () => {
    if (!iframe || pin.dataset.animating === 'true') return;
    pin.dataset.animating = 'true';

    const zoomed = pin.dataset.zoomed === 'true';
    const nextZoom = zoomed ? ZOOM_OUT : ZOOM_IN;
    // Scale más grande = sensación de zoom más profundo durante la animación
    // antes de que recargue el iframe en el nuevo nivel de Google Maps.
    const targetScale = zoomed ? 0.6 : 1.8;

    // Anchor the visual zoom on the pin so it feels like the map is moving
    // toward (or away from) the marker, not just rescaling from the center.
    const iframeRect = iframe.getBoundingClientRect();
    const pinRect = pin.getBoundingClientRect();
    const originX = ((pinRect.left + pinRect.width / 2) - iframeRect.left) / iframeRect.width * 100;
    const originY = ((pinRect.top + pinRect.height / 2) - iframeRect.top) / iframeRect.height * 100;

    iframe.style.transformOrigin = `${originX}% ${originY}%`;
    iframe.style.transition = `transform ${ZOOM_DURATION}ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease`;
    iframe.style.transform = `scale(${targetScale})`;

    pin.dataset.zoomed = String(!zoomed);
    pin.setAttribute('aria-label', !zoomed ? 'Alejar mapa' : 'Acercar mapa');

    setTimeout(() => {
      // Brief fade hides the moment we swap the iframe src to the new zoom
      // level (the embed reload is otherwise a hard cut).
      iframe.style.opacity = '0';
      const onLoad = () => {
        iframe.style.transition = 'opacity 250ms ease';
        iframe.style.transform = 'scale(1)';
        iframe.style.opacity = '1';
        pin.dataset.animating = 'false';
        iframe.removeEventListener('load', onLoad);
      };
      iframe.addEventListener('load', onLoad);
      iframe.src = `https://www.google.com/maps?q=${ADDRESS}&z=${nextZoom}&hl=es&output=embed`;
    }, ZOOM_DURATION);
  });
</script>
