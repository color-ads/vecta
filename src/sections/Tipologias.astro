      <div class="absolute top-[-163.00%] right-[-56.07%] bottom-[-163.46%] left-[-87.68%]">
        <img src="/sections/tipologias/vector-39.svg" alt="" class="block max-w-none w-full h-full" loading="lazy" decoding="async" />
      </div>
    </div>

    <!-- Typology callouts -->
    <!-- Tipología 1 - top left -->
    <div class="absolute left-[57px] top-[400px] text-white font-display">
      <p class="text-[32px] leading-[0.959] mobile:text-[44px]">Tipología {t1.tipo}</p>
      <p class="mt-[8px] text-[64px] font-medium leading-[0.959] mobile:text-[88px]">{t1.areaTotal}</p>
      <svg class="absolute left-[114px] top-[105px]" xmlns="http://www.w3.org/2000/svg" width="30" height="107" viewBox="0 0 30 107" fill="none">
        <path d="M16.1421 0.585786C15.3611 -0.195262 14.0947 -0.195262 13.3137 0.585786L0.58577 13.3137C-0.195279 14.0948 -0.195279 15.3611 0.58577 16.1421C1.36682 16.9232 2.63315 16.9232 3.4142 16.1421L14.7279 4.82843L26.0416 16.1421C26.8227 16.9232 28.089 16.9232 28.87 16.1421C29.6511 15.3611 29.6511 14.0948 28.87 13.3137L16.1421 0.585786ZM14.7279 107H16.7279V2H14.7279H12.7279V107H14.7279Z" fill="white"/>
      </svg>
    </div>

    <!-- Tipología 2 - top right -->
    <div class="absolute left-[846px] top-[601px] text-white font-display">
      <p class="text-[32px] leading-[0.959] mobile:text-[44px]">Tipología {t2.tipo}</p>
      <p class="mt-[8px] text-[64px] font-medium leading-[0.959] mobile:text-[88px]">{t2.areaTotal}</p>
      <svg class="absolute left-[103px] top-[105px]" xmlns="http://www.w3.org/2000/svg" width="30" height="107" viewBox="0 0 30 107" fill="none">
        <path d="M16.1421 0.585786C15.3611 -0.195262 14.0947 -0.195262 13.3137 0.585786L0.58577 13.3137C-0.195279 14.0948 -0.195279 15.3611 0.58577 16.1421C1.36682 16.9232 2.63315 16.9232 3.4142 16.1421L14.7279 4.82843L26.0416 16.1421C26.8227 16.9232 28.089 16.9232 28.87 16.1421C29.6511 15.3611 29.6511 14.0948 28.87 13.3137L16.1421 0.585786ZM14.7279 107H16.7279V2H14.7279H12.7279V107H14.7279Z" fill="white"/>
      </svg>
    </div>

    <!-- Tipología 4 - mid right. Net offset from original top:1000 is
         -5% +3% -1% = -3% / -62px → top:938. The arrow stays at its
         original canvas position (parent.top + arrow.top = 1100px), so
         its inner top is bumped from 100 → 162 to compensate. -->
    <div class="absolute left-[1070px] top-[938px] text-center text-white font-display">
      <p class="text-[30px] leading-[0.959] mobile:text-[44px]">Tipología {t4.tipo}</p>
      <p class="mt-[8px] text-[60px] font-medium leading-[0.959] mobile:text-[88px]">{t4.areaTotal}</p>
      <svg class="absolute left-[69px] top-[162px]" xmlns="http://www.w3.org/2000/svg" width="30" height="107" viewBox="0 0 30 107" fill="none">
        <path d="M16.1421 0.585786C15.3611 -0.195262 14.0947 -0.195262 13.3137 0.585786L0.58577 13.3137C-0.195279 14.0948 -0.195279 15.3611 0.58577 16.1421C1.36682 16.9232 2.63315 16.9232 3.4142 16.1421L14.7279 4.82843L26.0416 16.1421C26.8227 16.9232 28.089 16.9232 28.87 16.1421C29.6511 15.3611 29.6511 14.0948 28.87 13.3137L16.1421 0.585786ZM14.7279 107H16.7279V2H14.7279H12.7279V107H14.7279Z" fill="white"/>
      </svg>
    </div>

    <!-- Tipología 3 - bottom left -->
    <div class="absolute left-[202px] top-[1509px] text-white font-display">
      <p class="text-[32px] leading-[0.959] mobile:text-[44px]">Tipología {t3.tipo}</p>
      <p class="mt-[8px] text-[64px] font-medium leading-[0.959] mobile:text-[88px]">{t3.areaTotal}</p>
      <svg class="absolute left-[104px] top-[-75px]" xmlns="http://www.w3.org/2000/svg" width="30" height="71" viewBox="0 0 30 71" fill="none">
        <path d="M13.3138 70.4142C14.0949 71.1953 15.3612 71.1953 16.1422 70.4142L28.8702 57.6863C29.6512 56.9052 29.6512 55.6389 28.8702 54.8579C28.0891 54.0768 26.8228 54.0768 26.0417 54.8579L14.728 66.1716L3.41432 54.8579C2.63327 54.0768 1.36694 54.0768 0.585892 54.8579C-0.195157 55.6389 -0.195157 56.9052 0.585892 57.6863L13.3138 70.4142ZM16.728 2V0H12.728V2H14.728H16.728ZM14.728 69H16.728V2H14.728H12.728V69H14.728Z" fill="white"/>
      </svg>
    </div>

    <!-- Tipología 5 - bottom right -->
    <div class="absolute left-[953px] top-[1738px] text-white font-display">
      <p class="text-[32px] leading-[0.959] mobile:text-[44px]">Tipología {t5.tipo}</p>
      <p class="mt-[8px] text-[64px] font-medium leading-[0.959] mobile:text-[88px]">{t5.areaTotal}</p>
      <svg class="absolute left-[104px] top-[-75px]" xmlns="http://www.w3.org/2000/svg" width="30" height="71" viewBox="0 0 30 71" fill="none">
        <path d="M13.3138 70.4142C14.0949 71.1953 15.3612 71.1953 16.1422 70.4142L28.8702 57.6863C29.6512 56.9052 29.6512 55.6389 28.8702 54.8579C28.0891 54.0768 26.8228 54.0768 26.0417 54.8579L14.728 66.1716L3.41432 54.8579C2.63327 54.0768 1.36694 54.0768 0.585892 54.8579C-0.195157 55.6389 -0.195157 56.9052 0.585892 57.6863L13.3138 70.4142ZM16.728 2V0H12.728V2H14.728H16.728ZM14.728 69H16.728V2H14.728H12.728V69H14.728Z" fill="white"/>
      </svg>
    </div>
  </div>

  <!-- Mobile-only: horizontal auto-advancing carousel. Each of the 5 slides
       holds BOTH views for one tipología (render on top, floor plan below)
       so a single carousel step shows the full page for that tipología. -->
  <div data-tipologia-carousel-mobile class="hidden mobile:block relative z-10 overflow-hidden w-[1280px] mx-auto">
    <div data-tipologia-track class="flex will-change-transform [transition:transform_700ms_cubic-bezier(0.65,0,0.35,1)]">
      {tipologias.map((t) => (
        <div class="w-[1280px] flex-shrink-0">
          <TipologiaAbierta2
            tipo={t.tipo}
            mts={t.mts}
            camas={t.camas}
            salaComedor={t.salaComedor}
            baos={t.baos}
            imagen={t.imagen}
          />
        </div>
      ))}
    </div>

    <!-- Pagination dots: one per tipología (5 total). White outline by
         default, filled lime on the active slide. Click jumps to the slide
         and resets the auto-advance timer. -->
    <div class="absolute bottom-[36px] left-1/2 -translate-x-1/2 flex gap-[20px] z-20">
      {tipologias.map((_, i) => (
        <button
          type="button"
          data-tipologia-dot={i}
          aria-label={`Ir a la tipología ${i + 1} de ${tipologias.length}`}
          class="w-[20px] h-[20px] rounded-full border-2 border-white bg-transparent transition-colors data-[active=true]:bg-vecta-lime data-[active=true]:border-vecta-lime cursor-pointer"
        ></button>
      ))}
    </div>
  </div>

</section>

<script>
  // Auto-advancing carousel for the mobile tipología pages. Disabled on
  // desktop (where the static building image is shown instead). Pauses
  // briefly on user interaction and stops when scrolled out of view.
  const isMobile = document.documentElement.getAttribute('data-device') === 'phone';
  if (isMobile) {
    const carousel = document.querySelector<HTMLElement>('[data-tipologia-carousel-mobile]');
    const track = document.querySelector<HTMLElement>('[data-tipologia-track]');
    const dots = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-tipologia-dot]'),
    );
    if (carousel && track && dots.length > 0) {
      const SLIDE_W = 1280;
      const SLIDE_MS = 5000;
      const RESUME_DELAY = 4000;
      const total = dots.length;
      let idx = 0;
      let timer: ReturnType<typeof setInterval> | null = null;
      let resume: ReturnType<typeof setTimeout> | null = null;
      let visible = true;

      function paint() {
        track!.style.transform = `translateX(-${idx * SLIDE_W}px)`;
        dots.forEach((d, i) => d.setAttribute('data-active', String(i === idx)));
      }
      function goto(n: number) {
        idx = ((n % total) + total) % total;
        paint();
      }
      function start() {
        stop();
        if (!visible) return;
        timer = setInterval(() => goto(idx + 1), SLIDE_MS);
      }
      function stop() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }
      function pauseAndResume() {
        stop();
        if (resume) clearTimeout(resume);
        resume = setTimeout(start, RESUME_DELAY);
      }

      dots.forEach((d, i) =>
        d.addEventListener('click', () => {
          goto(i);
          pauseAndResume();
        }),
      );

      // Swipe navigation: track the touch start, compute the delta on
      // touchend, and advance/retreat one slide if the gesture is
      // predominantly horizontal and crosses the threshold.
      const SWIPE_THRESHOLD = 60;
      let touchStartX = 0;
      let touchStartY = 0;
      carousel.addEventListener(
        'touchstart',
        (e) => {
          pauseAndResume();
          const t = e.touches[0];
          if (!t) return;
          touchStartX = t.clientX;
          touchStartY = t.clientY;
        },
        { passive: true },
      );
      carousel.addEventListener(
        'touchend',
        (e) => {
          const t = e.changedTouches[0];
          if (!t) return;
          const dx = t.clientX - touchStartX;
          const dy = t.clientY - touchStartY;
          if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > SWIPE_THRESHOLD) {
            goto(idx + (dx < 0 ? 1 : -1));
          }
        },
        { passive: true },
      );

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              visible = e.isIntersecting;
              if (visible) start();
              else stop();
            });
          },
          { threshold: 0.2 },
        );
        io.observe(carousel);
      } else {
        start();
      }

      paint();
    }
  }
</script>

<!-- All-tipologías data island for the modal: when a polygon is clicked, the
     modal script looks up the full record (descripcion, camas, salaComedor,
     baños, imagen) by tipo number and applies it to the modal selectors. -->
<script type="application/json" data-tipologias-data set:html={JSON.stringify(tipologias)}></script>

<TipologiaModal />
