    <div data-tipologia-polygon data-tipo={t4.tipo} data-mts={t4.mts} role="button" tabindex="0" aria-label={`Ver detalle de Tipología ${t4.tipo} (${t4.areaTotal})`} class="cursor-pointer focus:outline-none focus:ring-2 focus:ring-white/60 mobile:hidden absolute left-[1130px] top-[1170px] w-[238px] h-[169px]">
      <div class="absolute top-[-149.72%] right-[-6.08%] bottom-[-149.69%] left-[-106.10%]">
        <img src="/sections/tipologias/vector-37.svg" alt="" class="block max-w-none w-full h-full" loading="lazy" decoding="async" />
      </div>
    </div>

    <!-- Vector 38 — Tipología 3 (Figma 2051:33) -->
    <div data-tipologia-polygon data-tipo={t3.tipo} data-mts={t3.mts} role="button" tabindex="0" aria-label={`Ver detalle de Tipología ${t3.tipo} (${t3.areaTotal})`} class="cursor-pointer focus:outline-none focus:ring-2 focus:ring-white/60 mobile:hidden absolute left-[207px] top-[1096px] w-[359px] h-[305px]">
      <div class="absolute top-[-82.92%] right-[-70.47%] bottom-[-82.98%] left-[-27.58%]">
        <img src="/sections/tipologias/vector-38.svg" alt="" class="block max-w-none w-full h-full" loading="lazy" decoding="async" />
      </div>
