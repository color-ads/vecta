---
// Tipologias - building image with 5 typology callouts and big "Tipologias" title.
// Each of the 5 building polygon outlines is clickable; clicking opens the
// TipologiaModal which holds the render + floor plan detail views.
//
// Background photo comes from Contentful `webSite.bloque7imagen`.
//
// Mobile: the building image + callouts make no sense at narrow widths, so
// we replace them with the actual tipología detail "pages" (render view +
// floor-plan view) for each of the 5 tipologías, stacked vertically. The
// scoped `data-tipologia-*` selectors inside TipologiaModal stay confined
// to the modal, so these inline renders coexist without conflicts.
import TipologiaModal from '../components/TipologiaModal.astro';
import TipologiaAbierta2 from '../components/TipologiaAbierta2.astro';
import { getContentfulClient, getWebsite } from '../lib/contentful';
import { assetUrl, richTextToPlain } from '../lib/richtext';

const ws = await getWebsite();
const bgSrc = assetUrl(ws?.fields?.bloque7imagen);

// All 5 tipologías come from the `tipologia` content type, ordered by
// `numero` (1..5). Each entry carries: numero, areaTotal, camas,
// salaComedor, baños, descripcion and imagen (floor plan).
const client = getContentfulClient();
const tipoRes = await client.getEntries({
  content_type: 'tipologia',
  order: ['fields.numero'],
});

const tipologias = tipoRes.items.map((it: any) => {
  const f = it.fields;
  const areaTotal = richTextToPlain(f.areaTotal).trim();
  // Strip the unit so callouts can render the numeric value alongside
  // their own "mts²" label.
  const mts = areaTotal.replace(/\s*mts²?\s*$/i, '').trim();
  return {
    tipo: String(f.numero ?? ''),
    mts,
    areaTotal,
    camas: richTextToPlain(f.camas).trim(),
    salaComedor: richTextToPlain(f.salaComedor).trim(),
    baos: richTextToPlain(f.baos).trim(),
    descripcion: richTextToPlain(f.descripcion).trim(),
    imagen: assetUrl(f.imagen, '/sections/tipologia-abierta/floor-plan.webp'),
  };
});

// Lookup by number so the absolutely-positioned callouts/polygons (which
// have fixed positions tied to specific tipo numbers in the building
// render) can pull their per-tipo copy.
const byTipo = Object.fromEntries(tipologias.map((t) => [t.tipo, t])) as Record<string, typeof tipologias[number]>;
const t1 = byTipo['1'] ?? tipologias[0];
const t2 = byTipo['2'] ?? tipologias[1];
const t3 = byTipo['3'] ?? tipologias[2];
const t4 = byTipo['4'] ?? tipologias[3];
const t5 = byTipo['5'] ?? tipologias[4];
---
<section id="tipologias" class="relative w-full min-w-[1280px] h-[2085px] overflow-hidden bg-black mobile:h-auto">
  <!-- Inner 1280px canvas keeps Figma absolute positions intact (desktop only).
       La imagen del edificio + overlay viven DENTRO de este canvas (no full-bleed
       a `w-full`) para que la imagen siempre comparta sistema de coordenadas con
       los 5 polígonos clickables. A >1280px la sección crece (fondo negro a los
       lados), pero la imagen y los polígonos quedan anclados al mismo canvas
       centrado de 1280px y nunca se desalinean. -->
  <div class="relative w-[1280px] h-full mx-auto mobile:hidden">
    <img
      src={bgSrc}
      alt="Edificio VECTA 98 con tipologías"
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-black/30"></div>
    <!-- Big title -->
    <h2 class="absolute right-[120px] top-[101px] text-white font-medium text-[128px] leading-[0.959] font-display">
      Tipologias
    </h2>

    <!-- Logo — same SVG asset as Hero (`/sections/hero/vecta-logo.svg`),
         sized to the Tipologias canvas position (448×103). -->
    <div class="absolute left-[732px] top-[290px] w-[448px] h-[103px]">
      <img src="/sections/hero/vecta-logo.svg" alt="VECTA 98" class="w-full h-full object-contain" loading="lazy" decoding="async" />
    </div>
    <div class="absolute left-[663px] top-[257px] w-[495px] h-px bg-white"></div>

    <!-- Vector 35 — Tipología 1 (Figma 2047:30) -->
    <div data-tipologia-polygon data-tipo={t1.tipo} data-mts={t1.mts} role="button" tabindex="0" aria-label={`Ver detalle de Tipología ${t1.tipo} (${t1.areaTotal})`} class="cursor-pointer focus:outline-none focus:ring-2 focus:ring-white/60 absolute left-[157px] top-[575px] w-[217px] h-[330px] mobile:hidden">
      <div class="absolute top-[-76.92%] right-[-116.59%] bottom-[-77.02%] left-[-24.42%]">
        <img src="/sections/tipologias/vector-35.svg" alt="" class="block max-w-none w-full h-full" loading="lazy" decoding="async" />
      </div>
    </div>

    <!-- Vector 36 — Tipología 2 (Figma 2050:31) -->
    <div data-tipologia-polygon data-tipo={t2.tipo} data-mts={t2.mts} role="button" tabindex="0" aria-label={`Ver detalle de Tipología ${t2.tipo} (${t2.areaTotal})`} class="cursor-pointer focus:outline-none focus:ring-2 focus:ring-white/60 mobile:hidden absolute left-[753px] top-[788px] w-[332px] h-[350px]">
      <div class="absolute top-[-72.42%] right-[-76.17%] bottom-[-72.27%] left-[-76.06%]">
        <img src="/sections/tipologias/vector-36.svg" alt="" class="block max-w-none w-full h-full" loading="lazy" decoding="async" />
      </div>
    </div>

