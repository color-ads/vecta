---
// About Us 1 - Four numbered cards on yellow background
import Header from "../components/Header.astro";
const cards = [
  { number: "1.", title: "Claridad", description: "Aquí todo se explica. Sin discursos inflados ni promesas ambiguas." },
  { number: "2.", title: "Arquitectura funcional", description: "Cada espacio tiene un propósito real de uso." },
  { number: "3.", title: "Ciudad activa", description: "Ubicación con dinámica real, no aspiracional." },
  { number: "4.", title: "Coherencia a largo plazo", description: "Una lógica estructurada diseñado para sostener valor en el tiempo." }
];
---
<section class="relative w-[1280px] h-[832px] mx-auto bg-vecta-lime overflow-hidden">
  <Header active="ABOUT US" variant="dark" />

  <!-- 4 cards -->
  <div class="absolute left-[84px] top-[237px] flex gap-[10px]">
    {cards.map((c) => (
      <article class="relative w-[271px] h-[436px] rounded-[10px] bg-[#0a0a0a] text-white">
        <span class="absolute left-[24px] top-[11px] text-[105px] leading-none font-bold text-white" style="font-family: 'Albert Sans', sans-serif;">{c.number}</span>
        <div class="absolute right-[20px] top-[22px] w-[55px] h-[55px] rounded-full border border-white/70 flex items-center justify-center">
          <svg viewBox="0 0 24 24" class="w-[22px] h-[22px]" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M9 9c0-1.1-.9-2-2-2s-2 .9-2 2 .9 2 2 2h10c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2v6c0 1.1-.9 2-2 2s-2-.9-2-2-.9-2-2-2H7c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2V9z" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="absolute left-[24px] top-[238px] w-[217px] text-[36px] font-semibold leading-[0.95]" style="font-family: 'Albert Sans', sans-serif;">{c.title}</h3>
        <span class="absolute left-[24px] top-[322px] w-[126px] h-px bg-white"></span>
        <p class="absolute left-[24px] top-[343px] w-[218px] text-[18px] leading-[1.3] font-bold" style="font-family: 'Albert Sans', sans-serif;">{c.description}</p>
      </article>
    ))}
  </div>
</section>
