---
// Espacios — dark image carousel of 5 spaces.
// Content (titles, subtitles, background images, and order) all come from
// the Contentful `lugares` content type. Slides are rendered in the order
// Contentful returns them (sys.createdAt asc).
import { getContentfulClient } from '../lib/contentful';

interface LugarFields {
  titulo: string;
  descripcion?: { content?: Array<{ content?: Array<{ value?: string }> }> };
  imagen?: { fields: { file: { url: string } } };
}

const client = getContentfulClient();
const res = await client.getEntries({
  content_type: 'lugares',
  order: ['sys.createdAt'],
});

function richTextToPlain(doc: LugarFields['descripcion']): string {
  if (!doc?.content) return '';
  return doc.content
    .map((node) => (node.content ?? []).map((n) => n.value ?? '').join(''))
    .join(' ')
    .trim();
}

const slides = (res.items as Array<{ fields: LugarFields }>).map((it) => {
  const titulo = String(it.fields.titulo).trim();
  const url = it.fields.imagen?.fields.file.url;
  return {
    id: titulo.toLowerCase().replace(/\s+/g, '-'),
    title: titulo.toUpperCase(),
    subtitle: richTextToPlain(it.fields.descripcion),
    bg: url ? `https:${url}` : '',
  };
});
---
<section id="espacios" class="relative w-full min-h-screen overflow-hidden bg-black flex items-center justify-center">
  <!-- Stack all background photos full-bleed; only the active one is visible
       (controlled by the script below via inline opacity). -->
  {slides.map((slide, i) => (
    <img
      src={slide.bg}
      alt={`Espacio ${slide.title}`}
      class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500"
      data-espacios-slide={slide.id}
      loading="lazy"
      decoding="async"
      style={`opacity: ${i === 0 ? 1 : 0};`}
    />
  ))}
  <!-- Warm dark overlay matching Figma rgba(56,48,28,0.44) -->
  <div class="absolute inset-0 bg-[rgba(56,48,28,0.44)]"></div>

  <!-- Slide data for the client script: avoids putting human-readable copy
       on a data-* attribute that competes with the existing selectors. -->
  <script type="application/json" data-espacios-data set:html={JSON.stringify(slides.map((s) => ({ title: s.title, subtitle: s.subtitle })))}></script>

  <!-- Inner canvas: tope 1280px, fluido por debajo. Las figuras
       geométricas y flechas están posicionadas en % para escalar. -->
  <div class="relative w-full max-w-[1280px] h-[832px] mx-auto">
    <!-- Geometric figure from GYM ESPACIOS (Figma 2069:154 "Group 11").
         Three concentric layers centered at (640, 444.5) — 28.5px below the
         canvas center. Hidden on mobile (fixed px positions overflow narrow viewports). -->
    <!-- Rectangle 2 (2069:155) — outer 887.419×887.419 rotated -45° -->
    <div class="absolute pointer-events-none w-[887.419px] h-[887.419px] top-[0.7905px] left-[196.2905px] border border-white/50 rotate-[-45deg] mobile:hidden"></div>
    <!-- Ellipse 1 (2069:157) — circle 620.185×620.185 -->
    <div class="absolute pointer-events-none rounded-full w-[620.185px] h-[620.185px] top-[134.4075px] left-[329.9075px] border border-white/50 mobile:hidden"></div>
    <!-- Rectangle 3 (2069:156) — inner 620.185×620.185 axis-aligned -->
    <div class="absolute pointer-events-none w-[620.185px] h-[620.185px] top-[134.4075px] left-[329.9075px] border border-white/50 mobile:hidden"></div>

    <!-- Title + subtitle stack (both swapped per slide by the script). -->
    <div class="absolute left-1/2 top-[399px] -translate-x-1/2 text-center text-white whitespace-nowrap font-display
                mobile:top-[42vh] mobile:w-[calc(100vw-32px)]">
      <h2 data-espacios-title class="text-[clamp(28px,5vw,64px)] font-medium leading-[0.959] mobile:text-[24px] mobile:whitespace-normal">{slides[0]?.title ?? ''}</h2>
      <p data-espacios-subtitle class="text-[clamp(18px,2.5vw,32px)] font-normal leading-[0.959] mobile:text-[15px] mobile:whitespace-normal">{slides[0]?.subtitle ?? ''}</p>
    </div>

    <!-- Arrow buttons (Figma 2021:201, 2021:203). The SVG includes the circle
         outline + chevron — no extra border or background on the <button>.
         Prev mirrors the same SVG via scaleX(-1). -->
    <button data-espacios-prev
            class="absolute left-[clamp(20px,12%,153px)] top-[378px] w-[76px] h-[76px] cursor-pointer hover:opacity-70 transition-opacity mobile:hidden"
            aria-label="Anterior">
      <svg xmlns="http://www.w3.org/2000/svg" width="76" height="76" viewBox="0 0 76 76" fill="none" style="transform: scaleX(-1);">
        <path d="M41.1667 47.5L50.6667 38M50.6667 38L41.1667 28.5M50.6667 38H25.3333M66.5 38C66.5 22.2599 53.7401 9.5 38 9.5C22.2599 9.5 9.5 22.2599 9.5 38C9.5 53.7401 22.2599 66.5 38 66.5C53.7401 66.5 66.5 53.7401 66.5 38Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button data-espacios-next
            class="absolute right-[clamp(20px,12%,156px)] top-[378px] w-[76px] h-[76px] cursor-pointer hover:opacity-70 transition-opacity mobile:hidden"
            aria-label="Siguiente">
      <svg xmlns="http://www.w3.org/2000/svg" width="76" height="76" viewBox="0 0 76 76" fill="none">
        <path d="M41.1667 47.5L50.6667 38M50.6667 38L41.1667 28.5M50.6667 38H25.3333M66.5 38C66.5 22.2599 53.7401 9.5 38 9.5C22.2599 9.5 9.5 22.2599 9.5 38C9.5 53.7401 22.2599 66.5 38 66.5C53.7401 66.5 66.5 53.7401 66.5 38Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</section>

<script>
  // Read the slide list (titles + subtitles) injected by the Astro template
  // from Contentful at build time.
  const dataEl = document.querySelector<HTMLScriptElement>('[data-espacios-data]');
  const slides: Array<{ title: string; subtitle: string }> = dataEl?.textContent
    ? JSON.parse(dataEl.textContent)
    : [];

  let active = 0;

  const titleEl = document.querySelector<HTMLElement>('[data-espacios-title]');
  const subtitleEl = document.querySelector<HTMLElement>('[data-espacios-subtitle]');
  const slideImgs = document.querySelectorAll<HTMLImageElement>('[data-espacios-slide]');
  const prev = document.querySelector('[data-espacios-prev]');
  const next = document.querySelector('[data-espacios-next]');

  // Auto-rotation: advance every AUTO_MS. Manual click pauses; after RESUME_MS
  // of no interaction the auto-rotation kicks back in from the current slide.
  const AUTO_MS = 5000;
  const RESUME_MS = 10000;
  let autoTimer: number | null = null;
  let resumeTimer: number | null = null;

  function show(i: number) {
    if (slides.length === 0) return;
    active = (i + slides.length) % slides.length;
    if (titleEl) titleEl.textContent = slides[active].title;
    if (subtitleEl) subtitleEl.textContent = slides[active].subtitle;
    slideImgs.forEach((img, idx) => {
      img.style.opacity = idx === active ? '1' : '0';
    });
  }

  function startAuto() {
    stopAuto();
    if (slides.length <= 1) return;
    autoTimer = window.setInterval(() => show(active + 1), AUTO_MS);
  }

  function stopAuto() {
    if (autoTimer !== null) { clearInterval(autoTimer); autoTimer = null; }
    if (resumeTimer !== null) { clearTimeout(resumeTimer); resumeTimer = null; }
  }

  function pauseThenResume() {
    stopAuto();
    resumeTimer = window.setTimeout(startAuto, RESUME_MS);
  }

  prev?.addEventListener('click', () => { show(active - 1); pauseThenResume(); });
  next?.addEventListener('click', () => { show(active + 1); pauseThenResume(); });

  startAuto();
</script>
