---
// Proyecto Intro — apartment render with location/area/price overlay.
// Background image comes from Contentful `webSite.bloque2background`.
//
// `webSite.bloque2texto` is stored as a single concatenated string
// (e.g. "Bogotá, Colombia Aptos desde 40 mts² Desde $790 millones"),
// so we parse it here using the "Aptos desde" / "Desde" literals as
// anchors to recover the four visual tiers (ubicación / área / precio /
// unidad). If the field is missing or the format changes, we fall back to
// the original copy so the section never renders broken. The cleaner
// long-term fix is to split this into separate Contentful fields.
import { getWebsite } from '../lib/contentful';
import { assetUrl, richTextToPlain } from '../lib/richtext';

const ws = await getWebsite();
const bgSrc = assetUrl(ws?.fields?.bloque2background);

const bloque2 = richTextToPlain(ws?.fields?.bloque2texto);

function parseBloque2(text: string): { ubicacion: string; area: string } | null {
  if (!text) return null;
  const m = text.match(/^(.+?)\s+Aptos\s+desde\s+(.+?)\s*$/i);
  if (!m) return null;
  return { ubicacion: m[1].trim(), area: m[2].trim() };
}

const parsed = parseBloque2(bloque2);
const ubicacion = parsed?.ubicacion ?? 'Bogotá, Colombia';
const area = parsed?.area ?? '40 mts²';
---
<section id="inversion" class="relative w-full min-h-screen overflow-hidden">
  <!-- Apartment render bleeds full-width across the viewport -->
  <img
    src={bgSrc}
    alt="Render apartamento VECTA 98"
    class="absolute inset-0 w-full h-full object-cover"
    loading="lazy"
    decoding="async"
  />

  <!-- Inner canvas: tope 1280px, fluido por debajo. El overlay text-right se
       ancla al borde derecho del canvas con padding-right en clamp() para
       que respire en cualquier viewport. h-screen para que los % de los
       hijos absolutos resuelvan contra 100vh (h-full no funciona porque la
       sección solo tiene min-h, no height). -->
  <div class="relative w-full max-w-[1280px] h-screen mx-auto px-[clamp(20px,4vw,58px)]">
    <!-- Right-side info card text (Group 11 en Figma). Envuelto en una
         card lime con fade a transparente. El gradient mantiene sólido el
         área del texto (75% superior) y solo desvanece la base. z-10 para
         asegurar que el card siempre quede encima del render de fondo. -->
    <div class="absolute right-[clamp(20px,4vw,58px)] top-[37.76%] w-[clamp(260px,30vw,300px)] z-10 bg-gradient-to-b from-vecta-lime from-75% to-[#eafc9d66] rounded-[10px] px-[clamp(20px,2.5vw,32px)] py-[clamp(24px,3vw,40px)] text-vecta-dark text-right font-display shadow-[0_20px_60px_rgba(0,0,0,0.25)]
                max-sm:top-[12.76%] max-sm:right-auto max-sm:left-1/2 max-sm:-translate-x-1/2 max-sm:w-[clamp(280px,80vw,500px)] max-sm:px-[24px] max-sm:py-[28px] max-sm:text-center">
      <p class="text-[clamp(22px,2.6vw,32px)] leading-[0.959] max-sm:text-[clamp(24px,4vw,48px)]">{ubicacion}</p>

      <p class="mt-[50px] text-[clamp(22px,2.6vw,32px)] leading-[0.959] max-sm:text-[clamp(24px,4vw,48px)]">Aptos desde</p>
      <p class="mt-[12px] text-[clamp(44px,5vw,64px)] font-medium leading-[0.959] max-sm:text-[clamp(40px,7vw,88px)]">{area}</p>
    </div>
  </div>
</section>
