---
// Página de gracias — confirmación post-submit del formulario de contacto.
// Sigue las mismas convenciones de marca que el resto del sitio:
//   - Canvas 1280px con posicionamiento absoluto (estilo Figma)
//   - Override `max-md:` para móvil/tablet (≤768)
//   - Paleta: vecta-night + vecta-lime, tipografía Albert Sans
//   - Header global con el mismo wrapper #site-nav que en index.astro
//
// Se renderiza al navegar a /gracias después de que el POST a la API de
// HubSpot devuelve 200 (ver Formulario.astro).
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="VECTA 98 — Gracias">
  <header id="site-nav" data-nav-theme="light"
          class="fixed top-0 left-0 right-0 z-[120] h-[130px] pointer-events-none">
    <Header variant="light" />
  </header>

  <main class="bg-vecta-night text-white">
    <section class="relative w-full min-h-screen overflow-hidden flex items-center justify-center
                    max-md:block max-md:min-h-[1400px]">
      <div class="relative w-full max-w-[1280px] h-[832px] mx-auto max-md:h-[1400px]">

        <!-- Sutil halo lime detrás del logo. Canvas PC 1280×832, mobile 1280×1400. -->
        <div aria-hidden="true"
             class="absolute left-1/2 top-[31.25%] -translate-x-1/2 w-[40.63%] h-[62.5%] rounded-full bg-vecta-lime/15 blur-[120px] pointer-events-none
                    max-md:top-[28.57%] max-md:w-[59.38%] max-md:h-[54.29%]"></div>

        <!-- VECTA wordmark, centrado. -->
        <div class="absolute left-1/2 -translate-x-1/2 top-[28.85%] w-[32.81%] h-[11.54%]
                    max-md:top-[25.71%] max-md:w-[50%] max-md:h-[10.5%]">
          <img src="/sections/hero/vecta-logo.svg" alt="VECTA 98"
               class="w-full h-full object-contain" decoding="async" />
        </div>

        <!-- ¡Gracias! titular -->
        <h1 class="absolute left-0 right-0 top-[43.27%] text-center text-vecta-lime font-semibold font-display text-[clamp(26px,4.2vw,52px)] leading-[1] tracking-[-0.01em]
                   max-md:top-[40%] max-md:text-[clamp(44px,7.5vw,96px)]">
          ¡Gracias!
        </h1>

        <!-- Línea divisoria lime -->
        <div class="absolute left-1/2 -translate-x-1/2 top-[52.88%] w-[7.81%] h-px bg-vecta-lime
                    max-md:top-[50%] max-md:w-[14.06%]"></div>

        <!-- Subtítulo -->
        <p class="absolute left-1/2 -translate-x-1/2 top-[56.49%] w-[min(53.13%,calc(100vw-40px))] text-center text-white/85 font-display text-[clamp(14px,1.6vw,20px)] leading-[1.35]
                  max-md:top-[52.86%] max-md:w-[min(78.13%,calc(100vw-40px))] max-md:text-[clamp(22px,4.5vw,34px)]">
          Recibimos tu información correctamente.
        </p>

        <!-- Botón Volver al inicio -->
        <a href="/"
           class="absolute left-1/2 -translate-x-1/2 top-[69.71%] w-[20.31%] h-[6.73%] rounded-[10px] bg-vecta-lime text-vecta-dark text-[clamp(14px,1.6vw,20px)] font-semibold flex items-center justify-center hover:bg-vecta-lime/90 transition-colors font-display
                  max-md:top-[67.14%] max-md:w-[min(31.25%,calc(100vw-40px))] max-md:h-[6.79%] max-md:text-[clamp(22px,4.5vw,34px)]">
          VOLVER AL INICIO
        </a>
      </div>
    </section>
  </main>
</Layout>
