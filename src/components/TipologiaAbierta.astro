---
// TipologiaAbierta — Figma frame 2053:115 (1280x832)
// Bedroom photo background with a dark overlay, plus an inset rectangle made of
// 2 horizontal rules + 2 vertical rules + 4 corner dots that frame "Tipo 3 / 35 mts²"
// and a lime description on the right.
//
// Coordinates are taken directly from Figma:
//   bg overlay     : rgba(56,48,28,0.44) over the photo
//   top rule       : x=110,  y=244,   w=917, h=2
//   bottom rule    : x=620,  y=665,   w=609.5, h=2 (right side only)
//   vertical L     : x=140,  y=197.5, h=353.5
//   vertical R     : x=567,  y=197.5, h=353.5
//   dots (4)       : x=134/561, y=238/465, 12x12
//   "Tipo 3"       : x=170,  y=279,   115px white
//   "35 mts²"      : x=373,  y=404,   40px white
//   small arrow    : x=165.5, y=422.5, w=180 (decorative)
//   description    : x=607,  y=294,   457w, 32px lime
//
// The site-wide fixed nav (rendered in src/pages/index.astro) sits on top of
// this component when the modal opens, so no Header is rendered inside.
//
// Props:
//   tipo  — the typology number shown in "Tipo {N}" (default: "3")
//   mts   — the area in m² shown beneath (default: "35")
//
// The TipologiaModal can also override these at runtime via
// [data-tipologia-title] and [data-tipologia-mts] selectors when the user
// clicks a polygon — used on desktop where the same component is rendered once
// and reused for all 5 typologies.
interface Props {
  tipo?: string;
  mts?: string;
}
const { tipo = "3", mts = "35" } = Astro.props;
---
<section class="relative w-full min-w-[1280px] min-h-screen h-[832px] overflow-hidden bg-black">
  <!-- Bedroom photo + dark overlay -->
  <img
    src="/sections/tipologia-abierta/bedroom-bg.webp"
    alt="Habitación VECTA 98 — Tipo 3"
    class="absolute inset-0 w-full h-full object-cover"
    loading="lazy"
    decoding="async"
  />
  <div class="absolute inset-0" style="background-color: rgba(56,48,28,0.44);"></div>

  <!-- Inner 1280px canvas -->
  <div class="relative w-[1280px] min-h-screen h-[832px] mx-auto">
    <!-- Top horizontal rule of the frame (with rounded ends from the image asset) -->
    <div class="absolute left-[110px] top-[244px] w-[917px] h-px bg-white"></div>

    <!-- Vertical rules -->
    <div class="absolute left-[140px] top-[198px] w-px h-[354px] bg-white"></div>
    <div class="absolute left-[567px] top-[198px] w-px h-[354px] bg-white"></div>

    <!-- Corner dots (4) -->
    <div class="absolute left-[134px] top-[238px] w-[12px] h-[12px] rounded-full bg-white"></div>
    <div class="absolute left-[561px] top-[238px] w-[12px] h-[12px] rounded-full bg-white"></div>
    <div class="absolute left-[134px] top-[465px] w-[12px] h-[12px] rounded-full bg-white"></div>
    <div class="absolute left-[561px] top-[465px] w-[12px] h-[12px] rounded-full bg-white"></div>

    <!-- "Tipo N" big title (text is set by TipologiaModal at open time) -->
    <h2
      data-tipologia-title
      class="absolute left-[170px] top-[279px] w-[393px] text-white font-semibold text-[115px] leading-[0.959] font-display [text-shadow:0px_5px_10px_rgba(0,0,0,0.1),0px_19px_19px_rgba(0,0,0,0.09),0px_42px_25px_rgba(0,0,0,0.05)]">
      Tipo {tipo}
    </h2>

    <!-- "X mts²" with leading arrow (text is set by TipologiaModal at open time) -->
    <p
      data-tipologia-mts
      class="absolute left-[373px] top-[404px] w-[167px] text-white font-medium text-[40px] leading-[0.959] font-display">
      {mts} mts²
    </p>
    <!-- Small horizontal arrow line that points at "35 mts²" (Figma Vector 73). -->
    <svg
      class="absolute left-[166px] top-[417px]"
      width="180" height="12" viewBox="0 0 180 12" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 6 H170 M163 0 L170 6 L163 12" stroke="white" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

    <!-- Description (lime) -->
    <p
      class="absolute left-[607px] top-[294px] w-[457px] text-vecta-lime-text font-medium text-[32px] leading-[0.959] font-display">
      Espacio compacto y funcional que integra sala, cocina, habitación y zona de lavado en una distribución eficiente.
    </p>

    <!-- Bottom-right horizontal rule that closes the lower band -->
    <div class="absolute left-[620px] top-[665px] w-[610px] h-px bg-white"></div>
  </div>
</section>
