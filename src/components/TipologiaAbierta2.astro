---
// TipologiaAbierta2 — Figma frame 2054:172 (1280x832)
// Light gray background. Floor plan image on the right; on the left, the big
// "Tipo 3" title and a 4-row specs table.
//
// Coordinates from Figma:
//   bg color       : #f0f0f0
//   floor plan img : x=544, y=94, w=686, h=702
//   "Tipo 3"       : x=92,  y=272, 100px vecta-dark
//   row 1: ÁREA TOTAL  | 35 mts²  — top:416
//   row 2: CAMAS       | 2        — top:480
//   row 3: SALA COMEDOR| 1        — top:544
//   row 4: BAÑOS       | 2        — top:608
//   separator rules between rows at top: 461.5, 525.5, 589.5 — x=88, w=390
//
// The site-wide fixed nav (rendered in src/pages/index.astro) sits on top of
// this component when the modal opens, so no Header is rendered inside.
//
// Props:
//   tipo         — the typology number (default "3")
//   mts          — the area shown in the ÁREA TOTAL row (default "35")
//   camas        — value for the CAMAS row (default "2")
//   salaComedor  — value for the SALA COMEDOR row (default "1")
//   baos         — value for the BAÑOS row (default "2")
//   imagen       — floor plan image URL (default local fallback)
//
// In the modal, these defaults are overwritten at runtime via the
// [data-tipologia-row="<key>"] and [data-tipologia-image] selectors.
interface Props {
  tipo?: string;
  mts?: string;
  camas?: string;
  salaComedor?: string;
  baos?: string;
  imagen?: string;
}
const {
  tipo = "3",
  mts = "35",
  camas = "2",
  salaComedor = "1",
  baos = "2",
  imagen = "/sections/tipologia-abierta/floor-plan.webp",
} = Astro.props;

const rows = [
  { label: "ÁREA TOTAL",   value: `${mts} mts²`, key: "mts"   },
  { label: "CAMAS",        value: camas,         key: "camas" },
  { label: "SALA COMEDOR", value: salaComedor,   key: "sala"  },
  { label: "BAÑOS",        value: baos,          key: "baos"  },
];
const ROW_TOPS = [416, 480, 544, 608];
const SEP_TOPS = [461, 525, 589];
// Mobile reflow: Tipo N + specs table go on top, floor plan image goes
// underneath. Each row/separator gets a `mobile:!top-[Xpx]` class with
// !important so it overrides the inline desktop `top` style. The literal
// class strings live here so Tailwind picks them up at build time.
// All values are shifted +150px so the cluster sits centered inside the
// 1920px-tall mobile slide.
const ROW_MOBILE_CLASSES = [
  'mobile:!top-[430px]',
  'mobile:!top-[510px]',
  'mobile:!top-[590px]',
  'mobile:!top-[670px]',
];
const SEP_MOBILE_CLASSES = [
  'mobile:!top-[480px]',
  'mobile:!top-[560px]',
  'mobile:!top-[640px]',
];
---
<section class="relative w-full min-w-[1280px] min-h-screen h-[832px] overflow-hidden bg-vecta-bg mobile:h-[2055px] mobile:min-h-0">
  <!-- Inner 1280px canvas -->
  <div class="relative w-[1280px] min-h-screen h-[832px] mx-auto mobile:h-[2055px] mobile:min-h-0">
    <!-- Floor plan image (desktop: right side; mobile: centered in the
         bottom half of the 2055px-tall slide).
         Image is 1035x1035 (was 900, +15%). Horizontally: left=122, w=1035
         places the image center at 640 = canvas/2. Vertically: top=990
         keeps the same gap below the specs table. -->
    <div class="absolute left-[544px] top-[94px] w-[686px] h-[702px] overflow-hidden
                mobile:left-[122px] mobile:top-[990px] mobile:w-[1035px] mobile:h-[1035px]">
      <img
        data-gallery="1"
        data-tipologia-image
        src={imagen}
        alt="Plano de tipología — VECTA 98"
        class="block w-full h-full object-contain cursor-pointer"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- "Tipo N" big title (text is set by TipologiaModal at open time).
         On mobile it moves to the top and centers horizontally. -->
    <h2
      data-tipologia-title
      class="absolute left-[92px] top-[272px] w-[311px] text-vecta-dark font-semibold text-[100px] leading-[0.959] font-display
             mobile:left-1/2 mobile:-translate-x-1/2 mobile:top-[230px] mobile:w-auto mobile:text-[140px] mobile:text-center">
      Tipo {tipo}
    </h2>

    <!-- Specs table (4 rows + 3 separators). The first row's value (ÁREA TOTAL)
         is updated by the modal script — others are static. Istok Web is not
         loaded by the project, so the system sans-serif fallback is used.
         Mobile bumps font sizes and shifts the table inward so it reads as
         a centered block above the floor plan image. -->
    {rows.map((row, idx) => (
      <Fragment>
        <p
          class={`absolute left-[93px] w-[194px] text-vecta-dark text-[24px] leading-[1.008] font-['Istok_Web',sans-serif] mobile:left-[280px] mobile:w-[300px] mobile:text-[36px] ${ROW_MOBILE_CLASSES[idx]}`}
          style={`top: ${ROW_TOPS[idx]}px;`}>
          {row.label}
        </p>
        <p
          data-tipologia-row={row.key}
          {...(row.key === "mts" ? { "data-tipologia-mts": true } : {})}
          class={`absolute left-[345px] w-[133px] text-vecta-dark text-[24px] leading-[1.008] text-center font-bold font-['Istok_Web',sans-serif] mobile:left-[700px] mobile:w-[300px] mobile:text-[36px] ${ROW_MOBILE_CLASSES[idx]}`}
          style={`top: ${ROW_TOPS[idx]}px;`}>
          {row.value}
        </p>
      </Fragment>
    ))}
    {SEP_TOPS.map((y, idx) => (
      <div class={`absolute left-[88px] w-[390px] h-px bg-vecta-dark/60 mobile:left-[280px] mobile:w-[720px] ${SEP_MOBILE_CLASSES[idx]}`} style={`top: ${y}px;`}></div>
    ))}
  </div>
</section>
