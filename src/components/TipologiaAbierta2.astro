---
// TipologiaAbierta2 — Figma frame 2054:172 (1280x832)
// Light gray background. Floor plan image on the right; on the left, the big
// "Tipo 3" title and a 4-row specs table.
//
// Coordinates from Figma:
//   bg color       : #f0f0f0
//   floor plan img : x=544, y=94, w=686, h=702
//   "Tipo 3"       : x=92,  y=272, 100px vecta-dark
//   row 1: ÁREA TOTAL  | 35 mts²  — top:416
//   row 2: CAMAS       | 2        — top:480
//   row 3: SALA COMEDOR| 1        — top:544
//   row 4: BAÑOS       | 2        — top:608
//   separator rules between rows at top: 461.5, 525.5, 589.5 — x=88, w=390
//
// The site-wide fixed nav (rendered in src/pages/index.astro) sits on top of
// this component when the modal opens, so no Header is rendered inside.
//
// Props:
//   tipo         — the typology number (default "3")
//   mts          — the area shown in the ÁREA TOTAL row (default "35")
//   camas        — value for the CAMAS row (default "2")
//   salaComedor  — value for the SALA COMEDOR row (default "1")
//   baos         — value for the BAÑOS row (default "2")
//   imagen       — floor plan image URL (default local fallback)
//
// In the modal, these defaults are overwritten at runtime via the
// [data-tipologia-row="<key>"] and [data-tipologia-image] selectors.
interface Props {
  tipo?: string;
  nombre?: string;
  mts?: string;
  camas?: string;
  salaComedor?: string;
  baos?: string;
  piso?: string;
  imagen?: string;
}
const {
  tipo = "3",
  nombre,
  mts = "35",
  camas = "2",
  salaComedor = "1",
  baos = "2",
  piso = "",
  // Default a .jpg (fallback universal). El servidor Contentful suele
  // entregar .webp directamente cuando el asset original lo es; este
  // default solo se usa si el campo `imagen` del entry está vacío.
  imagen = "/sections/tipologia-abierta/floor-plan.jpg",
} = Astro.props;
// `nombre` viene de Contentful (campo `tipologia.nombre`) con valores como
// "Tipo A1", "Tipo B", etc. Si no se pasó, fallback al formato legacy
// "Tipo {N}" para que el componente siga renderizando algo.
const tituloMostrado = nombre && nombre.trim() ? nombre.trim() : `Tipo ${tipo}`;
// Mismo criterio que TipologiaAbierta: si termina en "2" reducimos el tamaño
// para que "Tipo A2/B2/..." no se desborde del ancho de columna.
const tituloEndsIn2 = /2$/.test(tituloMostrado);

const rows = [
  { label: "ÁREA TOTAL",        value: `${mts} mts²`, key: "mts"   },
  { label: "CAMAS",             value: camas,         key: "camas" },
  { label: "SALA COMEDOR",      value: salaComedor,   key: "sala"  },
  { label: "BAÑOS",             value: baos,          key: "baos"  },
  { label: "PISO DE UBICACIÓN", value: piso,          key: "piso"  },
];
// +64px de espaciado por fila (mismo intervalo que las anteriores) y un
// separador a 45px debajo de la fila BAÑOS para abrir la nueva sección.
const ROW_TOPS = [416, 480, 544, 608, 672];
const SEP_TOPS = [461, 525, 589, 653];
// Mobile reflow: Tipo N + specs table go on top, floor plan image goes
// underneath. Each row/separator gets a `mobile:!top-[Xpx]` class with
// !important so it overrides the inline desktop `top` style. The literal
// class strings live here so Tailwind picks them up at build time.
// All values are shifted +150px so the cluster sits centered inside the
// 1920px-tall mobile slide.
const ROW_MOBILE_CLASSES = [
  'mobile:!top-[240px] tablet:!top-[240px]',
  'mobile:!top-[310px] tablet:!top-[310px]',
  'mobile:!top-[380px] tablet:!top-[380px]',
  'mobile:!top-[450px] tablet:!top-[450px]',
  'mobile:!top-[520px] tablet:!top-[520px]',
];
const SEP_MOBILE_CLASSES = [
  'mobile:!top-[286px] tablet:!top-[286px]',
  'mobile:!top-[356px] tablet:!top-[356px]',
  'mobile:!top-[426px] tablet:!top-[426px]',
  'mobile:!top-[496px] tablet:!top-[496px]',
];
---
<section class="relative w-full min-h-screen h-[832px] overflow-hidden bg-vecta-bg mobile:h-[1050px] mobile:min-h-0 tablet:h-[1312px] tablet:min-h-0">
  <!-- Inner canvas: tope 1280px en desktop, fluido por debajo -->
  <div class="relative w-full max-w-[1280px] min-h-screen h-[832px] mx-auto mobile:h-[1050px] mobile:min-h-0 tablet:h-[1312px] tablet:min-h-0">
    <!-- Floor plan image. Desktop: right side fijo. Mobile: centrado
         horizontalmente con ancho fluido (90% del viewport) y alto auto
         con aspect-square — escala al ancho real del device (antes
         `mobile:w-[1035px]` desbordaba en viewports <1035px). -->
    <div class="absolute left-[544px] top-[94px] w-[686px] h-[702px] overflow-hidden
                mobile:left-[5%] mobile:right-[5%] mobile:top-[580px] mobile:w-auto mobile:h-auto mobile:aspect-square
                tablet:left-[5%] tablet:right-[5%] tablet:top-[580px] tablet:w-auto tablet:h-auto tablet:aspect-square">
      <img
        data-gallery="1"
        data-tipologia-image
        src={imagen}
        alt="Plano de tipología — VECTA 98"
        class="block w-full h-full max-w-full object-contain cursor-pointer"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- "Tipo N" big title (text is set by TipologiaModal at open time).
         On mobile it moves to the top and centers horizontally. -->
    <h2
      data-tipologia-title
      data-tipo-small={tituloEndsIn2 ? '' : undefined}
      class="absolute left-[92px] top-[272px] w-[311px] whitespace-nowrap text-vecta-dark font-semibold text-[clamp(48px,8vw,100px)] data-[tipo-small]:text-[clamp(40px,6.7vw,85px)] leading-[0.959] font-display
             mobile:left-1/2 mobile:-translate-x-1/2 mobile:top-[90px] mobile:w-auto mobile:text-[clamp(56px,11vw,140px)] mobile:data-[tipo-small]:text-[clamp(48px,9vw,115px)] mobile:text-center
             tablet:left-1/2 tablet:-translate-x-1/2 tablet:top-[90px] tablet:w-auto tablet:text-[clamp(56px,11vw,140px)] tablet:data-[tipo-small]:text-[clamp(48px,9vw,115px)] tablet:text-center">
      {tituloMostrado}
    </h2>

    <!-- Specs table (4 rows + 3 separators). The first row's value (ÁREA TOTAL)
         is updated by the modal script — others are static. Istok Web is not
         loaded by the project, so the system sans-serif fallback is used.
         Mobile bumps font sizes and shifts the table inward so it reads as
         a centered block above the floor plan image. -->
    {rows.map((row, idx) => (
      <Fragment>
        {/* Label: izquierda fija desktop; mobile a 5% del viewport con ancho 45% */}
        <p
          class={`absolute left-[93px] w-[194px] text-vecta-dark text-[clamp(15px,1.9vw,24px)] leading-[1.008] font-['Istok_Web',sans-serif] mobile:left-[5%] mobile:w-[45%] mobile:text-[clamp(20px,2.8vw,36px)] tablet:left-[5%] tablet:w-[45%] tablet:text-[clamp(20px,2.8vw,36px)] ${ROW_MOBILE_CLASSES[idx]}`}
          style={`top: ${ROW_TOPS[idx]}px;`}>
          {row.label}
        </p>
        {/* Value: derecha del label desktop; mobile a 50% con ancho 45% (queda contra el borde derecho con 5% de margen) */}
        <p
          data-tipologia-row={row.key}
          {...(row.key === "mts" ? { "data-tipologia-mts": true } : {})}
          class={`absolute left-[345px] w-[133px] text-vecta-dark text-[clamp(15px,1.9vw,24px)] leading-[1.008] text-center font-bold font-['Istok_Web',sans-serif] mobile:left-[50%] mobile:w-[45%] mobile:text-[clamp(20px,2.8vw,36px)] tablet:left-[50%] tablet:w-[45%] tablet:text-[clamp(20px,2.8vw,36px)] ${ROW_MOBILE_CLASSES[idx]}`}
          style={`top: ${ROW_TOPS[idx]}px;`}>
          {row.value}
        </p>
      </Fragment>
    ))}
    {/* Separadores: width fluido desktop (390px) y mobile (90% del viewport con 5% margen lateral) */}
    {SEP_TOPS.map((y, idx) => (
      <div class={`absolute left-[88px] w-[390px] h-px bg-vecta-dark/60 mobile:left-[5%] mobile:right-[5%] mobile:w-auto tablet:left-[5%] tablet:right-[5%] tablet:w-auto ${SEP_MOBILE_CLASSES[idx]}`} style={`top: ${y}px;`}></div>
    ))}
  </div>
</section>
