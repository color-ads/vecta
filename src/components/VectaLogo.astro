---
interface Props {
  className?: string;
  color?: string;
}
const { className = "", color = "#ffffff" } = Astro.props;
---
<svg viewBox="0 0 581 133" xmlns="http://www.w3.org/2000/svg" class={className} aria-label="VECTA 98">
  <text x="0" y="100" fill={color} class="font-display font-bold text-[110px] tracking-[-2px]">VECTA</text>
  <text x="430" y="55" fill={color} class="font-display font-bold text-[50px]">98</text>
  <line x1="0" y1="115" x2="581" y2="115" stroke={color} stroke-width="2" />
  <line x1="0" y1="20" x2="420" y2="20" stroke={color} stroke-width="2" />
</svg>
