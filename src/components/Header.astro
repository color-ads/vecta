---
// Header — replicates Figma "Group 10" (id 2030:52)
// Position in HOME canvas: x=139, y=59, w=1002.5, h=36
// Top line (Vector "Vector"): x=139, y=59, w=1002.5
// Bottom line (Vector 16): x=139, y=95, w=1002.5
// Vertical dividers (Vector 21,22,23,24): y=60, h=34, at x=388, 534, 684, 842 (canvas)
// Frame 18 (nav text): x=318, y=66, w=645, h=21
// Nav items (Frame 18 local x): HOME 0/55, ABOUT US 105/90, ESPACIOS 245/87, TIPOLOGÍAS 382/111, INVERSIÓN 543/102
// Hamburger: x=1196, y=55, 43x43
// Caret Up: x=50, y=36, 36x36
// Caret Down: x=50, y=83, 36x36

interface Props {
  active?: "HOME" | "ABOUT US" | "ESPACIOS" | "TIPOLOGÍAS" | "INVERSIÓN";
  variant?: "light" | "dark";
}
const { active, variant = "light" } = Astro.props;
const stroke = variant === "light" ? "bg-white/70" : "bg-vecta-dark/70";
const inactive = variant === "light" ? "text-white" : "text-vecta-dark";
const burger = variant === "light" ? "bg-white" : "bg-vecta-dark";
// Caret circle buttons (up/down). Both default to white lines in the light
// variant (Hero) until pressed. Pressed state is toggled via JS below.
const caretBorder = variant === "light" ? "border-white text-white" : "border-vecta-dark text-vecta-dark";

// Frame 18 sits at canvas x=318 inside the 1280px hero. Items are absolutely
// positioned within it. Each maps to a section id so the nav scroll-jumps to
// the right block; smooth-scroll + scroll-padding-top live in Layout.astro.
const navItems = [
  { label: "HOME",       x: 0,   w: 55,  href: "#hero" },
  { label: "ABOUT US",   x: 105, w: 90,  href: "#about-carousel" },
  { label: "ESPACIOS",   x: 245, w: 87,  href: "#espacios" },
  { label: "TIPOLOGÍAS", x: 382, w: 111, href: "#tipologias" },
  { label: "INVERSIÓN",  x: 543, w: 102, href: "#inversion" },
] as const;

// Dividers absolute x within the 1280px canvas
const dividers = [388, 534, 684, 842];
---

<!-- Top + bottom horizontal lines -->
<div class={`absolute left-[139px] top-[59px] w-[1003px] h-px ${stroke} z-30`}></div>
<div class={`absolute left-[139px] top-[95px] w-[1003px] h-px ${stroke} z-30`}></div>

<!-- Vertical dividers between nav items (y=60, h=34) -->
{dividers.map((x) => (
  <div class={`absolute top-[60px] w-px h-[34px] ${stroke} z-30`} style={`left:${x}px`}></div>
))}

<!-- Frame 18 nav items (Albert Sans / Afacad Regular 22px). Default = white in
     light variant / vecta-dark in dark variant. Hover and active both use
     vecta-lime (#EAFC9D) — the project's yellow accent. Anchors with native
     hash navigation; smooth scroll handled at the html level. -->
<nav class="absolute left-[318px] top-[66px] w-[645px] h-[21px] z-30" style="font-family: 'Afacad', sans-serif;">
  {navItems.map((item) => (
    <a
      href={item.href}
      class={`absolute top-0 text-[22px] leading-[0.959] whitespace-nowrap cursor-pointer transition-colors ${active === item.label ? "text-vecta-lime" : `${inactive} hover:text-vecta-lime`}`}
      style={`left:${item.x}px;width:${item.w}px;`}
    >
      {item.label}
    </a>
  ))}
</nav>

<!-- Hamburger menu (Menu / Hamburger_MD) at x=1196, y=55, 43x43.
     Mobile-only: hidden on devices with a precise pointer (desktop mouse),
     visible on touch devices. The viewport=1280 meta in Layout.astro freezes
     viewport-width at 1280, so we use (pointer: coarse) instead of width
     breakpoints to differentiate mobile vs desktop. -->
<button
  class="mobile-hamburger absolute left-[1196px] top-[55px] w-[43px] h-[43px] flex-col items-center justify-center gap-[6px] z-30"
  aria-label="Abrir menú"
>
  <span class={`block w-[28px] h-[2px] ${burger}`}></span>
  <span class={`block w-[28px] h-[2px] ${burger}`}></span>
  <span class={`block w-[28px] h-[2px] ${burger}`}></span>
</button>

<style>
  /* Hide hamburger on desktop (mouse pointer); show on touch devices. */
  .mobile-hamburger { display: none; }
  @media (pointer: coarse), (hover: none) {
    .mobile-hamburger { display: flex; }
  }
</style>

<!-- Caret Up + Caret Down circle buttons. Default state (not pressed) uses
     white lines in the light variant; pressing toggles a "is-pressed" class
     handled by the script in Layout.astro / index.astro. -->
<button
  aria-label="Subir"
  data-caret="up"
  class={`caret-btn absolute left-[50px] top-[36px] w-[36px] h-[36px] rounded-full border ${caretBorder} flex items-center justify-center z-30 cursor-pointer transition-colors`}
>
  <svg viewBox="0 0 24 24" class="w-[14px] h-[14px]" fill="none" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
  </svg>
</button>
<button
  aria-label="Bajar"
  data-caret="down"
  class={`caret-btn absolute left-[50px] top-[83px] w-[36px] h-[36px] rounded-full border ${caretBorder} flex items-center justify-center z-30 cursor-pointer transition-colors`}
>
  <svg viewBox="0 0 24 24" class="w-[14px] h-[14px]" fill="none" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
  </svg>
</button>
