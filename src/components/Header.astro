    <svg x="43.1" y="41.4" width="29" height="27" viewBox="0 0 29 27" fill="none">
      <path d="M26.9093 0L27.286 0.145698C27.5711 0.897258 27.7136 1.49659 27.8215 2.28794C28.526 7.40214 29.483 12.3929 26.7159 17.1028C22.3973 24.4564 11.3981 28.9237 3.67298 24.3607C2.60198 23.6032 1.72033 22.6074 1.09727 21.4514C0.0384793 19.4587 -0.348387 16.7212 0.358151 14.5245C2.17438 8.87649 10.83 6.67711 15.7452 4.63812C19.4795 3.08889 23.3318 1.90124 26.9093 0Z" fill="currentColor"/>
    </svg>
  </svg>
  <span class="text-white text-[18px] font-bold leading-none font-display">actualcorp</span>
</div>
