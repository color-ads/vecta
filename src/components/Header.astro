---
// Header — Floating nav. Desktop (≥769px) is a 3-zone layout that adapts
// fluidly from 1024 hasta 1920+; mobile (≤768) usa el hamburger + drawer
// fullscreen sin cambios respecto a la versión Figma original.
//
// Layout desktop:
//   ┌────────────────────────────────────────────────────────────────────┐
//   │ [↑↓]              [── HOME · NOSOTROS · ESPACIOS · … ──]      [AC] │
//   │ pegado al                  strip centrado en viewport          pegado│
//   │ borde izq                  max-w-1003px, fluido                al der│
//   └────────────────────────────────────────────────────────────────────┘
//
// Ancho del strip = min(viewport - 280px, 1003px) → a 1024px se reduce a
// 744px, a 1280px topa en 1000px, a 1920px+ se queda en 1003px y se
// centra. 280px = reserva total para los clusters laterales (carets +
// logo + padding hacia el borde) de modo que jamás se solapan con el strip.
//
// Theming (data-nav-theme): los rules en global.css cambian background-
// color y color sobre selectores .bg-white / .text-white / .border-white,
// más los atributos [data-nav-rule], [data-nav-divider] y
// [data-actualcorp-logo]. Esos selectores se preservan exactamente.

interface Props {
  active?: "HOME" | "NOSOTROS" | "ESPACIOS" | "TIPOLOGÍAS" | "INVERSIÓN";
  variant?: "light" | "dark";
}
const { active, variant = "light" } = Astro.props;
const stroke = variant === "light" ? "bg-white/70" : "bg-vecta-dark/70";
const inactive = variant === "light" ? "text-white" : "text-vecta-dark";
const burger = variant === "light" ? "bg-white" : "bg-vecta-dark";
const caretBorder = variant === "light" ? "border-white text-white" : "border-vecta-dark text-vecta-dark";

// Cada item mapea a un section id. La navegación es por hash; smooth-scroll
// + scroll-padding-top viven en Layout.astro.
const navItems = [
  { label: "HOME",       href: "#hero" },
  { label: "NOSOTROS",   href: "#about-carousel" },
  { label: "ESPACIOS",   href: "#espacios" },
  { label: "TIPOLOGÍAS", href: "#tipologias" },
  { label: "INVERSIÓN",  href: "#inversion" },
] as const;
---

<!-- ============================================================
     DESKTOP NAV (≥769px) — carets a la izquierda, strip centrado,
     logo a la derecha. Hidden en mobile vía global.css.
     ============================================================ -->
<div class="desktop-nav absolute inset-0 pointer-events-none max-sm:hidden">

  <!-- Carets cluster (up/down) — pegado al borde izquierdo del viewport -->
  <div class="absolute top-[27.69%] left-[clamp(20px,3vw,50px)] flex flex-col gap-[11px] z-30 pointer-events-auto">
    <button
      aria-label="Subir"
      data-caret="up"
      type="button"
      class={`caret-btn w-[36px] h-[36px] rounded-full border ${caretBorder} flex items-center justify-center cursor-pointer transition-colors`}
    >
      <svg viewBox="0 0 24 24" class="w-[14px] h-[14px]" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
      </svg>
    </button>
    <button
      aria-label="Bajar"
      data-caret="down"
      type="button"
      class={`caret-btn w-[36px] h-[36px] rounded-full border ${caretBorder} flex items-center justify-center cursor-pointer transition-colors`}
    >
      <svg viewBox="0 0 24 24" class="w-[14px] h-[14px]" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </button>
  </div>

  <!-- actualcorp logo — pegado al borde derecho del viewport. Es un PNG
       blanco estático; en bloques de fondo claro (inversion/ubicacion/
       formulario) global.css le aplica filter:invert. -->
  <!-- Logo: en viewports anchos (≥1280) se acerca al borde derecho del nav
       strip (que está capado a 1003px centrado). El calc() resuelve a 20px
       del borde en viewports chicos (preserva el diseño Figma original) y
       deja ~50px de gap con la strip cuando hay espacio sobrante.
       top-[45.38%] alinea el borde superior del logo con el del strip
       (45.38% = top del strip) — el logo "cuelga" de la línea del strip
       sin sobresalir por encima. -->
  <img
    src="/Logo_Blanco.png"
    alt="actualcorp"
    data-actualcorp-logo
    class="absolute top-[45.38%] right-[max(20px,calc(50vw-671.5px))] w-[clamp(80px,8vw,120px)] aspect-square object-contain z-30 pointer-events-auto"
  />

  <!-- Nav strip — centrado en viewport, ancho fluido tope 1003px.
       Contiene las 2 líneas horizontales + 5 items + 4 dividers verticales. -->
  <div class="absolute top-[45.38%] left-1/2 -translate-x-1/2 w-[min(calc(100vw-280px),1003px)] h-[36px] z-30 pointer-events-auto">
    <!-- Líneas horizontales superior + inferior; abarcan todo el strip. -->
    <div data-nav-rule="top"    class={`absolute inset-x-0 top-0    h-px ${stroke}`}></div>
    <div data-nav-rule="bottom" class={`absolute inset-x-0 bottom-0 h-px ${stroke}`}></div>

    <!-- Items + dividers con flex justify-between. Tipografía fluida con
         clamp() para que a 1024 se reduzca sin romper el layout. -->
    <nav class="relative h-full flex items-center justify-between gap-[clamp(8px,1.2vw,16px)] px-[clamp(20px,3vw,60px)] font-nav">
      {navItems.map((item, idx) => (
        <Fragment>
          {idx > 0 && (
            <span data-nav-divider={idx - 1} class={`shrink-0 w-px h-[34px] ${stroke}`}></span>
          )}
          <a
            href={item.href}
            class={`text-[clamp(14px,1.5vw,22px)] leading-[0.959] whitespace-nowrap cursor-pointer transition-colors ${active === item.label ? "text-vecta-lime" : `${inactive} hover:text-vecta-lime`}`}
          >
            {item.label}
          </a>
        </Fragment>
      ))}
    </nav>
  </div>
</div>

<!-- ============================================================
     MOBILE NAV (≤768) — Hamburger + drawer fullscreen.
     Visibilidad forzada por global.css (@media + data-device).
     ============================================================ -->
<button
  class={`mobile-hamburger absolute left-[20px] top-[23.08%] w-[100px] h-[100px] z-50 hidden max-sm:flex flex-col items-center justify-center gap-[12px] pointer-events-auto`}
  aria-label="Abrir menú"
  aria-expanded="false"
  data-mobile-toggle
>
  <span class={`burger-line block w-[60px] h-[4px] ${burger}`}></span>
  <span class={`burger-line block w-[60px] h-[4px] ${burger}`}></span>
  <span class={`burger-line block w-[60px] h-[4px] ${burger}`}></span>
</button>

<!-- Drawer mobile/tablet. IMPORTANTE: el script de abajo lo teletransporta
     a <body> en runtime. El motivo: el <header> contenedor tiene
     `transform-gpu` (aceleración GPU en iOS), y un ancestro con transform
     crea un nuevo containing block para descendientes `position: fixed`
     → el inset-0 se dimensionaba contra el header (130px), no contra el
     viewport. Por eso el menú aparecía "arriba" y el bg incompleto.
     Una vez en <body>, fixed inset-0 cubre el viewport real y el centrado
     con flex items-center justify-center funciona como debe.
     max-md:data-[open=true]:flex cubre ≤768px (iPad portrait incluido). -->
<div
  class="mobile-menu fixed inset-0 z-40 bg-vecta-night/95 backdrop-blur-sm hidden max-md:data-[open=true]:flex items-center justify-center pointer-events-auto"
  data-mobile-menu
  hidden
>
  <ul class="flex flex-col items-center gap-[28px] font-nav">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class={`text-[clamp(36px,6vw,72px)] leading-[1.2] tracking-[0.02em] whitespace-nowrap text-white hover:text-vecta-lime transition-colors ${active === item.label ? "text-vecta-lime" : ""}`}
          data-mobile-link
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  // Teleport drawer to <body>. El <header> contenedor tiene transform-gpu
  // para acelerar el scroll en iOS, pero eso crea un containing block que
  // confina los `position: fixed` descendientes al área del header (130px),
  // rompiendo el inset-0 del drawer (queda chiquito y "muy arriba"). Sacarlo
  // a body restaura el comportamiento estándar de position:fixed (vs viewport).
  if (menu && menu.parentElement !== document.body) {
    document.body.appendChild(menu);
  }

  const links = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-link]');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) {
      menu.removeAttribute('hidden');
      menu.setAttribute('data-open', 'true');
      document.body.style.overflow = 'hidden';
    } else {
      menu.setAttribute('hidden', '');
      menu.removeAttribute('data-open');
      document.body.style.overflow = '';
    }
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!isOpen);
  });

  // Cierre al tocar un link (deja que el hash scroll se ejecute primero).
  links.forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Cierre con Escape.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
