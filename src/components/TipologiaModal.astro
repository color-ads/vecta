---
// TipologiaModal — Full-screen overlay shown when the user clicks any of the
// polygon outlines in Tipologias.astro. Both detail views are stacked
// vertically: TipologiaAbierta (render + description) on top, TipologiaAbierta2
// (floor plan + specs) below — the user scrolls inside the modal to see the
// second view.
import TipologiaAbierta from './TipologiaAbierta.astro';
import TipologiaAbierta2 from './TipologiaAbierta2.astro';
---
<div
  data-tipologia-modal
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="tipologia-modal-title"
  class="fixed inset-0 z-[100] bg-black/80 overflow-y-auto overscroll-contain">

  <!-- Close button (fixed top right of viewport, sits above the global nav). -->
  <button
    data-tipologia-close
    aria-label="Cerrar"
    type="button"
    class="fixed top-[24px] right-[24px] z-[130] w-[48px] h-[48px] rounded-full bg-white text-vecta-dark flex items-center justify-center text-[28px] leading-none hover:bg-vecta-lime transition-colors cursor-pointer">
    ×
  </button>

  <h2 id="tipologia-modal-title" class="sr-only">Detalle de tipología</h2>

  <!-- Both views stacked vertically — TipologiaAbierta first, then TipologiaAbierta2 -->
  <div class="flex flex-col">
    <div data-tipologia-view-key="render">
      <TipologiaAbierta />
    </div>
    <div data-tipologia-view-key="plano">
      <TipologiaAbierta2 />
    </div>
  </div>
</div>

<!-- Gallery lightbox — opens when any [data-gallery] image is clicked. Sits
     above the modal (z-[140]) and the global nav. Renders outside the modal
     so it also works for mobile-carousel images that aren't inside it. -->
<div
  data-gallery-lightbox
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Visor de galería de tipología"
  class="fixed inset-0 z-[140] bg-black/95 flex items-center justify-center">

  <button
    data-gallery-close
    aria-label="Cerrar visor"
    type="button"
    class="fixed top-[24px] right-[24px] z-[150] w-[48px] h-[48px] rounded-full bg-white text-vecta-dark flex items-center justify-center text-[28px] leading-none hover:bg-vecta-lime transition-colors cursor-pointer">
    ×
  </button>

  <button
    data-gallery-prev
    aria-label="Imagen anterior"
    type="button"
    class="fixed left-[24px] top-1/2 -translate-y-1/2 z-[150] w-[64px] h-[64px] rounded-full bg-white/90 text-vecta-dark flex items-center justify-center text-[40px] leading-none hover:bg-vecta-lime transition-colors cursor-pointer">
    ‹
  </button>
  <button
    data-gallery-next
    aria-label="Imagen siguiente"
    type="button"
    class="fixed right-[24px] top-1/2 -translate-y-1/2 z-[150] w-[64px] h-[64px] rounded-full bg-white/90 text-vecta-dark flex items-center justify-center text-[40px] leading-none hover:bg-vecta-lime transition-colors cursor-pointer">
    ›
  </button>

  <img
    data-gallery-img
    src=""
    alt=""
    class="max-w-[90vw] max-h-[85vh] object-contain select-none"
  />

  <p
    data-gallery-counter
    class="fixed bottom-[24px] left-1/2 -translate-x-1/2 text-white/80 text-[16px] font-display">
    1 / 2
  </p>
</div>

<script>
  const modal = document.querySelector<HTMLElement>('[data-tipologia-modal]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-tipologia-close]');
  const siteNav = document.getElementById('site-nav');
  const planoView = modal?.querySelector<HTMLElement>('[data-tipologia-view-key="plano"]');

  // Same y-coordinate the page-level theme switcher uses in index.astro.
  const NAV_LINE_Y = 65;

  // Theme that was active before the modal opened — restore on close.
  let savedTheme = '';

  function updateModalNavTheme() {
    if (!siteNav || !planoView) return;
    const rect = planoView.getBoundingClientRect();
    // When the floor-plan view's top has crossed the nav line, switch to dark
    // (its bg is light gray). Otherwise stay on light (the render view's bg
    // is dark).
    const onPlano = rect.top <= NAV_LINE_Y;
    siteNav.setAttribute('data-nav-theme', onPlano ? 'dark' : 'light');
  }

  // Full per-tipo dataset (id → fields) injected by Tipologias.astro so the
  // modal can render every field — descripcion, camas, salaComedor, baños,
  // floor-plan image — not just the title and area.
  interface TipoRecord {
    tipo: string;
    nombre: string;
    mts: string;
    areaTotal: string;
    camas: string;
    salaComedor: string;
    baos: string;
    piso: string;
    descripcion: string;
    imagen: string;
  }
  const tipoDataEl = document.querySelector<HTMLScriptElement>('[data-tipologias-data]');
  const tipoList: TipoRecord[] = tipoDataEl?.textContent ? JSON.parse(tipoDataEl.textContent) : [];
  const tipoByNumber = new Map<string, TipoRecord>(tipoList.map((t) => [String(t.tipo), t]));

  function setRow(key: string, value: string) {
    if (!modal) return;
    modal.querySelectorAll<HTMLElement>(`[data-tipologia-row="${key}"]`).forEach((el) => {
      el.textContent = value;
    });
  }

  function setTipo(tipo: string, mts: string) {
    // Scoped to the modal so other in-page TipologiaAbierta instances (e.g.
    // the mobile carousel slides) keep their own static tipo/mts.
    if (!modal) return;
    const record = tipoByNumber.get(String(tipo));
    const areaText = record?.areaTotal || `${mts} mts²`;

    modal.querySelectorAll<HTMLElement>('[data-tipologia-title]').forEach((el) => {
      // Usa el `nombre` del campo Contentful ("Tipo A1", "Tipo B", etc.).
      // Fallback al formato legacy "Tipo {numero}" si no hay nombre.
      const titulo = record?.nombre || `Tipo ${tipo}`;
      el.textContent = titulo;
      // Reduce el tamaño cuando el nombre termina en "2" (Tipo A2, B2…) para
      // que no se desborde del ancho de columna del título.
      if (/2$/.test(titulo.trim())) {
        el.setAttribute('data-tipo-small', '');
      } else {
        el.removeAttribute('data-tipo-small');
      }
    });
    modal.querySelectorAll<HTMLElement>('[data-tipologia-mts]').forEach((el) => {
      el.textContent = areaText;
    });

    if (record) {
      setRow('camas', record.camas);
      setRow('sala', record.salaComedor);
      setRow('baos', record.baos);
      setRow('piso', record.piso);
      modal.querySelectorAll<HTMLElement>('[data-tipologia-descripcion]').forEach((el) => {
        el.textContent = record.descripcion;
      });
      modal.querySelectorAll<HTMLImageElement>('[data-tipologia-image]').forEach((el) => {
        if (record.imagen) el.src = record.imagen;
      });
    }
  }

  function open(tipo: string, mts: string) {
    if (!modal) return;
    if (siteNav) savedTheme = siteNav.getAttribute('data-nav-theme') || 'light';
    setTipo(tipo, mts);
    modal.removeAttribute('hidden');
    modal.scrollTop = 0; // always start at the top (render view)
    document.body.style.overflow = 'hidden';
    modal.addEventListener('scroll', updateModalNavTheme, { passive: true });
    updateModalNavTheme();
    // Push a history entry so the browser back button closes this modal.
    try {
      history.pushState({ tipologiaModal: true }, '');
    } catch {}
  }

  function close({ fromPopstate = false }: { fromPopstate?: boolean } = {}) {
    if (!modal || modal.hasAttribute('hidden')) return;
    modal.setAttribute('hidden', '');
    document.body.style.overflow = '';
    modal.removeEventListener('scroll', updateModalNavTheme);
    // Restore whatever theme the page-level switcher had before opening.
    if (siteNav) siteNav.setAttribute('data-nav-theme', savedTheme || 'light');
    // If we closed manually (button / Escape / backdrop / nav link), drop
    // the history entry we pushed on open so the next back navigates to
    // the page state before the modal — not to a ghost modal-open state.
    if (!fromPopstate && history.state && (history.state as any).tipologiaModal) {
      history.replaceState({}, '');
    }
  }

  // Browser back closes the modal instead of leaving the page.
  window.addEventListener('popstate', () => {
    if (modal && !modal.hasAttribute('hidden')) close({ fromPopstate: true });
  });

  // Click on any polygon trigger opens the modal with that polygon's tipo + mts.
  document.querySelectorAll<HTMLElement>('[data-tipologia-polygon]').forEach((el) => {
    const tipo = el.dataset.tipo || '3';
    const mts = el.dataset.mts || '35';
    const handler = () => open(tipo, mts);
    el.addEventListener('click', handler);
    el.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key === 'Enter' || key === ' ') {
        e.preventDefault();
        handler();
      }
    });
  });

  closeBtn?.addEventListener('click', close);

  // Close on Escape key.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hasAttribute('hidden')) close();
  });

  // Close when clicking the dimmed backdrop (modal element itself).
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });

  // Any in-page nav link (#site-nav links + mobile drawer links) should close
  // the modal so its hash-scroll lands cleanly on the target section.
  document.querySelectorAll<HTMLAnchorElement>(
    '#site-nav a[href^="#"], [data-mobile-menu] a[href^="#"]',
  ).forEach((link) => {
    link.addEventListener('click', () => {
      if (modal && !modal.hasAttribute('hidden')) close();
    });
  });

  // ------------------------------------------------------------------
  // Gallery lightbox — fullscreen viewer for tipología images.
  // Opens when any [data-gallery] image is clicked; arrow buttons /
  // arrow keys navigate between the images; Escape / × / backdrop close.
  // ------------------------------------------------------------------
  const galleryItems = [
    {
      src: '/sections/tipologia-abierta/bedroom-bg.webp',
      alt: 'Habitación VECTA 98',
    },
    {
      src: '/sections/tipologia-abierta/floor-plan.webp',
      alt: 'Plano de tipología VECTA 98',
    },
  ];
  const lightbox = document.querySelector<HTMLElement>('[data-gallery-lightbox]');
  const lightboxImg = lightbox?.querySelector<HTMLImageElement>('[data-gallery-img]');
  const lightboxCounter = lightbox?.querySelector<HTMLElement>('[data-gallery-counter]');
  const galleryCloseBtn = document.querySelector<HTMLButtonElement>('[data-gallery-close]');
  const galleryPrevBtn = document.querySelector<HTMLButtonElement>('[data-gallery-prev]');
  const galleryNextBtn = document.querySelector<HTMLButtonElement>('[data-gallery-next]');
  let galleryIdx = 0;

  function paintGallery() {
    if (!lightboxImg || !lightboxCounter) return;
    const item = galleryItems[galleryIdx];
    lightboxImg.src = item.src;
    lightboxImg.alt = item.alt;
    lightboxCounter.textContent = `${galleryIdx + 1} / ${galleryItems.length}`;
  }

  function openGallery(startIdx: number) {
    if (!lightbox) return;
    const len = galleryItems.length;
    galleryIdx = ((startIdx % len) + len) % len;
    paintGallery();
    lightbox.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeGallery() {
    if (!lightbox || lightbox.hasAttribute('hidden')) return;
    lightbox.setAttribute('hidden', '');
    // Only restore scroll if the underlying tipología modal isn't open.
    if (!modal || modal.hasAttribute('hidden')) {
      document.body.style.overflow = '';
    }
  }

  function stepGallery(direction: 1 | -1) {
    galleryIdx = (galleryIdx + direction + galleryItems.length) % galleryItems.length;
    paintGallery();
  }

  document.querySelectorAll<HTMLImageElement>('[data-gallery]').forEach((img) => {
    img.addEventListener('click', (e) => {
      e.stopPropagation();
      const idx = Number(img.dataset.gallery ?? '0');
      openGallery(Number.isFinite(idx) ? idx : 0);
    });
  });

  galleryCloseBtn?.addEventListener('click', closeGallery);
  galleryPrevBtn?.addEventListener('click', () => stepGallery(-1));
  galleryNextBtn?.addEventListener('click', () => stepGallery(1));

  // Backdrop click closes the lightbox.
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeGallery();
  });

  // Keyboard navigation. Capture phase + stopImmediatePropagation prevents
  // the modal's own Escape handler from also firing while the lightbox is up.
  document.addEventListener(
    'keydown',
    (e) => {
      if (!lightbox || lightbox.hasAttribute('hidden')) return;
      if (e.key === 'Escape') {
        e.stopImmediatePropagation();
        closeGallery();
      } else if (e.key === 'ArrowLeft') {
        stepGallery(-1);
      } else if (e.key === 'ArrowRight') {
        stepGallery(1);
      }
    },
    true,
  );
</script>
