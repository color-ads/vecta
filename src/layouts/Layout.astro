---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'VECTA 98' } = Astro.props;
---

<html lang="es" class="scroll-smooth scroll-pt-[130px]">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Critical preconnects: font CDN + Google Maps (used by Ubicacion). -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="dns-prefetch" href="https://www.google.com" />

		<!-- Hero assets — preload el logo (asset local fijo). El video del
		     hero viene de Contentful (URL dinámica externa) así que no se
		     preloadea desde aquí — el <video preload="auto"> del Hero
		     dispara la carga apenas se descubre. -->
		<link rel="preload" as="image" href="/sections/hero/vecta-logo.svg" />
		<link rel="preload" as="image" href="/hero.jpg" />

		<!-- Fonts loaded via <link> (instead of CSS @import) so they don't
		     block CSS parsing. The print/onload trick lets the stylesheet
		     download async and apply once ready; <noscript> covers no-JS. -->
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Afacad:wght@400&family=Albert+Sans:wght@400;500;600;700&display=swap"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=Afacad:wght@400&family=Albert+Sans:wght@400;500;600;700&display=swap"
			/>
		</noscript>

		<!-- Tag <html> with the real device-width bucket so JS that branches
		     on "isMobile" stays in sync with the device classification used
		     for nav visibility and other data-device CSS rules. Tailwind's
		     native sm:/md:/lg:/xl:/2xl: variants cover responsive layout via
		     @media queries; this attribute is used by JS and by nav visibility
		     selectors in global.css. -->
		<script is:inline>
			(function () {
				function setDevice() {
					if (!document.documentElement) return;
					var w = window.innerWidth;
					var device = 'desktop';
					if (w <= 600) device = 'phone';
					else if (w <= 768) device = 'tablet';
					else if (w <= 1024) device = 'pc-small';
					document.documentElement.setAttribute('data-device', device);
					document.documentElement.setAttribute('data-layout', device);
				}
				setDevice();
				window.addEventListener('resize', setDevice);
				window.addEventListener('orientationchange', setDevice);
			})();
		</script>
	</head>
	<body class="bg-vecta-bg text-vecta-dark antialiased">
		<slot />
	</body>
</html>
